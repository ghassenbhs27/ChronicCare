AI_OPENROUTER_API_KEY=
AI_OPENROUTER_MODEL=openrouter/auto
AI_OPENROUTER_SITE_URL=http://localhost:8000
AI_OPENROUTER_APP_NAME="ChronicCare Risk Copilot"
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-2.0-flash
