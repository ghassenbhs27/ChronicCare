APP_ENV=dev
APP_DEBUG=1
APP_SECRET=CHANGE_ME

DATABASE_URL="mysql://user:password@127.0.0.1:3306/chroniccare?serverVersion=8.0"

# Risk Copilot (external LLM) configuration
AI_PROVIDER=openai
AI_OPENAI_API_KEY=
