{% extends 'back/base.html.twig' %}

{% block page_title %}États de santé (patients){% endblock %}
{% block page_subtitle %}Relevés de suivi des patients uniquement{% endblock %}

{% block body %}
<div class="container-fluid">

  <p class="text-muted small mb-3">
    <strong>État de santé</strong> = relevé enregistré par un patient (poids, glycémie, tension, température…). Seuls les relevés des comptes <strong>patients</strong> sont affichés ici.
  </p>

  {# Stats courtes (4 KPI) #}
  <div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body py-3 d-flex align-items-center gap-2">
          <div class="rounded-2 bg-primary bg-opacity-10 text-primary p-2">
            <i class="bi bi-heart-pulse fs-5"></i>
          </div>
          <div>
            <div class="fw-bold fs-5">{{ globalStats.totalEtats|default(0) }}</div>
            <div class="text-muted small">Total relevés</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body py-3 d-flex align-items-center gap-2">
          <div class="rounded-2 bg-success bg-opacity-10 text-success p-2">
            <i class="bi bi-graph-up fs-5"></i>
          </div>
          <div>
            <div class="fw-bold fs-5">{{ globalStats.moyenneValeur|default(0)|number_format(1) }}</div>
            <div class="text-muted small">Moyenne valeur</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body py-3 d-flex align-items-center gap-2">
          <div class="rounded-2 bg-warning bg-opacity-10 text-warning p-2">
            <i class="bi bi-tags fs-5"></i>
          </div>
          <div>
            <div class="fw-bold fs-5">{{ globalStats.nbTypes|default(0) }}</div>
            <div class="text-muted small">Types de suivi</div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-6 col-md-3">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-body py-3 d-flex align-items-center gap-2">
          <div class="rounded-2 bg-info bg-opacity-10 text-info p-2">
            <i class="bi bi-calendar-week fs-5"></i>
          </div>
          <div>
            <div class="fw-bold fs-5">{{ chartData|default([])|reduce((a,b) => a + b, 0) }}</div>
            <div class="text-muted small">Relevés (7 j)</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# Courbe : relevés par jour (7j) #}
  <div class="row mb-4">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 py-2">
          <h6 class="mb-0">Relevés par jour (7 derniers jours)</h6>
        </div>
        <div class="card-body">
          <canvas id="chartEtatByDay" height="200"></canvas>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm h-100">
        <div class="card-header bg-white border-0 py-2">
          <h6 class="mb-0">Par type</h6>
        </div>
        <div class="card-body">
          {% for row in trendByType %}
            <div class="d-flex justify-content-between align-items-center small mb-2">
              <span>{{ row.type }}</span>
              <span class="badge bg-light text-dark">{{ row.nb }} (moy. {{ row.moyenne|number_format(1) }})</span>
            </div>
            <div class="progress mb-2" style="height: 6px;">
              <div class="progress-bar" style="width: {{ (globalStats.totalEtats > 0 ? (row.nb / globalStats.totalEtats * 100) : 0)|round(1) }}%;"></div>
            </div>
          {% else %}
            <p class="text-muted small mb-0">Aucune donnée</p>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>

  {# Liste + filtres #}
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <form method="get" class="row g-2 mb-3">
        <div class="col-md-6"><input type="text" name="q" value="{{ q ?? '' }}" class="form-control form-control-sm" placeholder="Rechercher (type, unité)..."></div>
        <div class="col-md-2"><select name="sort" class="form-select form-select-sm">
          <option value="dateReleve" {{ (sort ?? '') == 'dateReleve' ? 'selected' : '' }}>Date</option>
          <option value="type" {{ (sort ?? '') == 'type' ? 'selected' : '' }}>Type</option>
          <option value="valeur" {{ (sort ?? '') == 'valeur' ? 'selected' : '' }}>Valeur</option>
        </select></div>
        <div class="col-md-2"><select name="dir" class="form-select form-select-sm">
          <option value="DESC" {{ (dir ?? 'DESC') == 'DESC' ? 'selected' : '' }}>Desc</option>
          <option value="ASC" {{ (dir ?? '') == 'ASC' ? 'selected' : '' }}>Asc</option>
        </select></div>
        <div class="col-md-2">
          <button class="btn btn-primary btn-sm" type="submit">Filtrer</button>
          <a class="btn btn-outline-secondary btn-sm" href="{{ path('admin_etat_new') }}"><i class="bi bi-plus"></i></a>
        </div>
      </form>

      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
          <thead class="table-light"><tr><th>ID</th><th>Type</th><th>Valeur</th><th>Unité</th><th>Date</th><th>Utilisateur</th><th></th></tr></thead>
          <tbody>
          {% for e in etats %}
            <tr>
              <td>{{ e.id }}</td>
              <td>{{ e.type }}</td>
              <td>{{ e.valeur }}</td>
              <td>{{ e.unite }}</td>
              <td>{{ e.dateReleve ? e.dateReleve|date('d/m/Y') : '-' }}</td>
              <td>{{ e.utilisateur ? (e.utilisateur.prenom ~ ' ' ~ e.utilisateur.nom) : '-' }}</td>
              <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" href="{{ path('admin_etat_show', {id: e.id}) }}">Voir</a>
                <a class="btn btn-sm btn-outline-secondary" href="{{ path('admin_etat_edit', {id: e.id}) }}">Éditer</a>
                <form class="d-inline" method="post" action="{{ path('admin_etat_delete', {id: e.id}) }}" onsubmit="return confirm('Supprimer ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ e.id) }}">
                  <button class="btn btn-sm btn-outline-danger">Supp.</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="7" class="text-center text-muted">Aucun relevé.</td></tr>
          {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
(function() {
  var labels = {{ chartLabels|default([])|json_encode|raw }};
  var data = {{ chartData|default([])|json_encode|raw }};
  var ctx = document.getElementById('chartEtatByDay');
  if (ctx && labels.length) {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: labels,
        datasets: [{
          label: 'Relevés',
          data: data,
          borderColor: 'rgb(34, 197, 94)',
          backgroundColor: 'rgba(34, 197, 94, 0.1)',
          fill: true,
          tension: 0.3
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: {
          y: { beginAtZero: true, ticks: { stepSize: 1 } },
          x: { grid: { display: false } }
        }
      }
    });
  }
})();
</script>
{% endblock %}
