{% extends 'back/base.html.twig' %}

{% block page_title %}État #{{ etat.id }}{% endblock %}

{% block body %}
<div class="card shadow-sm">
  <div class="card-body">
    <p><strong>Type :</strong> {{ etat.type }}</p>
    <p><strong>Valeur :</strong> {{ etat.valeur }} {{ etat.unite }}</p>
    <p><strong>Date relevé :</strong> {{ etat.dateReleve ? etat.dateReleve|date('d/m/Y') : '' }}</p>
    <p><strong>Utilisateur :</strong> {{ etat.utilisateur ? etat.utilisateur.fullName : '-' }}</p>
    <a class="btn btn-primary" href="{{ path('admin_etat_edit', {id: etat.id}) }}">Éditer</a>
    <a class="btn btn-outline-secondary" href="{{ path('admin_etat_index') }}">Retour</a>
  </div>
</div>
{% endblock %}
