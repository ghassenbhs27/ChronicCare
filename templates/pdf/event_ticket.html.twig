{% extends 'pdf/base.html.twig' %}

{% block title %}Ticket - {{ inscription.evenement.titre }}{% endblock %}

{% block extra_styles %}
.ticket-container {
    border: 3px dashed #198754;
    border-radius: 15px;
    padding: 25px;
    margin-bottom: 20px;
    position: relative;
}

.ticket-header {
    background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
    color: white;
    padding: 25px;
    border-radius: 10px;
    margin-bottom: 20px;
    text-align: center;
}

.ticket-event-name {
    font-size: 24px;
    font-weight: bold;
    margin-bottom: 10px;
}

.ticket-badge {
    background: rgba(255,255,255,0.2);
    padding: 5px 15px;
    border-radius: 20px;
    display: inline-block;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.ticket-number {
    text-align: center;
    padding: 15px;
    background: #f8f9fa;
    border-radius: 8px;
    margin: 20px 0;
}

.ticket-number-value {
    font-size: 28px;
    font-weight: bold;
    color: #198754;
    font-family: monospace;
    letter-spacing: 3px;
}

.ticket-number-label {
    font-size: 11px;
    color: #666;
    text-transform: uppercase;
}

.ticket-divider {
    border-top: 2px dashed #dee2e6;
    margin: 20px 0;
    position: relative;
}

.ticket-divider::before,
.ticket-divider::after {
    content: "";
    position: absolute;
    top: -12px;
    width: 24px;
    height: 24px;
    background: white;
    border-radius: 50%;
    border: 3px dashed #198754;
}

.ticket-divider::before { left: -37px; }
.ticket-divider::after { right: -37px; }

.event-info-grid {
    display: table;
    width: 100%;
}

.event-info-item {
    display: table-cell;
    width: 33.33%;
    text-align: center;
    padding: 10px;
}

.event-info-icon {
    font-size: 24px;
    margin-bottom: 5px;
}

.event-info-value {
    font-weight: bold;
    color: #333;
}

.event-info-label {
    font-size: 10px;
    color: #666;
    text-transform: uppercase;
}
{% endblock %}

{% block content %}
<div class="ticket-container">
    <!-- En-tête du ticket -->
    <div class="ticket-header">
        <div class="ticket-badge">🎟️ Billet d'entrée</div>
        <div class="ticket-event-name">{{ inscription.evenement.titre }}</div>
    </div>
    
    <!-- Numéro de ticket -->
    <div class="ticket-number">
        <div class="ticket-number-label">Numéro de ticket</div>
        <div class="ticket-number-value">TICK-{{ inscription.id }}-{{ inscription.dateInscription|date('ymd') }}</div>
    </div>
    
    <!-- Infos événement -->
    <div class="event-info-grid">
        <div class="event-info-item">
            <div class="event-info-icon">📅</div>
            <div class="event-info-value">{{ inscription.evenement.dateDebut|date('d/m/Y') }}</div>
            <div class="event-info-label">Date</div>
        </div>
        <div class="event-info-item">
            <div class="event-info-icon">🕐</div>
            <div class="event-info-value">{{ inscription.evenement.dateDebut|date('H:i') }}</div>
            <div class="event-info-label">Heure</div>
        </div>
        <div class="event-info-item">
            <div class="event-info-icon">📍</div>
            <div class="event-info-value">{{ inscription.evenement.lieu|default('À confirmer') }}</div>
            <div class="event-info-label">Lieu</div>
        </div>
    </div>
    
    <div class="ticket-divider"></div>
    
    <!-- Informations participant -->
    <div class="row">
        <div class="col-half">
            <div class="info-box">
                <div class="info-box-title">👤 Participant</div>
                <div class="info-row">
                    <span class="info-label">Nom:</span> 
                    {{ inscription.nom }} {{ inscription.prenom }}
                </div>
                <div class="info-row">
                    <span class="info-label">Email:</span> 
                    {{ inscription.email }}
                </div>
                {% if inscription.telephone %}
                <div class="info-row">
                    <span class="info-label">Téléphone:</span> 
                    {{ inscription.telephone }}
                </div>
                {% endif %}
            </div>
        </div>
        
        <div class="col-half">
            <div class="info-box">
                <div class="info-box-title">📋 Inscription</div>
                <div class="info-row">
                    <span class="info-label">Date:</span> 
                    {{ inscription.dateInscription|date('d/m/Y H:i') }}
                </div>
                <div class="info-row">
                    <span class="info-label">Statut:</span> 
                    <span class="badge badge-success">Confirmé</span>
                </div>
                {% if inscription.evenement.prix is defined and inscription.evenement.prix %}
                <div class="info-row">
                    <span class="info-label">Tarif:</span> 
                    {{ inscription.evenement.prix|number_format(2, ',', ' ') }} €
                </div>
                {% else %}
                <div class="info-row">
                    <span class="info-label">Tarif:</span> 
                    Gratuit
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

<!-- Description de l'événement -->
{% if inscription.evenement.description %}
<div class="info-box">
    <div class="info-box-title">📝 À propos de l'événement</div>
    <p style="line-height: 1.8;">{{ inscription.evenement.description }}</p>
</div>
{% endif %}

<!-- Instructions -->
<div class="highlight-box">
    <h3>📌 Instructions</h3>
    <ul style="margin-left: 20px; margin-top: 10px;">
        <li>Présentez ce ticket (imprimé ou numérique) à l'entrée</li>
        <li>Arrivez <strong>15 minutes avant</strong> le début de l'événement</li>
        <li>Une pièce d'identité peut vous être demandée</li>
    </ul>
</div>

<!-- Contact -->
<div style="text-align: center; margin-top: 20px; padding: 15px; background: #f8f9fa; border-radius: 8px;">
    <strong>Questions ?</strong> Contactez-nous à <strong>evenements@chroniccare.com</strong>
</div>
{% endblock %}
