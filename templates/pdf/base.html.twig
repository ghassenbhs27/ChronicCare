<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Document{% endblock %}</title>
    <style>
        /* Reset et styles de base */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'DejaVu Sans', Arial, sans-serif;
            font-size: 12px;
            line-height: 1.5;
            color: #333;
            padding: 20px;
        }
        
        /* En-tête */
        .header {
            border-bottom: 3px solid #198754;
            padding-bottom: 20px;
            margin-bottom: 30px;
        }
        
        .logo {
            font-size: 28px;
            font-weight: bold;
            color: #198754;
        }
        
        .logo-subtitle {
            font-size: 12px;
            color: #666;
        }
        
        .company-info {
            float: right;
            text-align: right;
            font-size: 10px;
            color: #666;
        }
        
        /* Titre du document */
        .document-title {
            font-size: 24px;
            color: #198754;
            margin-bottom: 5px;
            text-transform: uppercase;
        }
        
        .document-subtitle {
            font-size: 14px;
            color: #666;
            margin-bottom: 20px;
        }
        
        /* Boîtes d'info */
        .info-box {
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 20px;
        }
        
        .info-box-title {
            font-weight: bold;
            color: #198754;
            margin-bottom: 10px;
            font-size: 14px;
        }
        
        .info-row {
            margin-bottom: 5px;
        }
        
        .info-label {
            font-weight: bold;
            color: #666;
        }
        
        /* Tableaux */
        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 20px;
        }
        
        th {
            background: #198754;
            color: white;
            padding: 12px 10px;
            text-align: left;
            font-weight: bold;
        }
        
        td {
            padding: 10px;
            border-bottom: 1px solid #dee2e6;
        }
        
        tr:nth-child(even) {
            background: #f8f9fa;
        }
        
        .text-right {
            text-align: right;
        }
        
        .text-center {
            text-align: center;
        }
        
        /* Totaux */
        .totals {
            float: right;
            width: 300px;
        }
        
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #dee2e6;
        }
        
        .total-row.grand-total {
            font-size: 16px;
            font-weight: bold;
            color: #198754;
            border-bottom: 3px solid #198754;
            border-top: 3px solid #198754;
        }
        
        /* Badges/Tags */
        .badge {
            display: inline-block;
            padding: 3px 10px;
            border-radius: 12px;
            font-size: 10px;
            font-weight: bold;
            text-transform: uppercase;
        }
        
        .badge-success {
            background: #d1e7dd;
            color: #0f5132;
        }
        
        .badge-warning {
            background: #fff3cd;
            color: #664d03;
        }
        
        .badge-info {
            background: #cff4fc;
            color: #055160;
        }
        
        .badge-danger {
            background: #f8d7da;
            color: #842029;
        }
        
        /* Pied de page */
        .footer {
            position: fixed;
            bottom: 20px;
            left: 20px;
            right: 20px;
            border-top: 1px solid #dee2e6;
            padding-top: 10px;
            font-size: 9px;
            color: #666;
        }
        
        .footer-left {
            float: left;
        }
        
        .footer-right {
            float: right;
        }
        
        /* Utilitaires */
        .clearfix::after {
            content: "";
            display: table;
            clear: both;
        }
        
        .mt-20 { margin-top: 20px; }
        .mb-20 { margin-bottom: 20px; }
        .p-15 { padding: 15px; }
        
        .highlight-box {
            background: linear-gradient(135deg, #198754 0%, #20c997 100%);
            color: white;
            padding: 20px;
            border-radius: 8px;
            margin: 20px 0;
        }
        
        .highlight-box h3 {
            margin-bottom: 10px;
        }
        
        /* Grille simple */
        .row {
            display: table;
            width: 100%;
        }
        
        .col-half {
            display: table-cell;
            width: 50%;
            vertical-align: top;
            padding-right: 15px;
        }
        
        .col-half:last-child {
            padding-right: 0;
            padding-left: 15px;
        }
        
        {% block extra_styles %}{% endblock %}
    </style>
</head>
<body>
    <!-- En-tête -->
    <div class="header clearfix">
        <div class="company-info">
            ChronicCare<br>
            contact@chroniccare.com<br>
            +216 XX XXX XXX
        </div>
        <div class="logo">
            🏥 ChronicCare
            <div class="logo-subtitle">Votre santé, notre priorité</div>
        </div>
    </div>
    
    {% block content %}{% endblock %}
    
    <!-- Pied de page -->
    <div class="footer clearfix">
        <div class="footer-left">
            Document généré le {{ generatedAt|date('d/m/Y à H:i') }}
        </div>
        <div class="footer-right">
            ChronicCare - Tous droits réservés {{ "now"|date('Y') }}
        </div>
    </div>
</body>
</html>
