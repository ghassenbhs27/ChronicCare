{% extends 'base.html.twig' %}

{% block title %}Statistiques - Mon suivi{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/coach.css') }}" rel="stylesheet">
  <style>
    .stats-page { padding-top: 1.5rem; padding-bottom: 3rem; }
    .stats-kpi { background: var(--surface-color); border-radius: 16px; border: 1px solid rgba(2,20,24,0.08); padding: 1.25rem; box-shadow: 0 4px 24px rgba(2,20,24,0.06); }
    .stats-kpi .stats-kpi-value { font-size: 1.75rem; font-weight: 800; color: var(--heading-color); }
    .stats-kpi .stats-kpi-label { font-size: 0.85rem; color: #64748b; margin-top: 0.25rem; }
    .stats-chart-card { background: var(--surface-color); border-radius: 16px; border: 1px solid rgba(2,20,24,0.08); padding: 1.5rem; margin-bottom: 1.5rem; box-shadow: 0 4px 24px rgba(2,20,24,0.06); }
    .stats-chart-card h3 { font-size: 1.1rem; font-weight: 700; margin-bottom: 1rem; color: var(--heading-color); }
    .stats-chart-container { position: relative; height: 280px; }
  </style>
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main stats-page">
    <div class="container">
      <nav aria-label="Fil d'Ariane" class="forum-breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
          <li class="breadcrumb-item"><a href="{{ path('suivi_front_dashboard') }}">Mon suivi</a></li>
          <li class="breadcrumb-item active" aria-current="page">Statistiques</li>
        </ol>
      </nav>

      <header class="forum-hero text-start">
        <h1 class="forum-hero-title"><i class="bi bi-graph-up-arrow me-2"></i>Mes statistiques</h1>
        <p class="forum-hero-sub">Vue d’ensemble de vos activités, relevés de santé et rendez-vous.</p>
      </header>

      <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
          <div class="stats-kpi">
            <div class="stats-kpi-value">{{ activiteStats.totalActivites }}</div>
            <div class="stats-kpi-label">Activités</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stats-kpi">
            <div class="stats-kpi-value">{{ activiteStats.totalDuree }} min</div>
            <div class="stats-kpi-label">Durée totale</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stats-kpi">
            <div class="stats-kpi-value">{{ activiteStats.totalCalories }}</div>
            <div class="stats-kpi-label">Calories</div>
          </div>
        </div>
        <div class="col-6 col-md-3">
          <div class="stats-kpi">
            <div class="stats-kpi-value">{{ totalRdv }}</div>
            <div class="stats-kpi-label">Rendez-vous</div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-8">
          <div class="stats-chart-card">
            <h3><i class="bi bi-activity me-2"></i>Activités sur {{ days }} jours</h3>
            <div class="stats-chart-container">
              <canvas id="chartActivitesByDay"></canvas>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="stats-chart-card">
            <h3><i class="bi bi-pie-chart me-2"></i>Répartition par type d’activité</h3>
            <div class="stats-chart-container">
              <canvas id="chartActivitesByType"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-6">
          <div class="stats-chart-card">
            <h3><i class="bi bi-heart-pulse me-2"></i>Relevés de santé par type</h3>
            <div class="stats-chart-container">
              <canvas id="chartEtatsByType"></canvas>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="stats-chart-card">
            <h3><i class="bi bi-calendar2-check me-2"></i>RDV par statut</h3>
            <div class="stats-chart-container">
              <canvas id="chartRdvStatut"></canvas>
            </div>
          </div>
        </div>
      </div>

      <div class="row">
        <div class="col-lg-6">
          <div class="stats-chart-card">
            <h3><i class="bi bi-graph-up me-2"></i>Évolution des relevés ({{ days }} jours)</h3>
            <div class="stats-chart-container">
              <canvas id="chartRelevesEvolution"></canvas>
            </div>
          </div>
        </div>
        <div class="col-lg-6">
          <div class="stats-chart-card">
            <h3><i class="bi bi-calendar3 me-2"></i>Rendez-vous par mois</h3>
            <div class="stats-chart-container">
              <canvas id="chartRdvByMonth"></canvas>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    (function() {
      const opts = { responsive: true, maintainAspectRatio: false };
      const chartData = {{ chart_activites_by_day|json_encode|raw }};
      if (chartData.labels && chartData.labels.length) {
        new Chart(document.getElementById('chartActivitesByDay'), {
          type: 'line',
          data: chartData,
          options: { ...opts, scales: { y: { beginAtZero: true } } }
        });
      }
      const chartType = {{ chart_activites_by_type|json_encode|raw }};
      if (chartType.labels && chartType.labels.length) {
        new Chart(document.getElementById('chartActivitesByType'), { type: 'doughnut', data: chartType, options: opts });
      }
      const chartEtats = {{ chart_etats_by_type|json_encode|raw }};
      if (chartEtats.labels && chartEtats.labels.length) {
        new Chart(document.getElementById('chartEtatsByType'), { type: 'doughnut', data: chartEtats, options: opts });
      }
      const chartRdvSt = {{ chart_rdv_statut|json_encode|raw }};
      new Chart(document.getElementById('chartRdvStatut'), { type: 'doughnut', data: chartRdvSt, options: opts });
      const chartReleves = {{ chart_releves_evolution|json_encode|raw }};
      if (chartReleves.labels && chartReleves.labels.length) {
        new Chart(document.getElementById('chartRelevesEvolution'), {
          type: 'line',
          data: chartReleves,
          options: { ...opts, scales: { y: { beginAtZero: true } } }
        });
      }
      const chartRdvMonth = {{ chart_rdv_by_month|json_encode|raw }};
      new Chart(document.getElementById('chartRdvByMonth'), {
        type: 'bar',
        data: chartRdvMonth,
        options: { ...opts, scales: { y: { beginAtZero: true } } }
      });
    })();
  </script>
{% endblock %}
