{% extends 'base.html.twig' %}

{% block title %}Mes rendez-vous - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <h1 class="mb-4"><i class="bi bi-calendar-check me-2"></i>Mes rendez-vous</h1>

      {% if demoMode %}
        <div class="alert alert-warning">Mode démo : affichage des rendez-vous.</div>
      {% endif %}

      <div class="d-flex justify-content-end mb-3">
        <a class="btn btn-primary" href="{{ path('professionnels_list') }}">Prendre un rendez-vous</a>
      </div>

      <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-lg-4 col-md-6">
          <input type="text" name="q" value="{{ filters.q ?? '' }}" class="form-control" placeholder="Rechercher...">
        </div>
        <div class="col-lg-3 col-md-6">
          <select name="status" class="form-select">
            <option value="all" {{ (filters.status ?? 'all') == 'all' ? 'selected' : '' }}>Tous les statuts</option>
            <option value="en_attente" {{ (filters.status ?? '') == 'en_attente' ? 'selected' : '' }}>En attente</option>
            <option value="confirme" {{ (filters.status ?? '') == 'confirme' ? 'selected' : '' }}>Confirmé</option>
            <option value="annule" {{ (filters.status ?? '') == 'annule' ? 'selected' : '' }}>Annulé</option>
            <option value="termine" {{ (filters.status ?? '') == 'termine' ? 'selected' : '' }}>Terminé</option>
          </select>
        </div>
        <div class="col-lg-3 col-md-6">
          <select name="sort" class="form-select">
            <option value="date_asc" {{ (filters.sort ?? 'date_asc') == 'date_asc' ? 'selected' : '' }}>Date croissante</option>
            <option value="date_desc" {{ (filters.sort ?? '') == 'date_desc' ? 'selected' : '' }}>Date décroissante</option>
          </select>
        </div>
        <div class="col-lg-2 col-md-6 d-flex gap-2">
          <button class="btn btn-primary flex-grow-1 btn-sm" type="submit">Filtrer</button>
          <a class="btn btn-outline-secondary flex-grow-1 btn-sm" href="{{ path('patient_rdv_list') }}">Reset</a>
        </div>
      </form>

      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
      {% endfor %}

      {% if rdvs is empty %}
        <p class="text-muted">Aucun rendez-vous pour le moment. <a href="{{ path('professionnels_list') }}">Prendre un rendez-vous</a></p>
      {% else %}
        {% set status_badges = {
          'en_attente': 'badge bg-warning text-dark',
          'confirme': 'badge bg-success',
          'annule': 'badge bg-secondary',
          'termine': 'badge bg-primary'
        } %}
        <div class="table-responsive">
          <table class="table">
            <thead>
              <tr>
                <th>Date</th>
                <th>Professionnel</th>
                <th>Statut</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody>
              {% for rdv in rdvs %}
                <tr>
                  <td>{{ rdv.dateRdv|date('d/m/Y H:i') }}</td>
                  <td>{{ rdv.professionnel.prenom }} {{ rdv.professionnel.nom }}</td>
                  <td><span class="{{ status_badges[rdv.statut] ?? 'badge bg-light text-dark' }}">{{ rdv.statut|upper }}</span></td>
                  <td>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('patient_rdv_show', { id: rdv.id }) }}">Voir</a>
                    {% if rdv.statut != 'annule' and rdv.statut != 'termine' %}
                      <a class="btn btn-sm btn-outline-secondary" href="{{ path('patient_rdv_reschedule', { id: rdv.id }) }}">Modifier</a>
                      <form method="post" action="{{ path('patient_rdv_cancel', { id: rdv.id }) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('cancel_rdv_' ~ rdv.id) }}">
                        <button class="btn btn-sm btn-outline-danger" type="submit">Annuler</button>
                      </form>
                    {% endif %}
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </main>
{% endblock %}
