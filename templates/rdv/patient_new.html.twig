{% extends 'base.html.twig' %}

{% block title %}Prendre rendez-vous - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <h1 class="mb-4"><i class="bi bi-calendar-plus me-2"></i>Prendre rendez-vous</h1>
      <p class="text-muted mb-4">Avec {{ professionnel.prenom }} {{ professionnel.nom }}</p>

      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
      {% endfor %}

      <div class="card mb-4">
        <div class="card-body">
          {{ form_start(form) }}
            <div class="mb-3">
              {{ form_label(form.dateRdv) }}
              {{ form_widget(form.dateRdv, { attr: { class: 'form-control' } }) }}
              {{ form_errors(form.dateRdv) }}
            </div>
            <div class="mb-3">
              {{ form_label(form.motif) }}
              {{ form_widget(form.motif, { attr: { class: 'form-control' } }) }}
              {{ form_errors(form.motif) }}
            </div>
            <button class="btn btn-primary" type="submit">Confirmer</button>
          {{ form_end(form) }}
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h5>Creneaux disponibles</h5>
          {% if slots is empty %}
            <p class="text-muted mb-0">Aucun créneau disponible prochainement.</p>
          {% else %}
            <ul class="list-group list-group-flush">
              {% for slot in slots|slice(0, 10) %}
                <li class="list-group-item">{{ slot|date('d/m/Y H:i') }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      </div>
    </div>
  </main>
{% endblock %}
