{% extends 'base.html.twig' %}

{% block title %}Prendre rendez-vous - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <h1 class="mb-4"><i class="bi bi-calendar-plus me-2"></i>Prendre rendez-vous</h1>
      <p class="text-muted mb-4">Avec {{ professionnel.prenom }} {{ professionnel.nom }}</p>

      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ label }}">{{ message }}</div>
        {% endfor %}
      {% endfor %}

      {% if selectedDate is null %}
        <div class="card mb-4 border-warning shadow-sm">
          <div class="card-body">
            <h5 class="text-warning mb-3"><i class="bi bi-calendar-event me-2"></i>Choisir une date pour votre rendez-vous</h5>
            <p>Veuillez d'abord sélectionner une date pour voir les horaires disponibles avec <strong>{{ professionnel.prenom }} {{ professionnel.nom }}</strong>.</p>
            
            <form method="get" class="row g-3 align-items-end">
              <div class="col-md-6">
                <label for="date" class="form-label fw-bold">Date souhaitée</label>
                <input type="date" name="date" id="date" class="form-control" required min="{{ "now"|date("Y-m-d") }}">
              </div>
              <div class="col-md-4">
                <button type="submit" class="btn btn-warning w-100 fw-bold">Afficher les horaires</button>
              </div>
            </form>
          </div>
        </div>
      {% else %}
        <div class="card mb-4">
          <div class="card-body">
            <h5 class="mb-3">Choisir un horaire</h5>
            <p class="text-muted">Date sélectionnée : <strong>{{ selectedDate|date('d/m/Y') }}</strong></p>

            {% if slotsForDate is empty %}
              <div class="alert alert-info border-0 bg-light">
                <i class="bi bi-info-circle me-2"></i>Aucun créneau disponible pour cette date. Veuillez choisir une autre date.
                <div class="mt-3">
                   <a href="{{ path('patient_rdv_new', { id: professionnel.id }) }}" class="btn btn-sm btn-outline-primary">Changer de date</a>
                </div>
              </div>
            {% else %}
              {% set firstSlot = slotsForDate|first %}
              {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
                <div class="mb-3 d-none">
                  {{ form_widget(form.dateRdv, { attr: { id: 'dateRdvHidden', value: firstSlot ? firstSlot|date('Y-m-d\\TH:i') : '' } }) }}
                </div>
                <div class="mb-3">
                  {{ form_label(form.motif) }}
                  {{ form_widget(form.motif, { attr: { class: 'form-control', id: 'rdv-motif' } }) }}
                  {{ form_errors(form.motif) }}
                  <div id="motif-suggestions-title" class="mt-2 small fw-semibold text-muted" style="display:none;">Conseils rapides</div>
                  <div id="motif-suggestions" class="small text-muted"></div>
                  <input type="hidden" name="pre_advice" id="pre-advice">
                </div>

                {{ form_errors(form.dateRdv) }}

                <div class="list-group mb-3">
                  {% for slot in slotsForDate %}
                    <button type="button" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-slot="{{ slot|date('Y-m-d\\TH:i') }}">
                      {{ slot|date('d/m/Y H:i') }}
                      <span class="badge bg-primary">Choisir</span>
                    </button>
                  {% endfor %}
                </div>

                <div class="d-flex gap-2">
                  <button class="btn btn-primary" type="submit" id="confirm-rdv" {{ firstSlot ? '' : 'disabled' }}>Confirmer</button>
                  <a class="btn btn-outline-secondary" href="{{ path('patient_rdv_new', { id: professionnel.id }) }}">Changer de date</a>
                </div>
              {{ form_end(form) }}
            {% endif %}
          </div>
        </div>
      {% endif %}
    </div>
  </main>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script>
    (function () {
      const buttons = document.querySelectorAll('[data-slot]');
      const hidden = document.getElementById('dateRdvHidden');
      const submitBtn = document.getElementById('confirm-rdv');
      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          if (hidden) hidden.value = btn.getAttribute('data-slot');
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          if (submitBtn) submitBtn.disabled = false;
        });
      });

      if (hidden && hidden.value && submitBtn) {
        submitBtn.disabled = false;
      }
    })();
  </script>
  <script>
    (function () {
      const motifInput = document.getElementById('rdv-motif');
      const target = document.getElementById('motif-suggestions');
      if (!motifInput || !target) return;

      const suggestionsByKeyword = [
        { keys: ['diabete', 'glycemie', 'sucre'], tips: ['Surveiller la glycemie', 'Limiter les sucres rapides', 'Boire de l eau regulierement'] },
        { keys: ['hypertension', 'tension', 'hta'], tips: ['Limiter le sel', 'Mesurer la tension', 'Eviter les excitants'] },
        { keys: ['poids', 'surpoids', 'obesite', 'imc'], tips: ['Equilibrer les repas', 'Bouger 30 min par jour', 'Limiter le grignotage'] },
        { keys: ['stress', 'anxiete', 'angoisse'], tips: ['Respiration profonde', 'Pause ecran', 'Marche quotidienne'] },
        { keys: ['sommeil', 'insomnie', 'fatigue'], tips: ['Routine de sommeil', 'Limiter cafe le soir', 'Eviter les ecrans tard'] },
        { keys: ['douleur', 'arthrose', 'articulation'], tips: ['Activites douces', 'Etirements legers', 'Adapter l effort'] },
        { keys: ['nutrition', 'alimentation', 'regime'], tips: ['Plus de legumes', 'Eau avant repas', 'Eviter ultra-transformes'] },
      ];

      const genericTips = [
        'Boire suffisamment d eau',
        'Activite physique adaptee',
        'Prendre ses traitements',
      ];

      const renderTips = (tips) => {
        const title = document.getElementById('motif-suggestions-title');
        if (title) title.style.display = tips.length ? 'block' : 'none';
        target.innerHTML = tips.map(t => `<div>  ${t}</div>`).join('');
        const hidden = document.getElementById('pre-advice');
        if (hidden) hidden.value = tips.map(t => `- ${t}`).join('\n');
      };

      const update = () => {
        const value = (motifInput.value || '').toLowerCase();
        if (value.trim() === '') {
          target.textContent = '';
          const title = document.getElementById('motif-suggestions-title');
          if (title) title.style.display = 'none';
          const hidden = document.getElementById('pre-advice');
          if (hidden) hidden.value = '';
          return;
        }

        const matched = [];
        for (const rule of suggestionsByKeyword) {
          if (rule.keys.some(k => value.includes(k))) {
            matched.push(...rule.tips);
          }
        }

        const tips = matched.length > 0 ? Array.from(new Set(matched)).slice(0, 5) : genericTips;
        renderTips(tips);
      };

      motifInput.addEventListener('input', update);
    })();
  </script>
{% endblock %}
