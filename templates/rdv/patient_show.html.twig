{% extends 'base.html.twig' %}

{% block title %}Détail du rendez-vous - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <a href="{{ path('patient_rdv_list') }}" class="btn btn-outline-secondary mb-3">&larr; Retour</a>

      <div class="card mb-4">
        <div class="card-body">
          <h2 class="mb-4">Détail du rendez-vous</h2>
          <dl class="row">
            <dt class="col-sm-3">Professionnel</dt>
            <dd class="col-sm-9">{{ rdv.professionnel.prenom }} {{ rdv.professionnel.nom }}</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">{{ rdv.dateRdv|date('d/m/Y H:i') }}</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">{{ rdv.statut|upper }}</span></dd>

            <dt class="col-sm-3">Motif</dt>
            <dd class="col-sm-9">{{ rdv.motif ?: 'Non renseigné' }}</dd>

            {% if rdv.conseilsPreconsultation %}
            <dt class="col-sm-3">Conseils rapides</dt>
            <dd class="col-sm-9"><pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">{{ rdv.conseilsPreconsultation }}</pre></dd>
            {% endif %}
          </dl>
        </div>
      </div>

      {% if rdv.consultation and rdv.statut == 'termine' %}
      <div class="card border-primary">
        <div class="card-header bg-primary bg-opacity-10 text-primary">
          <h3 class="h5 mb-0"><i class="bi bi-journal-text me-2"></i>Note de consultation</h3>
          <small class="text-muted">Rédigée par votre professionnel le {{ rdv.consultation.dateConsultation|date('d/m/Y à H:i') }}</small>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <strong class="text-muted small">Notes</strong>
            <p class="mb-0 mt-1">{{ rdv.consultation.notes|nl2br }}</p>
          </div>
          {% if rdv.consultation.diagnostic %}
          <div class="mb-3">
            <strong class="text-muted small">Diagnostic / Synthèse</strong>
            <p class="mb-0 mt-1">{{ rdv.consultation.diagnostic|nl2br }}</p>
          </div>
          {% endif %}
          {% if rdv.consultation.resume %}
          <div class="mb-3">
            <strong class="text-muted small">Résumé</strong>
            <p class="mb-0 mt-1">{{ rdv.consultation.resume|nl2br }}</p>
          </div>
          {% endif %}
          {% if rdv.consultation.conseils %}
          <div class="mb-3">
            <strong class="text-muted small">Conseils</strong>
            <p class="mb-0 mt-1">{{ rdv.consultation.conseils|nl2br }}</p>
          </div>
          {% endif %}
          {% if rdv.consultation.documentName %}
          <div>
            <strong class="text-muted small">Document</strong>
            <p class="mb-0 mt-1">
              <a href="{{ vich_uploader_asset(rdv.consultation, 'documentFile') }}" target="_blank" rel="noopener">Télécharger le document</a>
            </p>
          </div>
          {% endif %}
        </div>
      </div>
      {% elseif rdv.consultation %}
      <div class="card border-light">
        <div class="card-body text-muted text-center py-4">
          <i class="bi bi-journal-text fs-1"></i>
          <p class="mb-0 mt-2">La note de consultation sera visible après la consultation.</p>
        </div>
      </div>
      {% else %}
      <div class="card border-light">
        <div class="card-body text-muted text-center py-4">
          <i class="bi bi-journal-text fs-1"></i>
          <p class="mb-0 mt-2">Aucune note de consultation pour ce rendez-vous.</p>
          <p class="small mb-0">Votre professionnel pourra en ajouter une après la consultation.</p>
        </div>
      </div>
      {% endif %}
    </div>
  </main>
{% endblock %}
