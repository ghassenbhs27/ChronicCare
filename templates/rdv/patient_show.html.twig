{% extends 'base.html.twig' %}

{% block title %}Détail du rendez-vous - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <a href="{{ path('patient_rdv_list') }}" class="btn btn-outline-secondary mb-3">&larr; Retour</a>

      <div class="card mb-4 border-0 shadow-sm">
        <div class="card-body">
          <h2 class="mb-4">Détail du rendez-vous</h2>
          <dl class="row mb-0">
            <dt class="col-sm-3">Professionnel</dt>
            <dd class="col-sm-9 text-capitalize">{{ rdv.professionnel.prenom }} {{ rdv.professionnel.nom }}</dd>

            <dt class="col-sm-3">Date</dt>
            <dd class="col-sm-9">{{ rdv.dateRdv|date('d/m/Y H:i') }}</dd>

            <dt class="col-sm-3">Statut</dt>
            <dd class="col-sm-9"><span class="badge bg-primary">{{ rdv.statut|upper }}</span></dd>

            <dt class="col-sm-3">Motif</dt>
            <dd class="col-sm-9">{{ rdv.motif ?: 'Non renseigné' }}</dd>

            {% if rdv.conseilsPreconsultation %}
            <dt class="col-sm-3">Conseils rapides</dt>
            <dd class="col-sm-9"><pre class="mb-0" style="white-space: pre-wrap; font-family: inherit;">{{ rdv.conseilsPreconsultation }}</pre></dd>
            {% endif %}
          </dl>
        </div>
      </div>

      {% if rdv.consultation %}
      <div class="card border-primary shadow-sm">
        <div class="card-header bg-primary bg-opacity-10 text-primary d-flex justify-content-between align-items-center">
          <h3 class="h5 mb-0"><i class="bi bi-journal-text me-2"></i>Note de consultation</h3>
          <span class="badge {{ rdv.statut == 'termine' ? 'bg-success' : 'bg-info' }}">
            {{ rdv.statut == 'termine' ? 'Consultation terminée' : 'Note en cours' }}
          </span>
        </div>
        <div class="card-body">
          <div class="mb-3">
            <strong class="text-muted small">Synthèse du professionnel</strong>
            <p class="mb-0 mt-1">{{ rdv.consultation.notes|nl2br }}</p>
          </div>
          {% if rdv.consultation.diagnostic %}
          <div class="mb-3">
            <strong class="text-muted small">Diagnostic / Observations</strong>
            <p class="mb-0 mt-1">{{ rdv.consultation.diagnostic|nl2br }}</p>
          </div>
          {% endif %}
          
          <hr class="my-4 text-muted opacity-25">
          
          <div class="row g-4">
            {% if rdv.consultation.resume %}
            <div class="col-md-6">
              <div class="p-4 bg-light rounded-4 h-100 border-0">
                <strong class="text-primary d-block mb-2"><i class="bi bi-card-text me-2"></i>Résumé</strong>
                <p class="mb-0 small text-dark" style="line-height: 1.6;">{{ rdv.consultation.resume|nl2br }}</p>
              </div>
            </div>
            {% endif %}
            
            {% if rdv.consultation.conseils %}
            <div class="col-md-6">
              <div class="p-4 bg-light rounded-4 h-100 border-start border-primary border-4 shadow-sm">
                <strong class="text-primary d-block mb-2"><i class="bi bi-lightbulb me-2"></i>Conseils & Préconisations</strong>
                <p class="mb-0 small text-dark" style="line-height: 1.6;">{{ rdv.consultation.conseils|nl2br }}</p>
              </div>
            </div>
            {% endif %}
          </div>

          {% if rdv.consultation.documentName %}
          <div class="mt-4 p-3 border rounded-3 d-flex align-items-center justify-content-between bg-light bg-opacity-50">
            <div class="d-flex align-items-center gap-3">
               <i class="bi bi-file-earmark-pdf fs-3 text-danger"></i>
               <div>
                 <div class="fw-bold">Document joint</div>
                 <div class="text-muted small">{{ rdv.consultation.documentOriginalName }}</div>
               </div>
            </div>
            <a href="{{ vich_uploader_asset(rdv.consultation, 'documentFile') }}" class="btn btn-primary btn-sm rounded-pill px-3" target="_blank" rel="noopener">
              <i class="bi bi-download me-1"></i> Télécharger
            </a>
          </div>
          {% endif %}
        </div>
        <div class="card-footer bg-transparent border-0 text-muted small pb-4 px-4">
          Note mise à jour le {{ (rdv.consultation.updatedAt ?: rdv.consultation.dateConsultation)|date('d/m/Y à H:i') }}
        </div>
      </div>
      {% else %}
      <div class="card border-0 shadow-sm">
        <div class="card-body text-muted text-center py-5">
          <i class="bi bi-journal-text fs-1 opacity-25"></i>
          <p class="mb-0 mt-3 fs-5">Aucune note de consultation pour ce rendez-vous.</p>
          <p class="small mb-0">Votre professionnel pourra en ajouter une après la consultation.</p>
        </div>
      </div>
      {% endif %}
    </div>
  </main>
{% endblock %}
