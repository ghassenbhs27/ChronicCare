{% extends 'base.html.twig' %}

{% block title %}Suivi Commande - ChronicCare{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1>Suivi de commande</h1>

    <div class="card mt-4">
        <div class="card-body">
            <h5>Commande #{{ commande.numeroCommande }}</h5>
            
            <div class="mt-3">
                <p><strong>Statut:</strong> 
                    <span class="badge badge-success">{{ commande.statut|upper }}</span>
                </p>
                <p><strong>Total:</strong> {{ commande.total }} €</p>
                <p><strong>Date:</strong> {{ commande.createdAt|date('d/m/Y') }}</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
