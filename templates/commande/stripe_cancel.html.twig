{% extends 'base.html.twig' %}

{% block title %}Paiement annulé - Chronic Care{% endblock %}
{% block body_class %}checkout-page{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

<main class="main">
  <div class="page-title">
    <div class="container">
      <h1>Paiement annulé</h1>
    </div>
  </div>

  <section class="section light-background">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-8">
          <div class="card text-center shadow-sm">
            <div class="card-body py-5">
              <!-- Icône d'annulation -->
              <div class="mb-4">
                <div style="width:80px;height:80px;border-radius:50%;background:#ffc107;display:inline-flex;align-items:center;justify-content:center;">
                  <i class="bi bi-x-lg text-white" style="font-size:3rem;"></i>
                </div>
              </div>

              <h2 class="text-warning mb-3">Paiement annulé</h2>
              <p class="lead text-muted mb-4">
                Votre paiement n'a pas été effectué. Votre commande <strong>{{ commande.numeroCommande }}</strong> reste en attente.
              </p>

              <div class="alert alert-info d-inline-flex align-items-center gap-2">
                <i class="bi bi-info-circle-fill"></i>
                <span>Aucun montant n'a été débité de votre compte. Vous pouvez réessayer le paiement à tout moment.</span>
              </div>

              <!-- Détails de la commande -->
              <div class="card bg-light mx-auto mt-4" style="max-width:500px;">
                <div class="card-body">
                  <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">N° de commande :</span>
                    <strong>{{ commande.numeroCommande }}</strong>
                  </div>
                  <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Montant :</span>
                    <strong>{{ commande.total|number_format(2, ',', ' ') }} €</strong>
                  </div>
                  <div class="d-flex justify-content-between">
                    <span class="text-muted">Statut :</span>
                    <span class="badge bg-warning text-dark">En attente</span>
                  </div>
                </div>
              </div>

              <!-- Actions -->
              <div class="mt-4 d-flex gap-2 justify-content-center flex-wrap">
                <a href="{{ path('commande_show', {id: commande.id}) }}" class="btn btn-primary btn-lg">
                  <i class="bi bi-eye"></i> Voir ma commande
                </a>
                <a href="{{ path('commande_history') }}" class="btn btn-outline-secondary btn-lg">
                  <i class="bi bi-clock-history"></i> Mes commandes
                </a>
                <a href="{{ path('produit_list') }}" class="btn btn-outline-success btn-lg">
                  <i class="bi bi-shop"></i> Continuer mes achats
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

{% include 'partials/_footer.html.twig' %}
{% endblock %}
