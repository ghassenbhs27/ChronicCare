{% extends 'base.html.twig' %}

{% block title %}Mes commandes - Chronic Care{% endblock %}
{% block body_class %}products-page{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

<main class="main">
  <div class="page-title">
    <div class="container">
      <h1>Mes commandes</h1>
    </div>
  </div>

  <section class="services section light-background">
    <div class="container">
      {% if commandes is empty %}
        <div class="alert alert-info">Vous n'avez pas encore passé de commande.</div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>N°</th>
                <th>Date</th>
                <th>Total</th>
                <th>Statut</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              {% for c in commandes %}
              <tr>
                <td>{{ c.numeroCommande }}</td>
                <td>{{ c.createdAt|date('d/m/Y H:i') }}</td>
                <td>{{ c.total }} €</td>
                <td>
                  <span class="badge {% if c.statut == 'livrée' %}bg-success{% elseif c.statut == 'annulée' %}bg-danger{% elseif c.statut == 'expédiée' %}bg-info{% else %}bg-warning{% endif %}">{{ c.statut }}</span>
                </td>
                <td>
                  <a href="{{ path('commande_show', {id: c.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a>
                </td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </section>
</main>

{% include 'partials/_footer.html.twig' %}
{% endblock %}
