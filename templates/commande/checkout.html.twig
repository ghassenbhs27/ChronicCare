{% extends 'base.html.twig' %}

{% block title %}Commander - Chronic Care{% endblock %}
{% block body_class %}checkout-page{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

<main class="main">
  <div class="page-title">
    <div class="container">
      <h1>Finaliser votre commande</h1>
    </div>
  </div>

  <section class="checkout section light-background">
    <div class="container">
      <div class="row">
        <!-- Formulaire multi-étapes -->
        <div class="col-lg-8">
          <form method="post" id="checkoutForm" novalidate data-turbo="false">
            <input type="hidden" name="_token" value="{{ csrf_token('checkout') }}">

            <!-- Affichage des erreurs globales -->
            {% if app.flashes('error') %}
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-circle-fill"></i> <strong>Erreur de validation</strong>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                <ul class="mb-0 mt-2">
                  {% for message in app.flashes('error') %}
                    <li>{{ message }}</li>
                  {% endfor %}
                </ul>
              </div>
            {% endif %}

            <!-- ÉTAPE 1 : INFORMATIONS PERSONNELLES -->
            <div class="card mb-3 checkout-section" id="section-1">
              <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <span class="badge bg-primary me-2">1</span>
                  <h5 class="mb-0">INFORMATIONS PERSONNELLES</h5>
                </div>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-toggle-section="1">
                  <i class="bi bi-pencil"></i> Modifier
                </button>
              </div>
              <div class="card-body">
                <p class="text-muted small mb-0">
                  <i class="bi bi-info-circle"></i> 
                  <a href="#" data-toggle-section="1">Se connecter avec un compte social</a> | 
                  <a href="#" data-toggle-section="1">Connexion</a> | 
                  <a href="#" data-toggle-section="1">Créer un compte</a>
                </p>
              </div>
            </div>

            <!-- ÉTAPE 2 : GÉOLOCALISATION AUTOMATIQUE -->
            <div class="card mb-3 checkout-section" id="section-2">
              <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <span class="badge bg-primary me-2">2</span>
                  <h5 class="mb-0">LOCALISATION DE LIVRAISON</h5>
                </div>
              </div>
              <div class="card-body">
                <!-- Champ caché pour l'IP -->
                <input type="hidden" name="ipAddress" class="geolocation-ip">
                
                <!-- Conteneur pour afficher les infos de géolocalisation -->
                <div id="geolocation-info"></div>
                
                <!-- Fallback si la géolocalisation n'est pas disponible -->
                <div id="geolocation-loading" class="alert alert-info d-flex align-items-center gap-2">
                  <div class="spinner-border spinner-border-sm" role="status">
                    <span class="visually-hidden">Chargement...</span>
                  </div>
                  <div>
                    <strong>Détection de votre localisation en cours...</strong><br>
                    <span class="small">Nous détectons automatiquement votre lieu de livraison via votre adresse IP.</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- ÉTAPE 3 : MODE DE LIVRAISON -->
            <div class="card mb-3 checkout-section" id="section-3">
              <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <span class="badge bg-primary me-2">3</span>
                  <h5 class="mb-0">MODE DE LIVRAISON</h5>
                </div>
              </div>
              <div class="card-body">
                <div class="form-check mb-3">
                  <input class="form-check-input" type="radio" name="livraison" id="livraison1" value="standard" checked>
                  <label class="form-check-label" for="livraison1">
                    <strong>Livraison Standard</strong> - Gratuit (4-7 jours ouvrables)
                  </label>
                </div>
                <div class="form-check mb-3">
                  <input class="form-check-input" type="radio" name="livraison" id="livraison2" value="express">
                  <label class="form-check-label" for="livraison2">
                    <strong>Livraison Express</strong> - 9,99 € (2-3 jours ouvrables)
                  </label>
                </div>
                <div class="form-check">
                  <input class="form-check-input" type="radio" name="livraison" id="livraison3" value="ultrarapide">
                  <label class="form-check-label" for="livraison3">
                    <strong>Ultra-rapide</strong> - 19,99 € (Lendemain avant 13h)
                  </label>
                </div>
              </div>
            </div>

            <!-- ÉTAPE 4 : PAIEMENT -->
            <div class="card mb-3 checkout-section" id="section-4">
              <div class="card-header bg-light d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                  <span class="badge bg-primary me-2">4</span>
                  <h5 class="mb-0">PAIEMENT</h5>
                </div>
              </div>
              <div class="card-body">

                <!-- Choix du mode de paiement -->
                <div class="mb-4">
                  <label class="form-label fw-bold">Mode de paiement <span class="text-danger">*</span></label>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <div class="form-check card p-3 h-100 border-primary" id="payment-stripe-option">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="payStripe" value="stripe" checked>
                        <label class="form-check-label w-100 d-flex align-items-center gap-2" for="payStripe" style="cursor:pointer;">
                          <i class="bi bi-stripe fs-4 text-primary"></i>
                          <div>
                            <strong>Payer par carte (Stripe)</strong>
                            <div class="text-muted small">Visa, Mastercard, etc. — paiement sécurisé</div>
                          </div>
                          <img src="https://img.icons8.com/color/48/stripe.png" alt="Stripe" style="height:28px;margin-left:auto;">
                        </label>
                      </div>
                    </div>
                    <div class="col-md-6">
                      <div class="form-check card p-3 h-100" id="payment-cod-option">
                        <input class="form-check-input" type="radio" name="paymentMethod" id="payCOD" value="cash_on_delivery">
                        <label class="form-check-label w-100 d-flex align-items-center gap-2" for="payCOD" style="cursor:pointer;">
                          <i class="bi bi-cash-stack fs-4 text-success"></i>
                          <div>
                            <strong>Paiement à la livraison</strong>
                            <div class="text-muted small">Payez en espèces à la réception</div>
                          </div>
                        </label>
                      </div>
                    </div>
                  </div>
                </div>

                <!-- Message Stripe -->
                <div id="stripeMessage">
                  <div class="alert alert-info d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-shield-lock-fill fs-5"></i>
                    <div>
                      <strong>Paiement sécurisé par Stripe</strong><br>
                      <span class="small">Vous serez redirigé vers la page de paiement sécurisée de Stripe pour finaliser votre commande. Vos données bancaires ne transitent jamais par notre serveur.</span>
                    </div>
                  </div>
                </div>

                <!-- Message paiement à la livraison -->
                <div id="codMessage" style="display:none;">
                  <div class="alert alert-success d-flex align-items-center gap-2 mb-0">
                    <i class="bi bi-info-circle-fill fs-5"></i>
                    <div>
                      <strong>Paiement à la livraison sélectionné</strong><br>
                      <span class="small">Vous paierez le montant total en espèces au livreur lors de la réception de votre commande. Veuillez préparer le montant exact.</span>
                    </div>
                  </div>
                </div>

                <div class="form-check mt-3">
                  <input class="form-check-input" type="checkbox" id="terms" required>
                  <label class="form-check-label small" for="terms">
                    J'accepte les <a href="#">conditions d'utilisation</a> et la <a href="#">politique de confidentialité</a>
                  </label>
                </div>
              </div>
            </div>

            <!-- Boutons d'action -->
            <div class="d-flex gap-2">
              <a href="{{ path('cart_show') }}" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left"></i> Retour au panier
              </a>
              <button type="submit" class="btn btn-success btn-lg w-100" id="submitBtn">
                <i class="bi bi-lock-fill" id="submitIcon"></i> <span id="submitText">Payer {{ total|number_format(2, ',', ' ') }} € avec Stripe</span>
              </button>
            </div>
          </form>
        </div>

        <!-- Résumé du panier (Sticky) -->
        <div class="col-lg-4">
          <div class="card sticky-top" style="top: 100px;">
            <div class="card-header bg-light">
              <h5 class="mb-0">
                <i class="bi bi-bag"></i> Résumé de la commande
              </h5>
            </div>
            <div class="card-body">
              <!-- Articles -->
              <div class="mb-3">
                <h6 class="text-muted mb-2">Articles commandés</h6>
                <div style="max-height: 300px; overflow-y: auto;">
                  {% for item in cart %}
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                      <div class="flex-grow-1">
                        <p class="mb-0 small"><strong>{{ item.nom }}</strong></p>
                        <p class="mb-0 text-muted small">Qté: {{ item.quantity }}</p>
                      </div>
                      <div class="text-end">
                        <p class="mb-0 small"><strong>{{ (item.prix * item.quantity)|number_format(2, ',', ' ') }} €</strong></p>
                        <p class="mb-0 text-muted small">{{ item.prix }} € x {{ item.quantity }}</p>
                      </div>
                    </div>
                  {% endfor %}
                </div>
              </div>

              <hr>

              <!-- Détails de la commande -->
              <div class="mb-3">
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Sous-total:</span>
                  <strong>{{ total|number_format(2, ',', ' ') }} €</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Livraison:</span>
                  <strong id="shipping-cost">Gratuit</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                  <span class="text-muted">Taxes:</span>
                  <strong>0,00 €</strong>
                </div>
              </div>

              <hr>

              <!-- Total -->
              <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Total TTC:</h5>
                <h5 class="mb-0 text-success" id="total-price">
                  <strong>{{ total|number_format(2, ',', ' ') }} €</strong>
                </h5>
              </div>

              <!-- Code promo (optionnel) -->
              <div class="input-group mb-3">
                <input 
                  type="text" 
                  class="form-control" 
                  placeholder="Code promo" 
                  id="promoCode">
                <button class="btn btn-outline-secondary" type="button">
                  <i class="bi bi-check"></i>
                </button>
              </div>
              <p class="text-muted small text-center mb-0">
                <a href="#">Voir plus de codes promos ?</a>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

{% include 'partials/_footer.html.twig' %}

<script>
(function() {
  // === Éléments DOM ===
  const paymentRadios = document.querySelectorAll('input[name="paymentMethod"]');
  const stripeMessage = document.getElementById('stripeMessage');
  const codMessage = document.getElementById('codMessage');
  const submitIcon = document.getElementById('submitIcon');
  const submitText = document.getElementById('submitText');
  const stripeOption = document.getElementById('payment-stripe-option');
  const codOption = document.getElementById('payment-cod-option');
  const livraisonRadios = document.querySelectorAll('input[name="livraison"]');
  const totalPriceEl = document.getElementById('total-price');
  const shippingCostEl = document.getElementById('shipping-cost');
  const baseTotal = parseFloat({{ total }});

  // Frais de livraison selon le mode choisi
  const shippingPrices = {
    standard: 0,
    express: 9.99,
    ultrarapide: 19.99
  };

  // Retourne le montant de livraison actuellement sélectionné
  function getSelectedShipping() {
    const selected = document.querySelector('input[name="livraison"]:checked');
    return selected ? (shippingPrices[selected.value] || 0) : 0;
  }

  // Formate un nombre en prix FR (ex: 4 629,66 €)
  function formatPrice(value) {
    return value.toLocaleString('fr-FR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + ' €';
  }

  // Calcule et retourne le total actuel (sous-total + livraison)
  function getCurrentTotal() {
    return baseTotal + getSelectedShipping();
  }

  // === Mise à jour du résumé (livraison + total TTC) ===
  function updateOrderSummary() {
    const shipping = getSelectedShipping();
    const total = baseTotal + shipping;

    // Mettre à jour la ligne livraison
    shippingCostEl.textContent = shipping === 0 ? 'Gratuit' : formatPrice(shipping);

    // Mettre à jour le total TTC
    totalPriceEl.innerHTML = '<strong>' + formatPrice(total) + '</strong>';

    // Mettre à jour le bouton de paiement
    updateSubmitButton();
  }

  // === Mise à jour du bouton submit ===
  function updateSubmitButton() {
    const paymentMethod = document.querySelector('input[name="paymentMethod"]:checked').value;
    if (paymentMethod === 'stripe') {
      submitIcon.className = 'bi bi-lock-fill';
      submitText.textContent = 'Payer ' + formatPrice(getCurrentTotal()) + ' avec Stripe';
    } else {
      submitIcon.className = 'bi bi-truck';
      submitText.textContent = 'Confirmer la commande (' + formatPrice(getCurrentTotal()) + ')';
    }
  }

  // === Gestion du choix de mode de paiement ===
  function updatePaymentMethod() {
    const selected = document.querySelector('input[name="paymentMethod"]:checked').value;
    if (selected === 'stripe') {
      stripeMessage.style.display = 'block';
      codMessage.style.display = 'none';
      stripeOption.classList.add('border-primary');
      codOption.classList.remove('border-success');
    } else {
      stripeMessage.style.display = 'none';
      codMessage.style.display = 'block';
      stripeOption.classList.remove('border-primary');
      codOption.classList.add('border-success');
    }
    updateSubmitButton();
  }

  // === Événements ===
  paymentRadios.forEach(r => r.addEventListener('change', updatePaymentMethod));
  livraisonRadios.forEach(r => r.addEventListener('change', updateOrderSummary));

  // === Init ===
  updateOrderSummary();
  updatePaymentMethod();

  // Gestion des boutons "Modifier"
  const toggleButtons = document.querySelectorAll('[data-toggle-section]');
  toggleButtons.forEach(btn => {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      const sectionId = this.getAttribute('data-toggle-section');
      const section = document.getElementById('section-' + sectionId);
      section.scrollIntoView({ behavior: 'smooth' });
    });
  });
})();
</script>

<!-- Script de géolocalisation automatique - INLINE pour éviter le cache navigateur -->
<script>
/**
 * Géolocalisation automatique via API Symfony (serveur)
 * Le serveur appelle IP-API, PAS le navigateur = pas de 403 CORS
 */
(function() {
    const TIMEOUT = 15000; // 15 secondes (IP-API peut être lent en dev)
    const IP_INPUT = '.geolocation-ip';
    const INFO_CONT = '#geolocation-info';
    const LOAD_DIV = '#geolocation-loading';
    
    console.log('🌍 [INLINE] Géolocalisation chargée');
    
    function init() {
        console.log('🌍 [INLINE] Initialisée...');
        const ipInput = document.querySelector(IP_INPUT);
        if (!ipInput) {
            console.warn('⚠️ [INLINE] Champ .geolocation-ip non trouvé');
            return;
        }
        fetchGeo();
    }
    
    function fetchGeo() {
        console.log('📡 [INLINE] Appel /api/geolocation/client (timeout: ' + TIMEOUT + 'ms)');
        
        const timeoutProm = new Promise((_, reject) =>
            setTimeout(() => {
                console.error('⏱️ [INLINE] Timeout après ' + TIMEOUT + 'ms');
                reject(new Error('Serveur non réactif (' + TIMEOUT + 'ms)'));
            }, TIMEOUT)
        );
        
        const fetchProm = fetch('/api/geolocation/client', {
            method: 'GET',
            headers: { 'Accept': 'application/json' }
        });
        
        Promise.race([fetchProm, timeoutProm])
            .then(res => {
                console.log('✅ [INLINE] Réponse reçue:', res.status);
                if (!res.ok) throw new Error('HTTP ' + res.status);
                return res.json();
            })
            .then(data => {
                console.log('📦 [INLINE] Données reçues:', data);
                if (data && (data.status === 'success' || data.status === 'partial') && data.data) {
                    console.log('✅ [INLINE] Succès:', data.data.city, data.data.country);
                    handleSuccess(data);
                } else if (data && data.ip) {
                    // Si pas de données de géoloc mais on a l'IP, c'est ok aussi
                    console.log('✅ [INLINE] IP reçue:', data.ip);
                    handleSuccess(data);
                } else {
                    throw new Error('Réponse invalide');
                }
            })
            .catch(err => {
                console.error('❌ [INLINE] Erreur:', err.message);
                showError('Erreur: ' + err.message);
            });
    }
    
    function handleSuccess(data) {
        console.log('🎉 [INLINE] Traitement des données...');
        const ipInput = document.querySelector(IP_INPUT);
        if (ipInput && data.ip) {
            ipInput.value = data.ip;
            console.log('✅ [INLINE] IP définie:', data.ip);
        }
        
        const infoCont = document.querySelector(INFO_CONT);
        if (infoCont && data.data) {
            const d = data.data;
            const city = d.city || 'N/A';
            const region = d.region ? d.region + ', ' : '';
            const country = d.country || 'N/A';
            const lat = typeof d.latitude === 'number' ? d.latitude.toFixed(4) : '--';
            const lon = typeof d.longitude === 'number' ? d.longitude.toFixed(4) : '--';
            
            infoCont.innerHTML = `
                <div class="alert alert-success">
                    <strong>✓ Localisation détectée</strong><br>
                    📍 ${city}, ${region}${country}<br>
                    ${lat}°N, ${lon}°E
                </div>
            `;
            console.log('📍 [INLINE] Infos affichées');
        }
        
        const loadDiv = document.querySelector(LOAD_DIV);
        if (loadDiv) {
            loadDiv.style.display = 'none';
            console.log('✅ [INLINE] Loading masqué');
        }
    }
    
    function showError(msg) {
        const loadDiv = document.querySelector(LOAD_DIV);
        if (loadDiv) {
            loadDiv.className = 'alert alert-warning';
            loadDiv.innerHTML = `<strong>⚠️ ${msg}</strong><br><small>La commande fonctionnera quand même sans localisation.</small>`;
        }
        console.error('❌ [INLINE] Erreur affichée:', msg);
    }
    
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }
})();
</script>

{% endblock %}
