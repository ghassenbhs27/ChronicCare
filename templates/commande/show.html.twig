{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.numeroCommande }} - Chronic Care{% endblock %}
{% block body_class %}products-page{% endblock %}

{% block body %}
{% include 'partials/_navbar.html.twig' %}

<main class="main">
  <div class="page-title">
    <div class="container">
      <h1>Commande {{ commande.numeroCommande }}</h1>
      <p>Date: {{ commande.createdAt|date('d/m/Y H:i') }} — Statut: <span class="badge bg-primary">{{ commande.statut }}</span></p>
    </div>
  </div>

  <section class="services section light-background">
    <div class="container">
      <div class="row">
        <div class="col-lg-8">
          <div class="card">
            <div class="card-header"><h5 class="mb-0">Articles</h5></div>
            <div class="card-body">
              <table class="table">
                <thead><tr><th>Produit</th><th>Qté</th><th>Prix unit.</th><th>Sous-total</th></tr></thead>
                <tbody>
                  {% for ligne in commande.ligneCommandes %}
                  <tr>
                    <td>{{ ligne.produit.nom }}</td>
                    <td>{{ ligne.quantite }}</td>
                    <td>{{ ligne.prixUnitaire }} €</td>
                    <td>{{ ligne.sousTotal }} €</td>
                  </tr>
                  {% endfor %}
                </tbody>
              </table>
            </div>
          </div>
        </div>
        <div class="col-lg-4">
          <div class="card">
            <div class="card-body">
              <h5>Total: {{ commande.total }} €</h5>
              <p class="mt-2 mb-1">
                <i class="bi {{ commande.methodePaiement in ['cash_on_delivery', 'cash'] ? 'bi-cash-coin' : 'bi-credit-card' }}"></i>
                {% if commande.methodePaiement in ['cash_on_delivery', 'cash'] %}
                  <span class="badge bg-warning text-dark">Paiement à la livraison</span>
                {% elseif commande.methodePaiement == 'stripe' %}
                  <span class="badge bg-info">Payé par Stripe</span>
                  {% if commande.stripePaymentIntentId %}
                    <br><small class="text-muted">Ref: {{ commande.stripePaymentIntentId[:20] }}...</small>
                  {% endif %}
                {% else %}
                  <span class="badge bg-success">Payé par carte</span>
                {% endif %}
              </p>
              {% if commande.adresse %}
                <p class="small text-muted mt-2"><i class="bi bi-geo-alt"></i> {{ commande.adresse }}</p>
              {% endif %}
              <a href="{{ path('commande_history') }}" class="btn btn-outline-secondary w-100 mt-3">Retour aux commandes</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

{% include 'partials/_footer.html.twig' %}
{% endblock %}
