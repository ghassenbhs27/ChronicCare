{% extends 'coach/base.html.twig' %}

{% block page_title %}{{ exercice.nom }}{% endblock %}

{% block content %}
<div class="card shadow-sm border-0 rounded-3 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="h4 mb-0">{{ exercice.nom }}</h2>
        <div>
            <a class="btn btn-outline-primary" href="{{ path('exercice_edit', { id: exercice.id }) }}">Éditer</a>
            <a class="btn btn-secondary" href="{{ path('exercice_index') }}">Retour</a>
        </div>
    </div>
    <p><strong>Description :</strong> {{ exercice.description }}</p>
    <p><strong>Durée :</strong> {{ exercice.duree }} min</p>
    <p><strong>Répétitions :</strong> {{ exercice.repetitions ?? '-' }}</p>
    <p><strong>Événement :</strong> {{ exercice.evenement?.titre ?? '-' }}</p>
</div>
{% endblock %}
