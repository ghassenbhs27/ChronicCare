{% extends 'base.html.twig' %}

{% block title %}Modifier le commentaire - Forum Chronic Care{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/comment-editor.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main forum-form-page">
    <div class="container">
      <nav aria-label="Fil d'Ariane" class="forum-breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
          <li class="breadcrumb-item"><a href="{{ path('publication_index') }}">Forum</a></li>
          <li class="breadcrumb-item"><a href="{{ path('publication_show', {id: publication.id}) }}">{{ publication.titre|slice(0, 40) }}{% if publication.titre|length > 40 %}…{% endif %}</a></li>
          <li class="breadcrumb-item active" aria-current="page">Modifier le commentaire</li>
        </ol>
      </nav>

      <div class="forum-form-card">
        <header class="forum-form-header">
          <h1 class="forum-form-title">Modifier le commentaire</h1>
          <p class="text-muted small mb-0">Publication : {{ publication.titre }}</p>
        </header>
        <div class="forum-form-body">
          <form method="post" id="commentaire_form" class="comment-editor-wrapper commentaire-edit-form">
            <input type="hidden" name="_token" value="{{ csrf_token('commentaire_edit_' ~ commentaire.id) }}">
            
            <!-- Comment Content -->
            <div class="mb-3">
              <label for="contenu" class="form-label">Votre commentaire <span class="text-danger">*</span></label>
              <textarea class="form-control" id="contenu" name="contenu" rows="5" required minlength="3" maxlength="3000" placeholder="Partagez votre avis...">{{ commentaire.contenu }}</textarea>
              <small class="text-muted">Minimum 3 caractères, maximum 3000 caractères</small>
            </div>

            <!-- Toolbar for Formatting -->
            <div class="comment-toolbar">
              <div class="toolbar-group">
                <label for="fontStyle">Style de texte</label>
                <select id="fontStyle" name="fontStyle" class="form-select">
                  <option value="normal" {% if commentaire.fontStyle == 'normal' %}selected{% endif %}>Normal</option>
                  <option value="bold" {% if commentaire.fontStyle == 'bold' %}selected{% endif %}>Gras</option>
                  <option value="italic" {% if commentaire.fontStyle == 'italic' %}selected{% endif %}>Italique</option>
                  <option value="underline" {% if commentaire.fontStyle == 'underline' %}selected{% endif %}>Souligné</option>
                  <option value="strikethrough" {% if commentaire.fontStyle == 'strikethrough' %}selected{% endif %}>Barré</option>
                </select>
              </div>

              <div class="toolbar-group">
                <label for="fontSize">Taille de police</label>
                <select id="fontSize" name="fontSize" class="form-select">
                  <option value="small" {% if commentaire.fontSize == 'small' %}selected{% endif %}>Petit</option>
                  <option value="medium" {% if commentaire.fontSize == 'medium' %}selected{% endif %}>Moyen</option>
                  <option value="large" {% if commentaire.fontSize == 'large' %}selected{% endif %}>Grand</option>
                </select>
              </div>

              <div class="toolbar-group">
                <label for="textColor">Couleur du texte</label>
                <input type="color" id="textColor" name="textColor" value="{{ commentaire.textColor ?? '#000000' }}" class="form-control">
              </div>
            </div>

            <!-- Emoji Picker -->
            <div class="toolbar-group mb-3">
              <button type="button" class="emoji-picker-button" data-emoji-toggle>
                <i class="bi bi-emoji-smile me-2"></i> Emojis
              </button>
            </div>
            <div class="emoji-picker-container" id="emoji-picker-container">
              <div class="emoji-grid" id="emoji-grid"></div>
            </div>

            <!-- Aperçu -->
            <div class="comment-preview-wrapper">
              <label class="comment-preview-label">Aperçu :</label>
              <div id="commentaire-preview" class="comment-preview"></div>
            </div>

            <!-- Form Actions -->
            <div class="forum-form-actions mt-4">
              <a href="{{ path('publication_show', {id: publication.id}) }}#comments" class="btn btn-outline-secondary">
                <i class="bi bi-x-lg me-1"></i> Annuler
              </a>
              <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i> Enregistrer les modifications
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/emoji-picker-element@latest"></script>
  <script src="{{ asset('assets/js/comment-editor.js') }}"></script>
{% endblock %}
