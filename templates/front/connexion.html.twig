<style>
    .header-spacer {
      height: 80px;
    }

    @media (max-width: 768px) {
      .header-spacer {
        height: 110px;
      }
    }

    .auth-section {
      position: relative;
      overflow: hidden;
    }

    .auth-section::before,
    .auth-section::after {
      content: "";
      position: absolute;
      border-radius: 999px;
      z-index: 0;
    }

    .auth-section::before {
      width: 320px;
      height: 320px;
      top: -140px;
      right: -140px;
      background: color-mix(in srgb, var(--accent-color), transparent 85%);
    }

    .auth-section::after {
      width: 240px;
      height: 240px;
      bottom: -120px;
      left: -110px;
      background: color-mix(in srgb, var(--heading-color), transparent 90%);
    }

    .auth-card {
      position: relative;
      z-index: 1;
      background: var(--surface-color);
      border-radius: 20px;
      padding: 2.5rem;
      border: 1px solid color-mix(in srgb, var(--default-color), transparent 85%);
      box-shadow: 0 20px 40px rgba(16, 24, 40, 0.08);
    }

    .auth-icon {
      width: 64px;
      height: 64px;
      border-radius: 16px;
      background: color-mix(in srgb, var(--accent-color), transparent 85%);
      color: var(--accent-color);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin: 0 auto 1rem;
    }

    .auth-header h2 {
      margin-bottom: 0.35rem;
    }

    .auth-header p {
      margin-bottom: 0;
      color: color-mix(in srgb, var(--default-color), transparent 35%);
    }

    .auth-form .form-label {
      font-weight: 600;
      color: var(--heading-color);
    }

    .auth-form .form-control {
      border-radius: 12px;
      border: 1px solid color-mix(in srgb, var(--default-color), transparent 80%);
      padding: 0.75rem 1rem;
    }

    .auth-form .form-control:focus {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 0.2rem color-mix(in srgb, var(--accent-color), transparent 85%);
    }

    .auth-card .btn-getstarted,
    .auth-card .btn-getstarted:focus {
      color: var(--contrast-color);
      background: var(--accent-color);
      font-size: 15px;
      padding: 12px 20px;
      border-radius: 50px;
      border: none;
      transition: 0.3s;
      display: inline-block;
      text-align: center;
    }

    .auth-card .btn-getstarted:hover,
    .auth-card .btn-getstarted:focus:hover {
      color: var(--contrast-color);
      background: color-mix(in srgb, var(--accent-color), transparent 15%);
    }

    .auth-divider {
      position: relative;
      text-align: center;
      margin: 1.5rem 0 1rem;
    }

    .auth-divider::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 1px;
      background: color-mix(in srgb, var(--default-color), transparent 85%);
    }

    .auth-divider span {
      position: relative;
      background: var(--surface-color);
      padding: 0 0.75rem;
      font-size: 0.85rem;
      color: color-mix(in srgb, var(--default-color), transparent 40%);
    }

    .auth-trust {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1rem;
      font-size: 0.9rem;
      color: color-mix(in srgb, var(--default-color), transparent 25%);
    }

    .auth-trust i {
      color: var(--accent-color);
      margin-right: 0.4rem;
    }

    .auth-link {
      color: var(--accent-color);
      font-weight: 600;
    }

    @media (max-width: 576px) {
      .auth-card {
        padding: 2rem;
      }

      .auth-trust {
        grid-template-columns: 1fr;
      }
    }
  </style>

