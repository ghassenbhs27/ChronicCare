{% extends 'base.html.twig' %}

{% block title %}Se connecter - Chronic Care{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block stylesheets %}
{{ parent() }}
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta name="description" content="Accédez à votre espace Chronic Care pour suivre vos données de santé et votre accompagnement au quotidien.">
<meta name="keywords" content="connexion, espace patient, chronic care, suivi santé">

<!-- Favicons -->
<link href="{{ asset('assets/img/favicon.png') }}" rel="icon">
<link href="{{ asset('assets/img/apple-touch-icon.png') }}" rel="apple-touch-icon">

<!-- Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect">
<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">

<style>
    .header-spacer {
      height: 80px;
    }

    @media (max-width: 768px) {
      .header-spacer {
        height: 110px;
      }
    }

    .auth-section {
      position: relative;
      overflow: hidden;
    }

    .auth-section::before,
    .auth-section::after {
      content: "";
      position: absolute;
      border-radius: 999px;
      z-index: 0;
    }

    .auth-section::before {
      width: 320px;
      height: 320px;
      top: -140px;
      right: -140px;
      background: rgba(13, 110, 253, 0.15);
    }

    .auth-section::after {
      width: 240px;
      height: 240px;
      bottom: -120px;
      left: -110px;
      background: rgba(26, 32, 44, 0.1);
    }

    .auth-card {
      position: relative;
      z-index: 1;
      background: #ffffff;
      border-radius: 20px;
      padding: 2.5rem;
      border: 1px solid rgba(100, 116, 139, 0.1);
      box-shadow: 0 20px 40px rgba(16, 24, 40, 0.08);
    }

    .auth-icon {
      width: 64px;
      height: 64px;
      border-radius: 16px;
      background: rgba(13, 110, 253, 0.15);
      color: #0d6efd;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 1.6rem;
      margin: 0 auto 1rem;
    }

    .auth-header h2 {
      margin-bottom: 0.35rem;
    }

    .auth-header p {
      margin-bottom: 0;
      color: #64748b;
    }

    .auth-form .form-label {
      font-weight: 600;
      color: #1a202c;
    }

    .auth-form .form-control {
      border-radius: 12px;
      border: 1px solid rgba(100, 116, 139, 0.2);
      padding: 0.75rem 1rem;
    }

    .auth-form .form-control:focus {
      border-color: #0d6efd;
      box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
    }

    .auth-card .btn-getstarted,
    .auth-card .btn-getstarted:focus {
      color: #ffffff;
      background: #0d6efd;
      font-size: 15px;
      padding: 12px 20px;
      border-radius: 50px;
      border: none;
      transition: 0.3s;
      display: inline-block;
      text-align: center;
    }

    .auth-card .btn-getstarted:hover,
    .auth-card .btn-getstarted:focus:hover {
      color: #ffffff;
      background: #0a58ca;
    }

    .auth-divider {
      position: relative;
      text-align: center;
      margin: 1.5rem 0 1rem;
    }

    .auth-divider::before {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      top: 50%;
      height: 1px;
      background: rgba(100, 116, 139, 0.15);
    }

    .auth-divider span {
      position: relative;
      background: #ffffff;
      padding: 0 0.75rem;
      font-size: 0.85rem;
      color: #64748b;
    }

    .auth-trust {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem 1rem;
      font-size: 0.9rem;
      color: #64748b;
    }

    .auth-trust i {
      color: #0d6efd;
      margin-right: 0.4rem;
    }

    .auth-link {
      color: #0d6efd;
      font-weight: 600;
      text-decoration: none;
    }

    .auth-link:hover {
      color: #0a58ca;
      text-decoration: underline;
    }

    @media (max-width: 576px) {
      .auth-card {
        padding: 2rem;
      }

      .auth-trust {
        grid-template-columns: 1fr;
      }
    }
</style>
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">

    <section id="connexion" class="auth-section section light-background">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row justify-content-center">
          <div class="col-lg-5 col-md-8">
            <div class="auth-card" data-aos="fade-up" data-aos-delay="200">
              <div class="auth-header text-center mb-4">
                <div class="auth-icon">
                  <i class="bi bi-shield-lock"></i>
                </div>
                <h2>Se connecter</h2>
                <p>Entrez vos identifiants pour continuer votre accompagnement.</p>
              </div>

              {% for label, messages in app.flashes %}
                {% for message in messages %}
                  {% set alert_class = label == 'reset_password_error' ? 'danger' : label %}
                  <div class="alert alert-{{ alert_class }} alert-dismissible fade show" role="alert">
                    {% if alert_class == 'success' %}<i class="bi bi-check-circle-fill me-2"></i>{% elseif alert_class == 'danger' %}<i class="bi bi-exclamation-triangle-fill me-2"></i>{% else %}<i class="bi bi-info-circle-fill me-2"></i>{% endif %}
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                  </div>
                {% endfor %}
              {% endfor %}
              {% if error is defined and error %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                  <i class="bi bi-exclamation-triangle-fill me-2"></i>
                  <strong>Erreur !</strong> {{ error.messageKey|trans(error.messageData, 'security') }}
                  <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
              {% endif %}

              <form method="post" action="{{ path('app_login') }}" class="auth-form">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                
                <div class="row gy-3">
                  <div class="col-12">
                    <label for="login-email" class="form-label">
                      <i class="bi bi-envelope me-1"></i> Adresse email
                    </label>
                    <input 
                      type="email" 
                      name="_username" 
                      class="form-control" 
                      id="login-email" 
                      placeholder="nom@exemple.com" 
                      value="{{ last_email is defined ? last_email : '' }}"
                      required
                      autofocus
                    >
                  </div>

                  <div class="col-12">
                    <label for="login-password" class="form-label">
                      <i class="bi bi-lock me-1"></i> Mot de passe
                    </label>
                    <input 
                      type="password" 
                      name="_password" 
                      class="form-control" 
                      id="login-password" 
                      placeholder="Votre mot de passe" 
                      required
                    >
                  </div>

                  <div class="col-12 d-flex justify-content-between align-items-center">
                    <div class="form-check">
                      <input 
                        class="form-check-input" 
                        type="checkbox" 
                        value="1" 
                        id="remember-me" 
                        name="_remember_me"
                      >
                      <label class="form-check-label" for="remember-me">
                        Se souvenir de moi
                      </label>
                    </div>
                    <a href="{{ path('app_forgot_password_request') }}" class="auth-link">
                      <i class="bi bi-question-circle me-1"></i>
                      Mot de passe oublié ?
                    </a>
                  </div>

                  <div class="col-12">
                    <button type="submit" class="btn-getstarted w-100">
                      <i class="bi bi-box-arrow-in-right me-2"></i>
                      Se connecter
                    </button>
                  </div>

                  <div class="col-12 text-center" id="resend-link-wrap">
                    <a href="{{ path('app_resend_verification', last_email is defined and last_email ? { email: last_email } : []) }}" class="auth-link d-block mb-2 small" id="resend-link">
                      <i class="bi bi-envelope me-1"></i>Vous n'avez pas recu l'email de verification ?
                    </a>
                  </div>

                  <div class="col-12 text-center">
                    <span class="text-muted">Pas encore de compte ?</span>
                    <a href="{{ path('app_register') }}" class="auth-link">
                      <i class="bi bi-person-plus me-1"></i>
                      S'inscrire
                    </a>
                  </div>
                </div>
              </form>

              <div class="auth-divider"><span>Chronic Care</span></div>

              <div class="auth-trust">
                <div><i class="bi bi-shield-check"></i> Données sécurisées</div>
                <div><i class="bi bi-clock"></i> Accès rapide 24/7</div>
                <div><i class="bi bi-headset"></i> Support réactif</div>
                <div><i class="bi bi-check-circle"></i> Suivi personnalisé</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

  </main>

  <footer id="footer" class="footer position-relative light-background">

    <div class="container footer-top">
      <div class="row gy-4">
        <div class="col-lg-4 col-md-6 footer-about">
          <a href="{{ path('index') }}" class="logo d-flex align-items-center">
            <span class="sitename">Chronic Care</span>
          </a>
          <div class="footer-contact pt-3">
            <p>1, Pôle Technologique</p>
            <p>2 Rue André Ampère, Ariana 2083</p>
            <p class="mt-3"><strong>Téléphone :</strong> <span>+33 1 23 45 67 89</span></p>
            <p><strong>Email :</strong> <span>contact@chroniccare.org</span></p>
          </div>
          <div class="social-links d-flex mt-4">
            <a href=""><i class="bi bi-twitter-x"></i></a>
            <a href=""><i class="bi bi-facebook"></i></a>
            <a href=""><i class="bi bi-instagram"></i></a>
            <a href=""><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Liens utiles</h4>
          <ul>
            <li><a href="{{ path('index') }}">Accueil</a></li>
            <li><a href="{{ path('about') }}">À propos</a></li>
            <li><a href="{{ path('privacy') }}">Politique de confidentialité</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Nos fonctionnalités</h4>
          <ul>
            <li><a href="{{ path('nutritionnistes') }}">Nutritionnistes</a></li>
            <li><a href="{{ path('coachs') }}">Coachs</a></li>
            <li><a href="{{ path('boutique') }}">Boutique</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Ressources</h4>
          <ul>
            <li><a href="{{ path('forum') }}">Forum santé</a></li>
            <li><a href="{{ path('contenu-educatif') }}">Contenu éducatif</a></li>
            <li><a href="{{ path('faq') }}">FAQ patients</a></li>
          </ul>
        </div>

      </div>
    </div>

    <div class="container copyright text-center mt-4">
      <p>© <span>Copyright</span> <strong class="px-1 sitename">Chronic Care</strong> <span>Tous droits réservés</span></p>
      <div class="credits">
        Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a> | <a href="https://bootstrapmade.com/tools/">DevTools</a>
      </div>
    </div>

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>
{% endblock %}
