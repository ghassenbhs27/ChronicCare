{% extends 'base.html.twig' %}

{% block title %}État{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">
<div class="container py-5">
  <h1 class="mb-4">Detail etat</h1>
  <p><strong>Traitement en cours :</strong> {{ etat.traitementEnCours ?? '-' }}</p>
  <p><strong>Remarques cliniques :</strong> {{ etat.remarquesCliniques ?? '-' }}</p>
  <p><strong>Temperature corporelle :</strong> {{ etat.temperatureCorporelle ? etat.temperatureCorporelle ~ ' deg C' : '-' }}</p>
  <p><strong>Niveau hydratation :</strong> {{ etat.niveauHydratation ? etat.niveauHydratation ~ ' L/jour' : '-' }}</p>
  <p><strong>Date :</strong> {{ etat.dateReleve ? etat.dateReleve|date('d/m/Y') : '' }}</p>
  <a class="btn btn-primary" href="{{ path('front_etat_edit', {id: etat.id}) }}">Éditer</a>
  <a class="btn btn-outline-secondary" href="{{ path('front_etat_index') }}">Retour</a>
</div>
  </main>
{% endblock %}


