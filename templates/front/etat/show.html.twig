{% extends 'base.html.twig' %}

{% block title %}Mon suivi - Detail etat{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .header-spacer { height: 80px; }
    @media (max-width: 768px) { .header-spacer { height: 110px; } }
    .panel {
      background: var(--surface-color);
      border-radius: 18px;
      padding: 1.5rem;
      border: 1px solid color-mix(in srgb, var(--default-color), transparent 86%);
      box-shadow: 0 16px 30px rgba(16, 24, 40, 0.08);
    }
  </style>
{% endblock %}

{% block body %}
<header id="header" class="header d-flex align-items-center fixed-top">
  <div class="header-container container-fluid container-xl position-relative d-flex align-items-center justify-content-between">
    <a href="{{ path('index') }}" class="logo d-flex align-items-center me-auto me-xl-0"><h1 class="sitename">Chronic Care</h1></a>
    <nav id="navmenu" class="navmenu">
      <ul>
        <li><a href="{{ path('index') }}">Accueil</a></li>
        <li><a href="{{ path('suivi_front_dashboard') }}" class="active">Mon suivi</a></li>
      </ul>
      <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
    </nav>
    <a class="btn-getstarted" href="{{ path('front_etat_index') }}">Liste etats</a>
  </div>
</header>

<div class="header-spacer"></div>

<main class="main">
  <section class="section light-background">
    <div class="container">
      <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 mb-0">Detail etat</h2>
          <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary" href="{{ path('front_etat_index') }}">Retour</a>
            <a class="btn btn-primary" href="{{ path('front_etat_edit', {id: etat.id}) }}">Modifier</a>
          </div>
        </div>
        <table class="table table-striped align-middle mb-0">
          <tbody>
            <tr><th>ID</th><td>{{ etat.id }}</td></tr>
            <tr><th>Type</th><td>{{ etat.type }}</td></tr>
            <tr><th>Valeur</th><td>{{ etat.valeur }}</td></tr>
            <tr><th>Unite</th><td>{{ etat.unite }}</td></tr>
            <tr><th>Date releve</th><td>{{ etat.dateReleve ? etat.dateReleve|date('Y-m-d') : '' }}</td></tr>
            <tr><th>Utilisateur</th><td>{{ etat.utilisateur ? etat.utilisateur.id : '-' }}</td></tr>
          </tbody>
        </table>
        <form method="post" action="{{ path('front_etat_delete', {id: etat.id}) }}" onsubmit="return confirm('Supprimer cet etat ?');" class="mt-3">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etat.id) }}">
          <button class="btn btn-outline-danger">Delete</button>
        </form>
      </div>
    </div>
  </section>
</main>
{% endblock %}
