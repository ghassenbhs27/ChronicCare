{% extends 'base.html.twig' %}

{% block title %}Mon suivi - Etats{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .header-spacer { height: 80px; }
    @media (max-width: 768px) { .header-spacer { height: 110px; } }
    .panel {
      background: var(--surface-color);
      border-radius: 18px;
      padding: 1.5rem;
      border: 1px solid color-mix(in srgb, var(--default-color), transparent 86%);
      box-shadow: 0 16px 30px rgba(16, 24, 40, 0.08);
    }
  </style>
{% endblock %}

{% block body %}
<header id="header" class="header d-flex align-items-center fixed-top">
  <div class="header-container container-fluid container-xl position-relative d-flex align-items-center justify-content-between">
    <a href="{{ path('index') }}" class="logo d-flex align-items-center me-auto me-xl-0"><h1 class="sitename">Chronic Care</h1></a>
    <nav id="navmenu" class="navmenu">
      <ul>
        <li><a href="{{ path('index') }}">Accueil</a></li>
        <li><a href="{{ path('suivi_front_dashboard') }}" class="active">Mon suivi</a></li>
      </ul>
      <i class="mobile-nav-toggle d-xl-none bi bi-list"></i>
    </nav>
    <a class="btn-getstarted" href="{{ path('front_activite_index') }}">Voir activites</a>
  </div>
</header>

<div class="header-spacer"></div>

<main class="main">
  <section class="section light-background">
    <div class="container">
      <div class="panel">
        <div class="d-flex justify-content-between align-items-center mb-3">
          <h2 class="h4 mb-0">Mes etats de sante</h2>
          <div class="d-flex gap-2">
            <a class="btn btn-primary" href="{{ path('front_etat_new') }}">Nouveau releve</a>
            <a class="btn btn-outline-secondary" href="{{ path('suivi_front_dashboard') }}">Tableau de bord</a>
          </div>
        </div>
        {% for message in app.flashes('danger') %}
          <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}
        {% for message in app.flashes('success') %}
          <div class="alert alert-success">{{ message }}</div>
        {% endfor %}
        <form method="get" class="row g-2 mb-3">
          <div class="col-md-4">
            <input type="text" name="q" value="{{ q ?? '' }}" class="form-control" placeholder="Rechercher (type, unite)...">
          </div>
          <div class="col-md-3">
            {% set s = sort ?? 'dateReleve' %}
            <select name="sort" class="form-select">
              <option value="dateReleve" {{ s == 'dateReleve' ? 'selected' : '' }}>Date releve</option>
              <option value="type" {{ s == 'type' ? 'selected' : '' }}>Type</option>
              <option value="valeur" {{ s == 'valeur' ? 'selected' : '' }}>Valeur</option>
              <option value="unite" {{ s == 'unite' ? 'selected' : '' }}>Unite</option>
              <option value="id" {{ s == 'id' ? 'selected' : '' }}>ID</option>
            </select>
          </div>
          <div class="col-md-2">
            {% set d = dir ?? 'DESC' %}
            <select name="dir" class="form-select">
              <option value="DESC" {{ d == 'DESC' ? 'selected' : '' }}>DESC</option>
              <option value="ASC" {{ d == 'ASC' ? 'selected' : '' }}>ASC</option>
            </select>
          </div>
          <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-primary" type="submit">Filtrer</button>
            <a class="btn btn-outline-secondary" href="{{ path('front_etat_index') }}">Reset</a>
          </div>
          <div class="col-12 d-flex gap-2">
            <a class="btn btn-outline-success" href="{{ path('front_etat_export_excel', { q: q ?? '', sort: s, dir: d }) }}">Export Excel</a>
            <a class="btn btn-outline-dark" href="{{ path('front_etat_export_pdf', { q: q ?? '', sort: s, dir: d }) }}">Export PDF</a>
          </div>
        </form>
        <div class="table-responsive">
          <table class="table table-striped align-middle mb-0">
            <thead>
              <tr>
                <th>ID</th>
                <th>Type</th>
                <th>Valeur</th>
                <th>Unite</th>
                <th>Date releve</th>
                <th class="text-end">Action</th>
              </tr>
            </thead>
            <tbody>
              {% for etat in etats %}
                <tr>
                  <td>{{ etat.id }}</td>
                  <td>{{ etat.type }}</td>
                  <td>{{ etat.valeur }}</td>
                  <td>{{ etat.unite }}</td>
                  <td>{{ etat.dateReleve ? etat.dateReleve|date('Y-m-d') : '' }}</td>
                  <td class="text-end">
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('front_etat_show', {id: etat.id}) }}">Voir</a>
                    <a class="btn btn-sm btn-outline-primary" href="{{ path('front_etat_edit', {id: etat.id}) }}">Edit</a>
                    <form method="post" action="{{ path('front_etat_delete', {id: etat.id}) }}" style="display:inline-block" onsubmit="return confirm('Supprimer cet etat ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etat.id) }}">
                      <button class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                  </td>
                </tr>
              {% else %}
                <tr><td colspan="6">Aucun etat.</td></tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
