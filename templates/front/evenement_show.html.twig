{% extends 'base.html.twig' %}

{% block title %}{{ evenement.titre }} - Evenements{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5 evenement-show-page">
    <div class="container py-3">
      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show shadow-sm mb-4" role="alert">
            <i class="bi bi-{{ label == 'success' ? 'check-circle-fill' : (label == 'warning' ? 'exclamation-triangle-fill' : 'exclamation-circle-fill') }} me-2"></i>
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
          </div>
        {% endfor %}
      {% endfor %}

      <div class="row g-4 g-lg-5 align-items-stretch">
        <div class="col-lg-7">
          <div class="card border-0 shadow-sm h-100 overflow-hidden evenement-detail-card">
            <div class="card-body p-4 p-md-5">
              <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                {% if evenement.isValide %}
                  <span class="badge rounded-pill bg-success px-3 py-2">
                    <i class="bi bi-patch-check-fill me-1"></i> Confirme par l'administration
                  </span>
                {% else %}
                  <span class="badge rounded-pill bg-secondary px-3 py-2">
                    <i class="bi bi-hourglass-split me-1"></i> En attente de validation admin
                  </span>
                {% endif %}
                {% if holiday_debut %}
                  <span class="badge rounded-pill bg-warning text-dark px-3 py-2">
                    <i class="bi bi-calendar-event me-1"></i> {{ holiday_debut }}
                  </span>
                {% endif %}
              </div>
              <h1 class="display-6 fw-bold text-dark mb-4">{{ evenement.titre }}</h1>

              <div class="d-flex flex-column gap-3 mb-4">
                <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">
                  <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-2">
                    <i class="bi bi-calendar3 fs-5"></i>
                  </div>
                  <div>
                    <span class="small text-muted text-uppercase fw-semibold">Date et horaire</span>
                    <p class="mb-0 fw-semibold">{{ evenement.dateDebut|date('d/m/Y') }} · {{ evenement.dateDebut|date('H:i') }} – {{ evenement.dateFin|date('H:i') }}</p>
                  </div>
                </div>
                <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">
                  <div class="rounded-3 bg-danger bg-opacity-10 text-danger p-2">
                    <i class="bi bi-geo-alt-fill fs-5"></i>
                  </div>
                  <div>
                    <span class="small text-muted text-uppercase fw-semibold">Lieu</span>
                    <p class="mb-0 fw-semibold">
                      {{ evenement.lieu }}
                      {% if weather and weather.location %}
                        <span class="text-muted fw-normal">({{ weather.location }})</span>
                      {% endif %}
                    </p>
                    {% if map_location %}
                      <a
                        href="{{ map_location.map_url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-sm mt-2"
                        style="border:1px solid var(--accent-color); color: var(--accent-color); background: transparent;"
                      >
                        <i class="bi bi-map me-1"></i>Voir sur la carte
                      </a>
                    {% endif %}
                  </div>
                </div>
                <div class="d-flex align-items-center gap-3 p-3 rounded-3 bg-light">
                  <div class="rounded-3 bg-info bg-opacity-10 text-info p-2">
                    <i class="bi bi-cloud-sun fs-5"></i>
                  </div>
                  <div>
                    <span class="small text-muted text-uppercase fw-semibold">Meteo prevue</span>
                    <p class="mb-0 fw-semibold">
                      {% if weather %}
                        {{ weather.weather_label }}{% if weather.temperature_min is not null and weather.temperature_max is not null %} · {{ weather.temperature_min|round(0, 'floor') }} a {{ weather.temperature_max|round(0, 'ceil') }} degC{% endif %}{% if weather.precipitation_mm is not null %} · Pluie: {{ weather.precipitation_mm|number_format(1, '.', ' ') }} mm{% endif %}
                      {% else %}
                        Indisponible
                      {% endif %}
                    </p>
                  </div>
                </div>
              </div>

              <div class="border-top pt-4">
                <h6 class="text-uppercase text-muted fw-semibold small mb-2">Description</h6>
                <div class="text-body lh-lg">{{ evenement.description|nl2br }}</div>
              </div>
            </div>
          </div>
        </div>

        <div class="col-lg-5">
          <div class="card border-0 shadow evenement-inscription-card h-100">
            <div class="card-header border-0 py-4 px-4 text-white rounded-top-3 evenement-inscription-header">
              <h5 class="card-title mb-0 d-flex align-items-center gap-2">
                <i class="bi bi-person-plus-fill fs-4"></i>
                S'inscrire a cet evenement
              </h5>
            </div>
            <div class="card-body p-4">
              {% if ticket_url %}
                <div class="alert alert-success d-flex align-items-center gap-3 mb-3">
                  <i class="bi bi-check-circle-fill fs-2"></i>
                  <div>
                    <strong>Inscription confirmee.</strong> Voici votre ticket QR code.
                  </div>
                </div>
                <div class="text-center border rounded-3 p-3 mb-3">
                  <img
                    src="{{ qr_code_data_uri(ticket_url, 'default', { size: 260, margin: 8 }) }}"
                    alt="QR code ticket evenement"
                    class="img-fluid"
                  >
                  <div class="small text-muted mt-2">Conservez ce QR code pour l'entree.</div>
                </div>
                <div class="d-grid gap-2">
                  <a href="{{ ticket_url }}" class="btn btn-primary" style="background-color: var(--accent-color); border-color: var(--accent-color);">Ouvrir mon ticket</a>
                </div>
              {% elseif already_inscrit|default(false) %}
                <div class="alert alert-success mb-0 d-flex align-items-center gap-3">
                  <i class="bi bi-check-circle-fill fs-2"></i>
                  <div>
                    <strong>Vous etes deja inscrit</strong> a cet evenement. Nous vous attendons !
                  </div>
                </div>
              {% else %}
                <p class="text-muted small mb-4">
                  Renseignez vos coordonnees pour confirmer votre participation. Si vous etes connecte, certains champs sont pre-remplis.
                </p>
                {{ form_start(form, { attr: { class: 'evenement-inscription-form', novalidate: 'novalidate' } }) }}
                  {% for child in form %}
                    {% if child.vars.name != '_token' %}
                      <div class="mb-3">
                        {{ form_label(child) }}
                        {{ form_widget(child, { attr: { class: 'form-control form-control-lg' } }) }}
                        {{ form_errors(child) }}
                      </div>
                    {% endif %}
                  {% endfor %}
                  {{ form_rest(form) }}
                  <button class="btn btn-primary btn-lg w-100 py-3 mt-2 d-flex align-items-center justify-content-center gap-2 evenement-submit-btn" type="submit">
                    <i class="bi bi-send-fill"></i>
                    <span class="btn-text">Envoyer mon inscription</span>
                  </button>
                {{ form_end(form) }}
              {% endif %}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <style>
    .evenement-show-page .evenement-detail-card { border-radius: 1rem; }
    .evenement-show-page .evenement-inscription-card { border-radius: 1rem; }
    .evenement-show-page .evenement-inscription-header { background: var(--accent-color); }
    .evenement-show-page .evenement-inscription-card .card-header { border-radius: 1rem 1rem 0 0 !important; }
    .evenement-show-page .form-control:focus { border-color: var(--bs-primary); box-shadow: 0 0 0 0.25rem rgba(var(--bs-primary-rgb), 0.15); }
    .evenement-show-page .evenement-submit-btn:disabled { cursor: not-allowed; }
  </style>
  <script>
    document.querySelectorAll('.evenement-inscription-form').forEach(function(form) {
      form.addEventListener('submit', function() {
        var btn = form.querySelector('.evenement-submit-btn');
        if (btn && !btn.disabled) {
          btn.disabled = true;
          var textEl = btn.querySelector('.btn-text');
          if (textEl) textEl.textContent = 'Envoi en cours...';
          var icon = btn.querySelector('i.bi');
          if (icon) { icon.classList.remove('bi-send-fill'); icon.classList.add('bi-hourglass-split'); }
        }
      });
    });
  </script>
{% endblock %}
