{% extends 'base.html.twig' %}

{% block title %}Boutique - Chronic Care{% endblock %}

{% block body_class %}products-page{% endblock %}

{% block stylesheets %}
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta name="description" content="Découvrez les produits de la boutique Chronic Care : suppléments nutrition, équipements de monitoring et produits pour le bien-être.">
    <meta name="keywords" content="boutique, produits santé, suppléments, monitoring, maladies chroniques">

    <!-- Favicons -->
    <link href="{{ asset('assets/img/favicon.png') }}" rel="icon">
    <link href="{{ asset('assets/img/apple-touch-icon.png') }}" rel="apple-touch-icon">

    <!-- Fonts -->
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
<style>
      /* Harmonisation des cartes produits pour coller au style de la page */
      .service-item {
        display:flex;
        gap:1rem;
        align-items:flex-start;
        padding:16px;
        border-radius:12px;
        background:#ffffff;
        border:1px solid rgba(22,28,37,0.04);
        box-shadow:0 1px 2px rgba(16,24,40,0.02);
        transition:transform .12s ease, box-shadow .12s ease;
      }
      .service-item:hover{ transform:translateY(-4px); box-shadow:0 8px 24px rgba(16,24,40,0.06);} 

      .service-image{
        flex:0 0 72px;
        width:72px;
        height:72px;
        border-radius:50%;
        overflow:hidden;
        display:flex;
        align-items:center;
        justify-content:center;
        background:#f6f8fb;
        border:1px solid rgba(16,24,40,0.04);
        cursor: pointer;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        text-decoration: none;
      }
      .service-image:hover {
        transform: scale(1.08);
        box-shadow: 0 8px 16px rgba(11, 207, 153, 0.2);
      }
      .service-image img{ width:100%; height:100%; object-fit:cover; display:block; }

      .service-item .service-details{ flex:1; }
      .service-details h5{ margin:0 0 6px 0; font-weight:700; }
      .service-benefits li{ margin-bottom:6px; color:#6b7280; }

      .boutique-tabs .nav-link,
      .boutique-tabs .nav-link i {
        color: var(--accent-color);
      }

      .boutique-tabs .nav-link.active,
      .boutique-tabs .nav-link.active i {
        color: var(--accent-color);
        border-color: var(--accent-color);
      }

      .boutique-cta {
        background: var(--accent-color);
        border-color: var(--accent-color);
        color: #fff;
      }

      .boutique-cta:hover,
      .boutique-cta:focus {
        background: color-mix(in srgb, var(--accent-color), transparent 15%);
        border-color: color-mix(in srgb, var(--accent-color), transparent 15%);
        color: #fff;
      }

      @media (max-width:768px){
        .service-item{ padding:12px; }
        .service-image{ flex:0 0 56px; width:56px; height:56px; }
      }
    </style>

    <!-- =======================================================
    * Template Name: MediTrust
    * Template URL: https://bootstrapmade.com/meditrust-bootstrap-hospital-website-template/
    * Updated: Jul 04 2025 with Bootstrap v5.3.7
    * Author: BootstrapMade.com
    * License: https://bootstrapmade.com/license/
    ======================================================== -->
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

    <main class="main">

      <!-- Page Title -->
      <div class="page-title">
        <div class="breadcrumbs">
          <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
              <li class="breadcrumb-item"><a href="{{ path('index') }}"><i class="bi bi-house"></i> Accueil</a></li>
              <li class="breadcrumb-item active current">Boutique</li>
            </ol>
          </nav>
        </div>
        <div class="container">
          <h1>Notre boutique</h1>
          <p>Découvrez notre sélection de produits pour la santé et le bien-être : suppléments nutritionnels, équipements de monitoring, et bien plus encore.</p>
          <a href="{{ path('produit_list') }}" class="btn boutique-cta mt-2"><i class="bi bi-grid-3x3-gap"></i> Voir tout le catalogue</a>
          <a href="{{ path('cart_show') }}" class="btn boutique-cta mt-2 ms-2"><i class="bi bi-cart"></i> Panier</a>
          <!-- Barre de recherche et tri -->
          <form method="get" action="{{ path('boutique') }}" class="row mb-4 mt-3 align-items-end">
            <div class="col-md-4 mb-2">
              <input type="text" name="keyword" class="form-control" placeholder="Rechercher par nom..." value="{{ keyword|default('') }}">
            </div>
            <div class="col-md-3 mb-2">
              <input type="number" name="priceMin" class="form-control" placeholder="Prix min" min="0" value="{{ priceMin|default('') }}">
            </div>
            <div class="col-md-3 mb-2">
              <input type="number" name="priceMax" class="form-control" placeholder="Prix max" min="0" value="{{ priceMax|default('') }}">
            </div>
            <div class="col-md-2 mb-2">
              <button type="submit" class="btn btn-primary w-100">Filtrer</button>
            </div>
          </form>
        </div>
      </div><!-- End Page Title -->

      <!-- Catalogue dynamique produits -->
      <section id="products" class="services section light-background">
        <div class="container">
          <h2 class="mb-4">Nos produits</h2>
          {% if produits is defined and produits|length > 0 %}
            <div class="row g-4">
              {% for produit in produits|slice(0, 8) %}
              <div class="col-lg-6">
                <div class="service-item {{ loop.first ? 'featured' : '' }}">
                  <a href="{{ path('produit_show', {id: produit.id}) }}" class="service-image" title="Voir {{ produit.nom }}">
                    {% set categoryLower = produit.categorie|lower %}
                    {% if 'supplément' in categoryLower %}
                      {% set iconClass = 'bi-capsule' %}
                    {% elseif 'équipement' in categoryLower or 'monitoring' in categoryLower %}
                      {% set iconClass = 'bi-heart-pulse' %}
                    {% elseif 'bien-être' in categoryLower or 'yoga' in categoryLower %}
                      {% set iconClass = 'bi-flower1' %}
                    {% else %}
                      {% set iconClass = 'bi-box-seam' %}
                    {% endif %}
                    <img id="img-{{ produit.id }}" src="{{ asset('assets/img/products/' ~ produit.nom|lower|replace({' ': '-', 'é': 'e', 'è': 'e', 'ê': 'e', 'à': 'a'}) ~ '.jpg') }}" alt="{{ produit.nom }}" style="display:none;">
                    <i id="icon-{{ produit.id }}" class="bi {{ iconClass }}" style="font-size:40px; color:#0bcf99;"></i>
                    <script>
                      document.getElementById('img-{{ produit.id }}').onload = function() {
                        this.style.display = 'block';
                        document.getElementById('icon-{{ produit.id }}').style.display = 'none';
                      };
                    </script>
                  </a>
                  <div class="service-details">
                    <h5>{{ produit.nom }}</h5>
                    <p>{{ produit.description|slice(0, 120) }}{% if produit.description|length > 120 %}...{% endif %}</p>
                    <ul class="service-benefits"><li><i class="fa fa-check-circle"></i>{{ produit.categorie }}</li><li><i class="fa fa-check-circle"></i>{{ produit.prix }} €</li></ul>
                    <a href="{{ path('produit_show', {id: produit.id}) }}" class="service-link"><span>Voir le produit</span><i class="fa fa-arrow-right"></i></a>
                    {% if produit.stock > 0 %}
                      <a href="{{ path('cart_add_with_id', {id: produit.id}) }}?quantity=1" class="btn btn-success btn-sm ms-2"><i class="bi bi-cart-plus"></i> Panier</a>
                    {% endif %}
                  </div>
                </div>
              </div>
              {% endfor %}
            </div>
            <div class="text-center mt-4">
              <a href="{{ path('produit_list') }}" class="btn boutique-cta">Voir tous les produits</a>
            </div>
          {% else %}
            <div class="alert alert-info">Aucun produit disponible. <a href="{{ path('produit_list') }}">Catalogue</a></div>
          {% endif %}
        </div>
      </section>


    </main>

    <footer id="footer" class="footer position-relative light-background">

    <div class="container footer-top">
      <div class="row gy-4">
        <div class="col-lg-4 col-md-6 footer-about">
          <a href="{{ path('index') }}" class="logo d-flex align-items-center">
            <span class="sitename">Chronic Care</span>
          </a>
          <div class="footer-contact pt-3">
            <p>1, Pôle Technologique</p>
            <p>2 Rue André Ampère، Ariana 2083</p>
            <p class="mt-3"><strong>Téléphone :</strong> <span>+33 1 23 45 67 89</span></p>
            <p><strong>Email :</strong> <span>contact@chroniccare.org</span></p>
          </div>
          <div class="social-links d-flex mt-4">
            <a href=""><i class="bi bi-twitter-x"></i></a>
            <a href=""><i class="bi bi-facebook"></i></a>
            <a href=""><i class="bi bi-instagram"></i></a>
            <a href=""><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Liens utiles</h4>
          <ul>
            <li><a href="{{ path('index') }}">Accueil</a></li>
            <li><a href="{{ path('about') }}">À propos</a></li>
            <li><a href="{{ path('privacy') }}">Politique de confidentialité</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Nos fonctionnalités</h4>
          <ul>
            <li><a href="{{ path('nutritionnistes') }}">Nutritionnistes</a></li>
            <li><a href="{{ path('coachs') }}">Coachs</a></li>
            <li><a href="{{ path('boutique') }}">Boutique</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Ressources</h4>
          <ul>
            <li><a href="{{ path('forum') }}">Forum santé</a></li>
            <li><a href="{{ path('contenu-educatif') }}">Contenu éducatif</a></li>
            <li><a href="{{ path('faq') }}">FAQ patients</a></li>
          </ul>
        </div>

      </div>
    </div>

    <div class="container copyright text-center mt-4">
    <p>© <span>Copyright</span> <strong class="px-1 sitename">Chronic Care</strong> <span>Tous droits réservés</span></p>
      <div class="credits">
        <!-- All the links in the footer should remain intact. -->
        <!-- You can delete the links only if you've purchased the pro version. -->
