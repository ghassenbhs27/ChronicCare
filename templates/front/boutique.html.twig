                <div class="tab-pane fade active show" id="services-primary" role="tabpanel">
                  <div class="row g-4">
                    {% set primeProducts = produits|filter(p => p.categorie == 'Suppléments nutritionnels') %}
                    {% for produit in primeProducts %}
                      <div class="col-lg-6">
                        <div class="service-item {% if loop.first %}featured{% endif %}">
                          <div class="service-image">
                            <img src="{{ asset('assets/img/products/' ~ produit.nom|lower|replace({' ': '-', 'é': 'e', 'è': 'e', 'ê': 'e', 'à': 'a'}) ~ '.jpg') }}" alt="{{ produit.nom }}" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 200px; display: flex; align-items: center; justify-content: center; color: white; font-weight: bold;" onerror="this.style.background='linear-gradient(135deg, #667eea 0%, #764ba2 100%)'; this.style.color='white'; this.style.display='flex'; this.style.alignItems='center'; this.style.justifyContent='center'; this.textContent='{{ produit.nom }}';">
                          </div>
                          <div class="service-icon-wrapper d-none">
                            <i class="fa fa-leaf"></i>
                          </div>
                          <div class="service-details">
                            <h5>{{ produit.nom }}</h5>
                            <p>{{ produit.description }}</p>
                            <div class="service-price mb-3">
                              <strong style="font-size: 1.3em; color: #0d6efd;">{{ produit.prix }}€</strong>
                              {% if produit.stock <= 0 %}
                                <span class="badge bg-danger ms-2">Rupture de stock</span>
                              {% elseif produit.stock < 5 %}
                                <span class="badge bg-warning ms-2">Stock limité: {{ produit.stock }}</span>
                              {% endif %}
                            </div>
                            <ul class="service-benefits">
                              <li><i class="fa fa-check-circle"></i>Produit de qualité</li>
                              <li><i class="fa fa-check-circle"></i>Disponible</li>
                              <li><i class="fa fa-check-circle"></i>Livraison rapide</li>
                            </ul>
                            <div class="service-actions" style="display: flex; gap: 10px;">
                              <a href="{{ path('produit_show', {'id': produit.id}) }}" class="service-link">
                                <span>Voir détail</span>
                                <i class="fa fa-arrow-right"></i>
                              </a>
                              {% if produit.stock > 0 %}
                                <button onclick="ajouterAuPanier({{ produit.id }}, '{{ produit.nom }}')" class="btn btn-sm btn-success" style="padding: 0.5rem 1rem; font-size: 0.9em;">
                                  <i class="fa fa-shopping-cart"></i> Panier
                                </button>
                              {% endif %}
                            </div>
                          </div>
                        </div>
