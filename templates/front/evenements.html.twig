{% extends 'base.html.twig' %}

{% block title %}Evenements - Chronic Care{% endblock %}

{% block body_class %}events-page{% endblock %}

{% block stylesheets %}
  <style>
    .events-section {
      position: relative;
      overflow: hidden;
      padding: 2.8rem 0 3.2rem;
      background: #f7fbfd;
    }

    .events-section::before,
    .events-section::after {
      content: "";
      position: absolute;
      border-radius: 999px;
      z-index: 0;
    }

    .events-section::before {
      width: 360px;
      height: 360px;
      top: -170px;
      right: -140px;
      background: rgba(13, 110, 253, 0.14);
    }

    .events-section::after {
      width: 260px;
      height: 260px;
      bottom: -120px;
      left: -120px;
      background: rgba(4, 158, 187, 0.12);
    }

    .events-shell {
      position: relative;
      z-index: 1;
    }

    .events-head {
      background: #fff;
      border: 1px solid rgba(100, 116, 139, 0.12);
      border-radius: 20px;
      box-shadow: 0 14px 34px rgba(16, 24, 40, 0.08);
      padding: 1.6rem 1.4rem;
      margin-top: 14px;
      margin-bottom: 1.1rem;
    }

    .events-chip {
      display: inline-flex;
      align-items: center;
      gap: .45rem;
      font-size: .82rem;
      font-weight: 700;
      color: var(--accent-color);
      background: color-mix(in srgb, var(--accent-color), transparent 89%);
      border: 1px solid color-mix(in srgb, var(--accent-color), transparent 72%);
      border-radius: 999px;
      padding: .45rem .75rem;
    }

    .event-card {
      border: 1px solid rgba(100, 116, 139, 0.12);
      border-radius: 18px;
      box-shadow: 0 12px 30px rgba(16, 24, 40, 0.08);
      overflow: hidden;
      background: #fff;
      height: 100%;
    }

    .event-card .card-body {
      padding: 1.2rem;
    }

    .event-title {
      font-size: 1.1rem;
      font-weight: 800;
      line-height: 1.35;
      margin-bottom: .75rem;
      color: #0f172a;
    }

    .event-meta {
      display: grid;
      gap: .55rem;
      margin-bottom: .95rem;
    }

    .event-meta-row {
      display: flex;
      align-items: center;
      gap: .55rem;
      font-size: .92rem;
      color: #475467;
    }

    .event-meta-icon {
      width: 30px;
      height: 30px;
      border-radius: 10px;
      background: color-mix(in srgb, var(--accent-color), transparent 88%);
      color: var(--accent-color);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
    }

    .event-foot {
      border-top: 1px solid #eef2f7;
      margin-top: .95rem;
      padding-top: .95rem;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: .75rem;
    }

    .event-accent-btn {
      background: var(--accent-color);
      border-color: var(--accent-color);
      color: #fff;
      border-radius: 999px;
      font-weight: 700;
      padding: .52rem .95rem;
    }

    .event-accent-btn:hover,
    .event-accent-btn:focus {
      background: color-mix(in srgb, var(--accent-color), transparent 15%);
      border-color: color-mix(in srgb, var(--accent-color), transparent 15%);
      color: #fff;
    }

    .event-empty {
      border: 1px dashed rgba(100, 116, 139, 0.3);
      border-radius: 18px;
      padding: 2.4rem 1.2rem;
      text-align: center;
      background: #fff;
      color: #667085;
    }
  </style>
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">
    <section class="events-section">
      <div class="container events-shell">
        <div class="events-head d-flex flex-wrap justify-content-between align-items-end gap-3">
          <div>
            <h1 class="mb-2">Evenements</h1>
            <p class="text-muted mb-0">
              Decouvrez les evenements proposes par nos coachs et valides par l'administration.
            </p>
          </div>
          <span class="events-chip">
            <i class="bi bi-calendar2-event"></i>
            {{ evenements|length }} evenement{{ evenements|length > 1 ? 's' : '' }}
          </span>
        </div>

        <div class="row g-4">
          {% if evenements is empty %}
            <div class="col-12">
              <div class="event-empty">
                <i class="bi bi-calendar-x fs-2 d-block mb-2"></i>
                Aucun evenement pour le moment.
              </div>
            </div>
          {% else %}
            {% for evenement in evenements %}
              <div class="col-md-6 col-xl-4">
                <article class="event-card">
                  <div class="card-body">
                    <h2 class="event-title">{{ evenement.titre }}</h2>

                    <div class="event-meta">
                      <div class="event-meta-row">
                        <span class="event-meta-icon"><i class="bi bi-calendar3"></i></span>
                        <span>{{ evenement.dateDebut|date('d/m/Y H:i') }} - {{ evenement.dateFin|date('d/m/Y H:i') }}</span>
                      </div>
                      <div class="event-meta-row">
                        <span class="event-meta-icon"><i class="bi bi-geo-alt"></i></span>
                        <span>{{ evenement.lieu }}</span>
                      </div>
                    </div>

                    <div class="event-foot">
                      {% if holiday_map[evenement.id] is defined %}
                        <span class="badge bg-warning text-dark">Jour ferie</span>
                      {% else %}
                        <span class="small text-muted">Places ouvertes</span>
                      {% endif %}
                      <a class="btn event-accent-btn" href="{{ path('front_evenement_show', { id: evenement.id }) }}">
                        Voir / S'inscrire
                      </a>
                    </div>
                  </div>
                </article>
              </div>
            {% endfor %}
          {% endif %}
        </div>
      </div>
    </section>
  </main>
{% endblock %}
