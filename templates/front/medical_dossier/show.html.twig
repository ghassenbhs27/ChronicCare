{% extends 'base.html.twig' %}

{% block title %}Mon dossier medical - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">
    <section class="section py-5">
      <div class="container">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
          <div>
            <h1 class="mb-1">Mon dossier medical</h1>
            <p class="text-muted mb-0">Consultez, enrichissez et mettez a jour vos informations medicales avec assistance IA.</p>
          </div>
          <a href="{{ path('suivi_front_dashboard') }}" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Retour suivi
          </a>
        </div>

        {% set disease_labels = {
          'diabete': 'Diabete',
          'hypertension': 'Hypertension',
          'asthme': 'Asthme',
          'insuffisance_cardiaque': 'Insuffisance cardiaque',
          'epilepsie': 'Epilepsie',
          'autre': 'Autre'
        } %}

        <div class="row g-4">
          <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-header bg-white">
                <h6 class="mb-0">Ajouter / modifier une maladie</h6>
              </div>
              <div class="card-body">
                <form method="post" action="{{ path('patient_medical_dossier_save') }}" id="medical-dossier-form">
                  <input type="hidden" name="_token" value="{{ csrf_token('patient_medical_dossier_save') }}">
                  <input type="hidden" name="medical_dossier_payload" id="medical-dossier-payload">

                  <div class="mb-3">
                    <label for="medical-condition-select" class="form-label fw-semibold">Maladie cible</label>
                    <select class="form-select" name="medical_condition" id="medical-condition-select" required>
                      <option value="">Selectionnez</option>
                      {% for code in supported_diseases %}
                        <option value="{{ code }}" {{ dossier and dossier.disease == code ? 'selected' : '' }}>
                          {{ disease_labels[code]|default(code|replace({'_':' '})|title) }}
                        </option>
                      {% endfor %}
                    </select>
                  </div>

                  <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                    <button type="button" class="btn btn-outline-primary btn-sm" id="open-medical-ai-btn">
                      <i class="bi bi-robot me-1"></i> Ouvrir assistant IA
                    </button>
                    <span class="badge bg-secondary" id="medical-dossier-status">Questionnaire non valide</span>
                  </div>

                  <button type="submit" class="btn btn-primary w-100">Enregistrer dans mon dossier</button>
                </form>

                <hr>

                {% if dossier %}
                  <div class="small text-muted mb-1">Maladies enregistrees</div>
                  <div class="d-flex flex-wrap gap-2">
                    {% for dis in dossier.knownDiseases %}
                      <span class="badge bg-info text-dark">{{ disease_labels[dis]|default(dis|replace({'_':' '})|title) }}</span>
                    {% else %}
                      <span class="text-muted">Aucune maladie enregistree.</span>
                    {% endfor %}
                  </div>
                {% else %}
                  <div class="alert alert-warning mb-0">
                    Aucun dossier trouve. Completez le questionnaire IA pour creer votre dossier.
                  </div>
                {% endif %}
              </div>
            </div>
          </div>

          <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100">
              <div class="card-header bg-white">
                <h6 class="mb-0">Etat actuel du dossier</h6>
              </div>
              <div class="card-body">
                {% if dossier %}
                  <div class="row g-3 mb-3">
                    <div class="col-md-6">
                      <div class="small text-muted">Maladie active</div>
                      <div class="fw-semibold">{{ disease_labels[dossier.disease]|default(dossier.disease|replace({'_':' '})|title) }}</div>
                    </div>
                    <div class="col-md-6">
                      <div class="small text-muted">Mode IA</div>
                      <div class="fw-semibold">{{ dossier.aiMode }}</div>
                    </div>
                    <div class="col-md-6">
                      <div class="small text-muted">Risque urgence</div>
                      <div class="fw-semibold text-uppercase">{{ dossier.emergencyRiskLevel }}</div>
                    </div>
                    <div class="col-md-6">
                      <div class="small text-muted">Crise urgente possible</div>
                      <div class="fw-semibold">{{ dossier.emergencyPossible ? 'Oui' : 'Non' }}</div>
                    </div>
                  </div>

                  <div class="small text-muted">Synthese IA</div>
                  <div class="mb-3">{{ dossier.aiSummary ?: 'N/A' }}</div>

                  <div class="small text-muted mb-1">Reponses actuelles</div>
                  <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                      <thead>
                        <tr>
                          <th style="width: 42%;">Question</th>
                          <th>Reponse</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for item in dossier.answers %}
                          <tr>
                            <td>{{ item.question|default('N/A') }}</td>
                            <td>{{ item.answer|default('N/A') }}</td>
                          </tr>
                        {% else %}
                          <tr><td colspan="2" class="text-muted">Aucune reponse.</td></tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                {% else %}
                  <div class="text-muted">Votre dossier medical sera visible ici apres la premiere sauvegarde.</div>
                {% endif %}
              </div>
            </div>
          </div>
        </div>

        {% if dossier %}
          <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white">
              <h6 class="mb-0">Historique medical (maladies et mises a jour)</h6>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Maladie</th>
                      <th>Mise a jour</th>
                      <th>Risque</th>
                      <th>Urgence</th>
                      <th>Mode IA</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for entry in dossier.diseaseHistory %}
                      {% set analysis = entry.analysis|default({}) %}
                      <tr>
                        <td>{{ disease_labels[entry.disease|default('autre')]|default((entry.disease|default('autre'))|replace({'_':' '})|title) }}</td>
                        <td>{{ entry.updated_at|default('N/A') }}</td>
                        <td class="text-uppercase">{{ analysis.risk_level|default('unknown') }}</td>
                        <td>{{ analysis.emergency_possible|default(false) ? 'Oui' : 'Non' }}</td>
                        <td>{{ analysis.mode|default('FALLBACK') }}</td>
                      </tr>
                    {% else %}
                      <tr><td colspan="5" class="text-muted text-center py-3">Aucun historique.</td></tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>

          <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white">
              <h6 class="mb-0">Audit d acces et de modification</h6>
            </div>
            <div class="card-body p-0">
              <div class="table-responsive">
                <table class="table table-hover mb-0">
                  <thead class="table-light">
                    <tr>
                      <th>Date</th>
                      <th>Acteur</th>
                      <th>Action</th>
                      <th>Maladie</th>
                      <th>Details</th>
                    </tr>
                  </thead>
                  <tbody>
                    {% for log in audit_logs %}
                      <tr>
                        <td class="small">{{ log.createdAt|date('d/m/Y H:i') }}</td>
                        <td class="small">{{ log.actorEmail ?: 'system' }}</td>
                        <td><span class="badge bg-secondary">{{ log.action|upper }}</span></td>
                        <td>{{ log.targetDisease ?: '-' }}</td>
                        <td class="small">
                          {% if log.changedFields %}
                            <details>
                              <summary>Changements</summary>
                              <pre class="small mb-0">{{ log.changedFields|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                            </details>
                          {% else %}
                            -
                          {% endif %}
                        </td>
                      </tr>
                    {% else %}
                      <tr><td colspan="5" class="text-muted text-center py-3">Aucun log d audit pour le moment.</td></tr>
                    {% endfor %}
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        {% endif %}
      </div>
    </section>
  </main>

  <div class="modal fade" id="medicalAiModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-robot me-2"></i>Assistant IA dossier medical</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <div class="alert alert-info py-2" id="medical-ai-intro">Selectionnez une maladie puis lancez l assistant IA.</div>
          <form id="medical-ai-form" class="row gy-3"></form>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
          <button type="button" class="btn btn-primary" id="save-medical-ai-btn">Valider questionnaire</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const diseaseSelect = document.getElementById('medical-condition-select');
      const payloadInput = document.getElementById('medical-dossier-payload');
      const statusBadge = document.getElementById('medical-dossier-status');
      const openBtn = document.getElementById('open-medical-ai-btn');
      const saveBtn = document.getElementById('save-medical-ai-btn');
      const formContainer = document.getElementById('medical-ai-form');
      const introBox = document.getElementById('medical-ai-intro');
      const modalEl = document.getElementById('medicalAiModal');
      const questionnaireUrl = '{{ path('patient_medical_dossier_questionnaire') }}';

      if (!diseaseSelect || !payloadInput || !statusBadge || !openBtn || !saveBtn || !formContainer || !introBox || !modalEl) {
        return;
      }

      const modal = typeof bootstrap !== 'undefined' ? new bootstrap.Modal(modalEl) : null;
      let activeQuestionnaire = [];
      let activeMode = 'FALLBACK';

      const markIncomplete = function () {
        statusBadge.className = 'badge bg-secondary';
        statusBadge.textContent = 'Questionnaire non valide';
      };

      const markComplete = function () {
        statusBadge.className = 'badge bg-success';
        statusBadge.textContent = 'Questionnaire valide';
      };

      const renderQuestionnaire = function (questions) {
        formContainer.innerHTML = '';
        activeQuestionnaire = Array.isArray(questions) ? questions : [];

        activeQuestionnaire.forEach(function (q, idx) {
          const col = document.createElement('div');
          col.className = 'col-12';

          const label = document.createElement('label');
          label.className = 'form-label fw-semibold';
          label.textContent = q.label || ('Question ' + (idx + 1));
          col.appendChild(label);

          let field;
          if (q.type === 'choice') {
            field = document.createElement('select');
            field.className = 'form-select';
            const blank = document.createElement('option');
            blank.value = '';
            blank.textContent = 'Selectionnez';
            field.appendChild(blank);
            (q.options || []).forEach(function (opt) {
              const option = document.createElement('option');
              option.value = String(opt);
              option.textContent = String(opt);
              field.appendChild(option);
            });
          } else {
            field = document.createElement('input');
            field.type = q.type === 'number' ? 'number' : 'text';
            field.className = 'form-control';
            field.placeholder = q.placeholder || '';
          }

          field.setAttribute('data-question-index', String(idx));
          col.appendChild(field);
          formContainer.appendChild(col);
        });
      };

      diseaseSelect.addEventListener('change', function () {
        payloadInput.value = '';
        markIncomplete();
      });

      openBtn.addEventListener('click', async function () {
        const disease = (diseaseSelect.value || '').trim();
        if (!disease) {
          alert('Veuillez choisir une maladie avant de lancer l assistant IA.');
          return;
        }

        openBtn.disabled = true;
        openBtn.textContent = 'Chargement...';

        try {
          const response = await fetch(questionnaireUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ disease: disease })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.message || 'Impossible de charger le questionnaire.');
          }

          introBox.textContent = data.intro || 'Repondez a toutes les questions.';
          activeMode = data.mode || 'FALLBACK';
          renderQuestionnaire(data.questions || []);
          if (modal) {
            modal.show();
          }
        } catch (error) {
          alert(error.message || 'Erreur lors du chargement IA.');
        } finally {
          openBtn.disabled = false;
          openBtn.innerHTML = '<i class="bi bi-robot me-1"></i> Ouvrir assistant IA';
        }
      });

      saveBtn.addEventListener('click', function () {
        if (activeQuestionnaire.length === 0) {
          alert('Aucune question disponible.');
          return;
        }

        const answers = [];
        let hasMissing = false;
        formContainer.querySelectorAll('[data-question-index]').forEach(function (field) {
          const idx = Number(field.getAttribute('data-question-index') || '-1');
          const question = activeQuestionnaire[idx] || null;
          const value = (field.value || '').trim();
          if (!question) {
            return;
          }

          if (value === '') {
            hasMissing = true;
          }

          answers.push({
            question: question.label || ('Question ' + (idx + 1)),
            answer: value
          });
        });

        if (hasMissing) {
          alert('Veuillez remplir toutes les reponses.');
          return;
        }

        const payload = {
          disease: diseaseSelect.value,
          mode: activeMode,
          questions: activeQuestionnaire,
          answers: answers,
          generatedAt: new Date().toISOString()
        };

        payloadInput.value = JSON.stringify(payload);
        markComplete();

        if (modal) {
          modal.hide();
        }
      });
    });
  </script>
{% endblock %}
