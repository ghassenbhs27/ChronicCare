{% extends 'base.html.twig' %}

{% block title %}Confirmer votre email - Chronic Care{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block stylesheets %}
  <style>
    body.auth-page {
      background: #f3f7fc;
    }

    .verify-wrap {
      min-height: calc(100vh - 120px);
      display: flex;
      align-items: center;
      padding: 40px 0;
      background:
        radial-gradient(circle at 10% 10%, rgba(13, 110, 253, 0.12), transparent 35%),
        radial-gradient(circle at 90% 90%, rgba(25, 135, 84, 0.12), transparent 35%),
        #f8fbff;
    }

    .verify-topbar {
      padding: 14px 0;
      background: #ffffff;
      border-bottom: 1px solid #e7eef7;
    }

    .verify-topbar .brand {
      font-size: 1.15rem;
      font-weight: 800;
      color: #0d6efd;
      text-decoration: none;
    }

    .verify-topbar .links {
      display: flex;
      gap: 14px;
      font-size: 0.95rem;
    }

    .verify-topbar .links a {
      color: #375172;
      text-decoration: none;
      font-weight: 600;
    }

    .verify-card {
      border: 0;
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 20px 55px rgba(15, 23, 42, 0.1);
      overflow: hidden;
    }

    .verify-top {
      padding: 28px 30px;
      background: linear-gradient(120deg, #0d6efd, #1e7bf6);
      color: #fff;
    }

    .verify-top .badge {
      background: rgba(255, 255, 255, 0.2);
      border: 1px solid rgba(255, 255, 255, 0.25);
      color: #fff;
    }

    .verify-body {
      padding: 28px 30px 30px;
    }

    .verify-icon {
      width: 74px;
      height: 74px;
      border-radius: 18px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 2rem;
      color: #0d6efd;
      background: rgba(13, 110, 253, 0.1);
      margin-bottom: 14px;
    }

    .verify-list {
      border: 1px solid #e9eef5;
      border-radius: 16px;
      padding: 14px 16px;
      background: #fbfdff;
      margin-bottom: 18px;
    }

    .verify-list li { margin-bottom: 8px; }
    .verify-list li:last-child { margin-bottom: 0; }

    .verify-body h2 {
      font-weight: 700;
      color: #10243e;
    }

    .verify-body .btn-lg {
      font-weight: 600;
      border-radius: 12px;
    }

    .verify-body .btn-outline-secondary {
      border-radius: 12px;
    }

    @media (max-width: 576px) {
      .verify-topbar .brand {
        font-size: 1rem;
      }

      .verify-topbar .links {
        gap: 10px;
        font-size: 0.85rem;
      }

      .verify-wrap {
        min-height: auto;
        padding: 24px 0;
      }
      .verify-top, .verify-body { padding: 20px; }
      .verify-icon {
        width: 64px;
        height: 64px;
        font-size: 1.65rem;
      }
    }
  </style>
{% endblock %}

{% block body %}
  <header class="verify-topbar">
    <div class="container d-flex justify-content-between align-items-center">
      <a href="{{ path('index') }}" class="brand">Chronic Care</a>
      <nav class="links" aria-label="Navigation">
        <a href="{{ path('index') }}">Accueil</a>
        <a href="{{ path('contact') }}">Contact</a>
      </nav>
    </div>
  </header>

  <main class="main">
    <section class="verify-wrap">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-7 col-md-9">
            <div class="verify-card">
              <div class="verify-top d-flex justify-content-between align-items-center flex-wrap gap-2">
                <div>
                  <h5 class="mb-1">Activation de compte</h5>
                  <p class="mb-0 opacity-75">Dernière étape avant connexion</p>
                </div>
                <span class="badge rounded-pill px-3 py-2">Email sécurisé</span>
              </div>

              <div class="verify-body text-center">
                <div class="verify-icon">
                  <i class="bi bi-envelope-check"></i>
                </div>
                <h2 class="mb-2">Confirmer votre adresse email</h2>
                <p class="text-muted mb-3">
                  Bonjour <strong>{{ user.prenom }}</strong>, confirmez votre email pour activer votre compte.
                </p>

                <ul class="verify-list text-start list-unstyled">
                  <li><i class="bi bi-check2-circle text-primary me-2"></i>Votre compte sera activé immédiatement.</li>
                  <li><i class="bi bi-check2-circle text-primary me-2"></i>Le lien est personnel et temporaire.</li>
                  <li><i class="bi bi-check2-circle text-primary me-2"></i>Vous pourrez ensuite vous connecter normalement.</li>
                </ul>

                <form method="post" action="{{ path('app_verify_email', { token: token }) }}" class="d-grid gap-2">
                  <button type="submit" class="btn btn-primary btn-lg">
                    <i class="bi bi-shield-check me-2"></i>Confirmer mon email
                  </button>
                  <a href="{{ path('app_resend_verification', { email: user.email }) }}" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-repeat me-2"></i>Renvoyer le lien
                  </a>
                </form>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
