{% extends 'base.html.twig' %}

{% block title %}Appel urgent{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}
  <main class="main">
    <div class="container py-5">
      <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
          <h1 class="h4 mb-2">Appel urgent</h1>
          <p class="text-muted mb-3">
            Salle d appel:
            <code>{{ urgence.meetingUrl }}</code>
          </p>

          <div class="d-flex gap-2 flex-wrap mb-4">
            <a class="btn btn-danger" href="{{ urgence.meetingUrl }}" target="_blank" rel="noopener noreferrer">
              Ouvrir l appel
            </a>
            {% if isPatientOwner %}
              <form method="post" action="{{ path('front_urgence_cancel', {id: urgence.id}) }}" onsubmit="return confirm('Annuler cet appel urgent ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('cancel_urgence_' ~ urgence.id) }}">
                <button type="submit" class="btn btn-outline-danger">Annuler meet</button>
              </form>
            {% endif %}
            <a class="btn btn-outline-secondary" href="{{ path('front_etat_index') }}">Retour</a>
          </div>

          <div class="ratio ratio-16x9 border rounded">
            <iframe
              src="{{ urgence.meetingUrl }}"
              allow="camera; microphone; fullscreen; display-capture; autoplay"
              referrerpolicy="no-referrer"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </main>
{% endblock %}
