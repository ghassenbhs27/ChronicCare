{% extends 'base.html.twig' %}

{% block title %}Mes inscriptions{% endblock %}

{% block stylesheets %}
  <style>
    .inscriptions-wrap {
      background:
        radial-gradient(circle at 5% 10%, rgba(4, 158, 187, 0.12), transparent 40%),
        radial-gradient(circle at 95% 95%, rgba(13, 110, 253, 0.1), transparent 35%),
        #f8fbfd;
      min-height: calc(100vh - 140px);
    }

    .inscriptions-header h1 {
      margin-bottom: .4rem;
    }

    .inscriptions-header {
      margin-top: 10px;
    }

    .inscriptions-chip {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--accent-color), transparent 88%);
      color: var(--accent-color);
      border: 1px solid color-mix(in srgb, var(--accent-color), transparent 70%);
      font-weight: 700;
      font-size: .85rem;
    }

    .inscriptions-panel {
      border: 0;
      border-radius: 16px;
      box-shadow: 0 15px 40px rgba(16, 24, 40, .08);
      overflow: hidden;
      background: #fff;
    }

    .inscriptions-filter {
      padding: 18px;
      border-bottom: 1px solid #eef2f7;
      background: #fcfeff;
    }

    .inscriptions-table th {
      font-size: .83rem;
      text-transform: uppercase;
      letter-spacing: .02em;
      color: #667085;
      border-bottom-width: 1px;
    }

    .inscriptions-table td {
      vertical-align: middle;
    }

    .event-title {
      font-weight: 700;
      color: #0f172a;
      margin-bottom: 2px;
    }

    .accent-btn {
      background: var(--accent-color);
      border-color: var(--accent-color);
      color: #fff;
    }

    .accent-btn:hover,
    .accent-btn:focus {
      background: color-mix(in srgb, var(--accent-color), transparent 15%);
      border-color: color-mix(in srgb, var(--accent-color), transparent 15%);
      color: #fff;
    }
  </style>
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main inscriptions-wrap py-5">
    <div class="container py-2">
      <div class="inscriptions-header d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
          <h1>Mes inscriptions</h1>
          <p class="text-muted mb-0">Suivez vos participations aux evenements coach.</p>
        </div>
        <span class="inscriptions-chip">{{ inscriptions|length }} inscription{{ inscriptions|length > 1 ? 's' : '' }}</span>
      </div>

      <div class="inscriptions-panel">
        <form method="get" class="inscriptions-filter row g-3 align-items-end">
          <div class="col-12 col-lg-5">
            <label class="form-label small fw-semibold text-muted mb-1" for="q">Recherche</label>
            <input class="form-control" id="q" name="q" type="text" placeholder="Titre de l'evenement..." value="{{ q }}">
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label small fw-semibold text-muted mb-1" for="sort">Trier par</label>
            <select class="form-select" id="sort" name="sort">
              <option value="dateDebut" {% if sort == 'dateDebut' %}selected{% endif %}>Date debut</option>
              <option value="dateFin" {% if sort == 'dateFin' %}selected{% endif %}>Date fin</option>
              <option value="createdAt" {% if sort == 'createdAt' %}selected{% endif %}>Date inscription</option>
              <option value="titre" {% if sort == 'titre' %}selected{% endif %}>Titre</option>
            </select>
          </div>
          <div class="col-6 col-lg-2">
            <label class="form-label small fw-semibold text-muted mb-1" for="order">Ordre</label>
            <select class="form-select" id="order" name="order">
              <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Decroissant</option>
              <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Croissant</option>
            </select>
          </div>
          <div class="col-12 col-lg-3 d-flex gap-2">
            <button class="btn accent-btn flex-grow-1" type="submit">
              <i class="bi bi-search me-1"></i> Filtrer
            </button>
            <a class="btn btn-outline-secondary" href="{{ path('front_mes_inscriptions') }}">Reset</a>
          </div>
        </form>

        {% if inscriptions is empty %}
          <div class="p-5 text-center">
            <i class="bi bi-calendar-x fs-1 text-muted"></i>
            <h5 class="mt-3 mb-1">Aucune inscription trouvee</h5>
            <p class="text-muted mb-3">Vous n'avez encore aucune participation enregistree.</p>
            <a href="{{ path('front_evenements') }}" class="btn accent-btn">Voir les evenements</a>
          </div>
        {% else %}
          <div class="table-responsive">
            <table class="table inscriptions-table mb-0">
              <thead class="table-light">
                <tr>
                  <th>Evenement</th>
                  <th>Date debut</th>
                  <th>Date fin</th>
                  <th>Inscrit le</th>
                  <th class="text-end">Action</th>
                </tr>
              </thead>
              <tbody>
                {% for ins in inscriptions %}
                  <tr>
                    <td>
                      <div class="event-title">{{ ins.evenement.titre }}</div>
                      <div class="small text-muted"><i class="bi bi-geo-alt me-1"></i>{{ ins.evenement.lieu }}</div>
                    </td>
                    <td>{{ ins.evenement.dateDebut|date('d/m/Y H:i') }}</td>
                    <td>{{ ins.evenement.dateFin|date('d/m/Y H:i') }}</td>
                    <td>{{ ins.createdAt|date('d/m/Y H:i') }}</td>
                    <td class="text-end">
                      <a href="{{ path('front_evenement_show', { id: ins.evenement.id }) }}" class="btn btn-sm accent-btn">Voir</a>
                    </td>
                  </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
        {% endif %}
      </div>
    </div>
  </main>
{% endblock %}
