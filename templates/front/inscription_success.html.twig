{% extends 'base.html.twig' %}

{% block title %}Compte créé avec succès - Chronic Care{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">
    <section class="section light-background py-5">
      <div class="container">
        <div class="row justify-content-center">
          <div class="col-lg-6 col-md-8">
            <div class="card border-0 shadow-sm rounded-3 p-5 text-center">
              <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success bg-opacity-10 text-success mb-3" style="width: 80px; height: 80px;">
                  <i class="bi bi-check-lg" style="font-size: 2.5rem;"></i>
                </div>
                <h2 class="text-success mb-2">Compte créé avec succès !</h2>
                <p class="text-muted mb-0">
                  Un email de vérification a été envoyé à <strong>{{ email }}</strong>.
                </p>
              </div>
              <p class="mb-4">
                Consultez votre boîte de réception (et le dossier spam) et cliquez sur le lien reçu pour activer votre compte.
                Après vérification de l'email, un administrateur validera votre rôle avant l'accès complet.
              </p>
              <a href="{{ path('app_login') }}" class="btn btn-primary">
                <i class="bi bi-box-arrow-in-right me-2"></i>Se connecter
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
{% endblock %}
