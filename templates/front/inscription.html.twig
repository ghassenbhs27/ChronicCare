{% extends 'base.html.twig' %}

{% block title %}S'inscrire - Chronic Care{% endblock %}

{% block body_class %}appointment-page{% endblock %}

{% block stylesheets %}
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<meta name="description" content="Créez un compte Chronic Care pour commencer à suivre votre santé et être accompagné par des professionnels.">
<meta name="keywords" content="inscription, compte patient, suivi santé, chronic care">

<!-- Favicons -->
<link href="{{ asset('assets/img/favicon.png') }}" rel="icon">
<link href="{{ asset('assets/img/apple-touch-icon.png') }}" rel="apple-touch-icon">

<!-- Fonts -->
<link href="https://fonts.googleapis.com" rel="preconnect">
<link href="https://fonts.gstatic.com" rel="preconnect" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&family=Lato:ital,wght@0,100;0,300;0,400;0,700;0,900;1,100;1,300;1,400;1,700;1,900&family=Raleway:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">

    <!-- Page Title -->
    <div class="page-title">
      <div class="breadcrumbs">
        <nav aria-label="breadcrumb">
          <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('index') }}"><i class="bi bi-house"></i> Accueil</a></li>
            <li class="breadcrumb-item active current">S'inscrire</li>
          </ol>
        </nav>
      </div>

      <div class="title-wrapper">
        <h1>Créer un compte</h1>
        <p>Rejoignez Chronic Care et commencez votre parcours de suivi de santé personnalisé. L'inscription prend moins de 5 minutes.</p>
      </div>
    </div><!-- End Page Title -->

    <!-- Inscription Section -->
    <section id="appointmnet" class="appointmnet section">

      <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row gy-4">

          <!-- Inscription Info -->
          <div class="col-lg-6">
            <div class="appointment-info">
              <h3>Inscription simple et sécurisée</h3>
              <p class="mb-4">Créez votre compte en quelques minutes pour accéder à tous les modules de suivi de Chronic Care. Vos données de santé sont protég��es par les normes les plus strictes.</p>

              <div class="info-items">
                <div class="info-item d-flex align-items-center mb-3" data-aos="fade-up" data-aos-delay="200">
                  <div class="icon-wrapper me-3">
                    <i class="bi bi-shield-check"></i>
                  </div>
                  <div>
                    <h5>Données sécurisées</h5>
                    <p class="mb-0">Conformité RGPD et chiffrement de bout en bout pour protéger vos informations</p>
                  </div>
                </div><!-- End Info Item -->

                <div class="info-item d-flex align-items-center mb-3" data-aos="fade-up" data-aos-delay="250">
                  <div class="icon-wrapper me-3">
                    <i class="bi bi-lightning"></i>
                  </div>
                  <div>
                    <h5>Accès immédiat</h5>
                    <p class="mb-0">Commencez à utiliser Chronic Care dès que vous êtes inscrit</p>
                  </div>
                </div><!-- End Info Item -->

                <div class="info-item d-flex align-items-center mb-3" data-aos="fade-up" data-aos-delay="300">
                  <div class="icon-wrapper me-3">
                    <i class="bi bi-headset"></i>
                  </div>
                  <div>
                    <h5>Support disponible</h5>
                    <p class="mb-0">Notre équipe est là pour vous aider à configurer votre profil</p>
                  </div>
                </div><!-- End Info Item -->
              </div>

              <div class="emergency-contact mt-4" data-aos="fade-up" data-aos-delay="350">
                <div class="emergency-card p-3">
                  <h6 class="mb-2"><i class="bi bi-telephone-fill me-2"></i>Besoin d'aide ?</h6>
                  <p class="mb-0">Contactez-nous au <strong>+33 1 23 45 67 89</strong> ou via le chat</p>
                </div>
              </div>

            </div>
          </div><!-- End Inscription Info -->

        <!-- Inscription Form -->
<div class="col-lg-6">
  <div class="appointment-form-wrapper" data-aos="fade-up" data-aos-delay="200">
    
    {{ form_start(form, {'attr': {'class': 'appointment-form', 'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
      <div class="row gy-3">

        <div class="col-md-6">
          {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'placeholder': 'Prénom'}}) }}
          <div class="text-danger">{{ form_errors(form.prenom) }}</div>
        </div>

        <div class="col-md-6">
          {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'placeholder': 'Nom'}}) }}
          <div class="text-danger">{{ form_errors(form.nom) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'Adresse email'}}) }}
          <div class="text-danger">{{ form_errors(form.email) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.telephone, {'attr': {'class': 'form-control', 'placeholder': 'Téléphone (optionnel)'}}) }}
          <div class="text-danger">{{ form_errors(form.telephone) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.genre, {'attr': {'class': 'form-select'}}) }}
          <div class="text-danger">{{ form_errors(form.genre) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.requestedRole, {'attr': {'class': 'form-select'}}) }}
          <div class="text-danger">{{ form_errors(form.requestedRole) }}</div>
        </div>

        <div class="col-md-12 d-none" id="medical-condition-wrapper">
          {{ form_widget(form.medicalCondition, {'attr': {'class': 'form-select', 'id': 'medical-condition-select'}}) }}
          <div class="text-danger">{{ form_errors(form.medicalCondition) }}</div>
          <div class="d-flex flex-wrap gap-2 mt-2">
            <button type="button" class="btn btn-outline-primary btn-sm" id="open-medical-ai-btn">
              <i class="bi bi-robot me-1"></i> Demarrer dossier IA
            </button>
            <span class="badge bg-secondary" id="medical-dossier-status">Dossier non complet</span>
          </div>
          <div class="text-danger">{{ form_errors(form.medicalDossierPayload) }}</div>
          {{ form_widget(form.medicalDossierPayload, {'attr': {'id': 'medical-dossier-payload'}}) }}
        </div>

        <div class="col-md-12">
          <label for="{{ form.profileImage.vars.id }}" class="form-label">{{ form.profileImage.vars.label }}</label>
          <div class="input-group">
            {{ form_widget(form.profileImage) }}
            <small class="d-block text-muted mt-2">{{ form.profileImage.vars.help }}</small>
          </div>
          <div class="text-danger">{{ form_errors(form.profileImage) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.photoProfil, {'attr': {'class': 'form-control', 'accept': 'image/png,image/jpeg,image/webp'}}) }}
          <div class="form-text">Photo de profil optionnelle (JPG, PNG, WEBP).</div>
          <div class="text-danger">{{ form_errors(form.photoProfil) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.password.first, {'attr': {'class': 'form-control', 'placeholder': 'Mot de passe (min. 8 caractères)'}}) }}
          <div class="text-danger">{{ form_errors(form.password.first) }}</div>
        </div>

        <div class="col-md-12">
          {{ form_widget(form.password.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmer le mot de passe'}}) }}
          <div class="text-danger">{{ form_errors(form.password.second) }}</div>
        </div>

        {# Le rôle est demandé par l'utilisateur puis validé/refusé par l'admin #}

        {# Checkbox optionnelle - conditions d'utilisation #}
        <div class="col-12">
          <div class="form-check">
            <input class="form-check-input" type="checkbox" id="terms">
            <label class="form-check-label" for="terms">
              J'accepte les <a href="{{ path('privacy') }}" target="_blank">conditions d'utilisation</a>
            </label>
          </div>
        </div>

        <div class="col-12">
          <button type="submit" class="btn btn-appointment w-100">
            <i class="bi bi-person-plus me-2"></i>Créer mon compte
          </button>
        </div>

        <div class="col-12 text-center">
          <span class="text-muted">Vous avez déjà un compte ?</span>
          <a href="{{ path('app_login') }}" class="fw-bold">Se connecter</a>
        </div>

      </div>
    {{ form_end(form) }}

  </div>
</div><!-- End Inscription Form -->

        </div>

        <div class="modal fade" id="medicalAiModal" tabindex="-1" aria-hidden="true">
          <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
              <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-robot me-2"></i>Dossier medical assiste par IA</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
              </div>
              <div class="modal-body">
                <div class="alert alert-info py-2" id="medical-ai-intro">
                  Selectionnez votre maladie, puis lancez l assistant IA.
                </div>
                <form id="medical-ai-form" class="row gy-3"></form>
                <p class="small text-muted mb-0 mt-2">
                  Les informations servent uniquement a pre-remplir votre dossier et orienter l analyse de risque.
                </p>
              </div>
              <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Fermer</button>
                <button type="button" class="btn btn-primary" id="save-medical-ai-btn">Valider dossier</button>
              </div>
            </div>
          </div>
        </div>

        <!-- Process Steps -->
        <div class="process-steps mt-5" data-aos="fade-up" data-aos-delay="300">
          <div class="row text-center gy-4">
            <div class="col-lg-3 col-md-6">
              <div class="step-item">
                <div class="step-number">1</div>
                <div class="step-icon">
                  <i class="bi bi-pencil-square"></i>
                </div>
                <h5>Remplir le formulaire</h5>
                <p>Entrez vos informations personnelles et créez un mot de passe sécurisé</p>
              </div>
            </div><!-- End Step -->

            <div class="col-lg-3 col-md-6">
              <div class="step-item">
                <div class="step-number">2</div>
                <div class="step-icon">
                  <i class="bi bi-envelope-check"></i>
                </div>
                <h5>Confirmer email</h5>
                <p>Vérifiez votre adresse email en cliquant sur le lien de confirmation</p>
              </div>
            </div><!-- End Step -->

            <div class="col-lg-3 col-md-6">
              <div class="step-item">
                <div class="step-number">3</div>
                <div class="step-icon">
                  <i class="bi bi-graph-up"></i>
                </div>
                <h5>Configurer le profil</h5>
                <p>Ajoutez vos données de santé et indiquez vos conditions chroniques</p>
              </div>
            </div><!-- End Step -->

            <div class="col-lg-3 col-md-6">
              <div class="step-item">
                <div class="step-number">4</div>
                <div class="step-icon">
                  <i class="bi bi-check-circle"></i>
                </div>
                <h5>Commencer</h5>
                <p>Explorez tous les modules et connectez-vous avec des professionnels</p>
              </div>
            </div><!-- End Step -->

          </div>
        </div><!-- End Process Steps -->

      </div>

    </section><!-- /Appointmnet Section -->

  </main>

  <footer id="footer" class="footer position-relative light-background">

    <div class="container footer-top">
      <div class="row gy-4">
        <div class="col-lg-4 col-md-6 footer-about">
          <a href="{{ path('index') }}" class="logo d-flex align-items-center">
            <span class="sitename">Chronic Care</span>
          </a>
          <div class="footer-contact pt-3">
            <p>1, Pôle Technologique</p>
            <p>2 Rue André Ampère, Ariana 2083</p>
            <p class="mt-3"><strong>Téléphone :</strong> <span>+33 1 23 45 67 89</span></p>
            <p><strong>Email :</strong> <span>contact@chroniccare.org</span></p>
          </div>
          <div class="social-links d-flex mt-4">
            <a href=""><i class="bi bi-twitter-x"></i></a>
            <a href=""><i class="bi bi-facebook"></i></a>
            <a href=""><i class="bi bi-instagram"></i></a>
            <a href=""><i class="bi bi-linkedin"></i></a>
          </div>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Liens utiles</h4>
          <ul>
            <li><a href="{{ path('index') }}">Accueil</a></li>
            <li><a href="{{ path('about') }}">À propos</a></li>
            <li><a href="{{ path('privacy') }}">Politique de confidentialité</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Nos fonctionnalités</h4>
          <ul>
            <li><a href="{{ path('nutritionnistes') }}">Nutritionnistes</a></li>
            <li><a href="{{ path('coachs') }}">Coachs</a></li>
            <li><a href="{{ path('boutique') }}">Boutique</a></li>
          </ul>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Ressources</h4>
          <ul>
            <li><a href="{{ path('forum') }}">Forum santé</a></li>
            <li><a href="{{ path('contenu-educatif') }}">Contenu éducatif</a></li>
            <li><a href="{{ path('faq') }}">FAQ patients</a></li>
          </ul>
        </div>

      </div>
    </div>

    <div class="container copyright text-center mt-4">
      <p>© <span>Copyright</span> <strong class="px-1 sitename">Chronic Care</strong> <span>Tous droits réservés</span></p>
      <div class="credits">
        Designed by <a href="https://bootstrapmade.com/">BootstrapMade</a> | <a href="https://bootstrapmade.com/tools/">DevTools</a>
      </div>
    </div>

  </footer>

  <!-- Scroll Top -->
  <a href="#" id="scroll-top" class="scroll-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Preloader -->
  <div id="preloader"></div>

  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const roleSelect = document.querySelector('select[name$="[requestedRole]"]');
      const diseaseSelect = document.querySelector('select[name$="[medicalCondition]"]');
      const payloadInput = document.querySelector('input[name$="[medicalDossierPayload]"]');
      const medicalWrapper = document.getElementById('medical-condition-wrapper');
      const statusBadge = document.getElementById('medical-dossier-status');
      const openBtn = document.getElementById('open-medical-ai-btn');
      const saveBtn = document.getElementById('save-medical-ai-btn');
      const formContainer = document.getElementById('medical-ai-form');
      const introBox = document.getElementById('medical-ai-intro');
      const modalEl = document.getElementById('medicalAiModal');
      const questionnaireUrl = '{{ path('app_register_medical_questionnaire') }}';

      if (!roleSelect || !diseaseSelect || !payloadInput || !medicalWrapper || !statusBadge || !openBtn || !saveBtn || !formContainer || !introBox || !modalEl) {
        return;
      }

      const modal = typeof bootstrap !== 'undefined' ? new bootstrap.Modal(modalEl) : null;
      let activeQuestionnaire = [];
      let activeMode = 'FALLBACK';
      
      const markIncomplete = function () {
        statusBadge.className = 'badge bg-secondary';
        statusBadge.textContent = 'Dossier non complet';
      };

      const markComplete = function () {
        statusBadge.className = 'badge bg-success';
        statusBadge.textContent = 'Dossier complet';
      };

      const toggleMedicalSection = function () {
        if (roleSelect.value === 'ROLE_PATIENT') {
          medicalWrapper.classList.remove('d-none');
          return;
        }

        medicalWrapper.classList.add('d-none');
        payloadInput.value = '';
        markIncomplete();
      };

      const renderQuestionnaire = function (questions) {
        formContainer.innerHTML = '';
        activeQuestionnaire = Array.isArray(questions) ? questions : [];

        activeQuestionnaire.forEach(function (q, idx) {
          const col = document.createElement('div');
          col.className = 'col-12';

          const label = document.createElement('label');
          label.className = 'form-label fw-semibold';
          label.textContent = q.label || ('Question ' + (idx + 1));
          col.appendChild(label);

          let field;
          if (q.type === 'choice') {
            field = document.createElement('select');
            field.className = 'form-select';
            const blank = document.createElement('option');
            blank.value = '';
            blank.textContent = 'Selectionnez';
            field.appendChild(blank);
            (q.options || []).forEach(function (opt) {
              const option = document.createElement('option');
              option.value = String(opt);
              option.textContent = String(opt);
              field.appendChild(option);
            });
          } else {
            field = document.createElement('input');
            field.type = q.type === 'number' ? 'number' : 'text';
            field.className = 'form-control';
            field.placeholder = q.placeholder || '';
          }

          field.setAttribute('data-question-index', String(idx));
          col.appendChild(field);
          formContainer.appendChild(col);
        });
      };

      roleSelect.addEventListener('change', toggleMedicalSection);
      diseaseSelect.addEventListener('change', function () {
        payloadInput.value = '';
        markIncomplete();
      });

      openBtn.addEventListener('click', async function () {
        if (roleSelect.value !== 'ROLE_PATIENT') {
          return;
        }
        const disease = (diseaseSelect.value || '').trim();
        if (!disease) {
          alert('Veuillez choisir votre maladie avant de lancer l assistant IA.');
          return;
        }

        openBtn.disabled = true;
        openBtn.textContent = 'Chargement...';
        try {
          const response = await fetch(questionnaireUrl, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ disease: disease })
          });
          const data = await response.json();
          if (!response.ok || !data.ok) {
            throw new Error(data.message || 'Impossible de charger le questionnaire.');
          }

          introBox.textContent = data.intro || 'Repondez aux questions pour completer votre dossier.';
          activeMode = data.mode || 'FALLBACK';
          renderQuestionnaire(data.questions || []);

          if (modal) {
            modal.show();
          }
        } catch (error) {
          alert(error.message || 'Erreur lors du chargement du questionnaire IA.');
        } finally {
          openBtn.disabled = false;
          openBtn.innerHTML = '<i class="bi bi-robot me-1"></i> Demarrer dossier IA';
        }
      });

      saveBtn.addEventListener('click', function () {
        if (activeQuestionnaire.length === 0) {
          alert('Aucune question disponible. Lancez d abord l assistant IA.');
          return;
        }

        const answers = [];
        let hasMissing = false;
        formContainer.querySelectorAll('[data-question-index]').forEach(function (field) {
          const idx = Number(field.getAttribute('data-question-index') || '-1');
          const question = activeQuestionnaire[idx] || null;
          const value = (field.value || '').trim();
          if (!question) {
            return;
          }
          if (value === '') {
            hasMissing = true;
          }
          answers.push({
            question: question.label || ('Question ' + (idx + 1)),
            answer: value
          });
        });

        if (hasMissing) {
          alert('Veuillez remplir toutes les reponses du dossier medical.');
          return;
        }

        const payload = {
          disease: diseaseSelect.value,
          mode: activeMode,
          questions: activeQuestionnaire,
          answers: answers,
          generatedAt: new Date().toISOString()
        };

        payloadInput.value = JSON.stringify(payload);
        markComplete();
        if (modal) {
          modal.hide();
        }
      });

      toggleMedicalSection();
    });
  </script>
{% endblock %}
