                <h3>Nos partenaires</h3>
                <p>Chronic Care travaille avec les meilleurs professionnels de santé et organisations partenaires</p>
              </div>
              <div class="certifications-grid">
                <div class="certification-item">
                  <img src="{{ asset('assets/img/clients/clients-1.webp') }}" alt="JCI Accreditation" class="img-fluid">
