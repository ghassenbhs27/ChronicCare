                </div>
                <div class="certification-item">
                  <img src="{{ asset('assets/img/clients/clients-4.webp') }}" alt="CAP Accreditation" class="img-fluid">
                </div>
                <div class="certification-item">
                  <img src="{{ asset('assets/img/clients/clients-5.webp') }}" alt="Medical Board" class="img-fluid">
                </div>
                <div class="certification-item">
                  <img src="{{ asset('assets/img/clients/clients-6.webp') }}" alt="Healthcare Association" class="img-fluid">
                </div>
              </div>
            </div>
