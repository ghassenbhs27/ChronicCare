{% extends 'base.html.twig' %}

{% block title %}Mon suivi - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main">
    <div class="container py-5">
      <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
          <h1 class="mb-1">Mon espace suivi</h1>
          <p class="text-muted mb-0">Tout votre suivi santé en un seul endroit : activités, relevés, rendez-vous et inscriptions.</p>
        </div>
      </div>

      <nav aria-label="Fil d'Ariane" class="mb-4">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
          <li class="breadcrumb-item active" aria-current="page">Mon suivi</li>
        </ol>
      </nav>

      <div class="row g-4">
        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                  <i class="bi bi-activity fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Activités</h5>
                  <p class="text-muted small mb-0">Vos activités physiques</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Enregistrez et consultez vos séances (type, durée, calories).</p>
              <a href="{{ path('front_activite_index') }}" class="btn btn-primary align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir mes activités
              </a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-success bg-opacity-10 text-success p-3">
                  <i class="bi bi-heart-pulse fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Mon etat</h5>
                  <p class="text-muted small mb-0">Relevés (poids, glycémie…)</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Suivez vos indicateurs : poids, tension, glycémie, température.</p>
              <a href="{{ path('front_etat_index') }}" class="btn btn-success align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir mon etat
              </a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                  <i class="bi bi-calendar2-check fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Mes RDV</h5>
                  <p class="text-muted small mb-0">Rendez-vous</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Consultez et gérez vos rendez-vous avec les professionnels.</p>
              <a href="{{ path('patient_rdv_list') }}" class="btn btn-info align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir mes RDV
              </a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-primary bg-opacity-10 text-primary p-3">
                  <i class="bi bi-calendar2-event fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Événements</h5>
                  <p class="text-muted small mb-0">Proposés par les coachs, confirmés par l'admin</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Inscrivez-vous aux ateliers et événements validés par l'administration.</p>
              <a href="{{ path('front_evenements') }}" class="btn btn-primary align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir les événements et s'inscrire
              </a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-warning bg-opacity-10 text-warning p-3">
                  <i class="bi bi-journal-bookmark fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Mes inscriptions</h5>
                  <p class="text-muted small mb-0">Événements</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Liste des événements auxquels vous êtes déjà inscrit.</p>
              <a href="{{ path('front_mes_inscriptions') }}" class="btn btn-warning align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir mes inscriptions
              </a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-secondary bg-opacity-10 text-secondary p-3">
                  <i class="bi bi-chat-dots fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Forum</h5>
                  <p class="text-muted small mb-0">Publications des coachs</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Lisez les publications et commentez (vous ne pouvez pas publier).</p>
              <a href="{{ path('publication_index') }}" class="btn btn-outline-secondary align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir le forum
              </a>
            </div>
          </div>
        </div>

        <div class="col-md-6 col-lg-4">
          <div class="card h-100 border-0 shadow-sm">
            <div class="card-body d-flex flex-column">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="rounded-3 bg-info bg-opacity-10 text-info p-3">
                  <i class="bi bi-graph-up-arrow fs-3"></i>
                </div>
                <div>
                  <h5 class="card-title mb-0">Statistiques</h5>
                  <p class="text-muted small mb-0">Courbes et indicateurs</p>
                </div>
              </div>
              <p class="card-text small flex-grow-1">Visualisez vos activités, relevés de santé et rendez-vous en graphiques.</p>
              <a href="{{ path('app_statistics') }}" class="btn btn-info align-self-start">
                <i class="bi bi-arrow-right-circle me-1"></i> Voir mes statistiques
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
{% endblock %}
