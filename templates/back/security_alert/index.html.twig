{% extends 'back/base.html.twig' %}

{% block title %}Alertes de securite - Chronic Care{% endblock %}
{% block page_title %}Alertes de securite{% endblock %}
{% block page_subtitle %}Surveillance des comportements suspects{% endblock %}

{% block body %}
{% set base_params = { status: status, severity: severity, type: type, q: search|default('') } %}
<div class="container-fluid">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
    <div class="small text-muted">
      Alertes ouvertes: <strong>{{ open_count }}</strong>
    </div>
    <a href="{{ path('admin_security_alert_history') }}" class="btn btn-outline-secondary btn-sm">Historique global</a>
  </div>

  <form method="get" action="{{ path('admin_security_alert_index') }}" class="row g-2 mb-3">
    <input type="hidden" name="sort" value="{{ sort }}">
    <input type="hidden" name="dir" value="{{ dir }}">
    <div class="col-sm-12 col-md-3">
      <input
        type="text"
        name="q"
        class="form-control form-control-sm"
        placeholder="Rechercher message, email, IP, type..."
        value="{{ search|default('') }}"
      >
    </div>
    <div class="col-auto">
      <select name="status" class="form-select form-select-sm">
        <option value="en_cours" {{ status == 'en_cours' ? 'selected' : '' }}>En cours</option>
        <option value="traitee" {{ status == 'traitee' ? 'selected' : '' }}>Traitees</option>
        <option value="ignoree" {{ status == 'ignoree' ? 'selected' : '' }}>Ignorees</option>
        <option value="all" {{ status == 'all' ? 'selected' : '' }}>Toutes</option>
      </select>
    </div>
    <div class="col-auto">
      <select name="severity" class="form-select form-select-sm">
        <option value="" {{ severity == '' ? 'selected' : '' }}>Toutes severites</option>
        <option value="critical" {{ severity == 'critical' ? 'selected' : '' }}>Critical</option>
        <option value="high" {{ severity == 'high' ? 'selected' : '' }}>High</option>
        <option value="medium" {{ severity == 'medium' ? 'selected' : '' }}>Medium</option>
      </select>
    </div>
    <div class="col-auto">
      <select name="type" class="form-select form-select-sm">
        <option value="" {{ type == '' ? 'selected' : '' }}>Tous types</option>
        <option value="medicale" {{ type == 'medicale' ? 'selected' : '' }}>Medicale</option>
        <option value="comportementale" {{ type == 'comportementale' ? 'selected' : '' }}>Comportementale</option>
        <option value="securitaire" {{ type == 'securitaire' ? 'selected' : '' }}>Securitaire</option>
        <option value="technique" {{ type == 'technique' ? 'selected' : '' }}>Technique</option>
      </select>
    </div>
    <div class="col-auto">
      <button type="submit" class="btn btn-primary btn-sm">Filtrer</button>
    </div>
    <div class="col-auto">
      <a href="{{ path('admin_security_alert_index') }}" class="btn btn-outline-secondary btn-sm">Reinitialiser</a>
    </div>
  </form>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              {% set next_dir_date = sort == 'createdAt' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'createdAt', dir: next_dir_date, page: 1 })) }}">
                  Date {% if sort == 'createdAt' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              {% set next_dir_type = sort == 'eventType' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'eventType', dir: next_dir_type, page: 1 })) }}">
                  Type {% if sort == 'eventType' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              {% set next_dir_cat = sort == 'alertType' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'alertType', dir: next_dir_cat, page: 1 })) }}">
                  Categorie {% if sort == 'alertType' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              {% set next_dir_sev = sort == 'severity' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'severity', dir: next_dir_sev, page: 1 })) }}">
                  Severite {% if sort == 'severity' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              {% set next_dir_score = sort == 'riskScore' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'riskScore', dir: next_dir_score, page: 1 })) }}">
                  Score {% if sort == 'riskScore' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              {% set next_dir_user = sort == 'userEmail' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'userEmail', dir: next_dir_user, page: 1 })) }}">
                  Utilisateur {% if sort == 'userEmail' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              <th>IP</th>
              <th>Message</th>
              {% set next_dir_status = sort == 'alertStatus' and dir == 'ASC' ? 'DESC' : 'ASC' %}
              <th>
                <a class="text-dark text-decoration-none" href="{{ path('admin_security_alert_index', base_params|merge({ sort: 'alertStatus', dir: next_dir_status, page: 1 })) }}">
                  Statut {% if sort == 'alertStatus' %}<i class="bi {{ dir == 'ASC' ? 'bi-sort-up' : 'bi-sort-down' }}"></i>{% endif %}
                </a>
              </th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            {% for alert in alerts %}
              <tr>
                <td class="small">{{ alert.createdAt|date('d/m/Y H:i') }}</td>
                <td><code>{{ alert.eventType }}</code></td>
                <td>
                  <span class="badge bg-secondary">{{ alert.alertType|upper }}</span>
                </td>
                <td>
                  <span class="badge {{ alert.severity == 'critical' ? 'bg-danger' : (alert.severity == 'high' ? 'bg-warning text-dark' : 'bg-info text-dark') }}">
                    {{ alert.severity }}
                  </span>
                </td>
                <td><strong>{{ alert.riskScore }}</strong></td>
                <td class="small">{{ alert.user ? alert.user.email : 'N/A' }}</td>
                <td class="small">{{ alert.ipAddress ?: 'N/A' }}</td>
                <td class="small">
                  {{ alert.message }}
                  {% if alert.context %}
                    <details class="mt-1">
                      <summary>Contexte</summary>
                      <pre class="small mb-0">{{ alert.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    </details>
                  {% endif %}
                  {% if alert.statusHistory is not empty %}
                    <details class="mt-1">
                      <summary>Historique statut</summary>
                      <ul class="small mb-0">
                        {% for item in alert.statusHistory %}
                          <li>
                            {{ item.changed_at|default('N/A') }} - <strong>{{ item.status|default('N/A') }}</strong>
                            {% if item.source is defined %} ({{ item.source }}){% endif %}
                            {% if item.note is defined %}: {{ item.note }}{% endif %}
                          </li>
                        {% endfor %}
                      </ul>
                    </details>
                  {% endif %}
                </td>
                <td>
                  {% if alert.alertStatus == 'en_cours' %}
                    <span class="badge bg-danger">En cours</span>
                  {% elseif alert.alertStatus == 'traitee' %}
                    <span class="badge bg-success">Traitee</span>
                  {% else %}
                    <span class="badge bg-secondary">Ignoree</span>
                  {% endif %}
                </td>
                <td>
                  {% set action_params = { id: alert.id, status: status, severity: severity, type: type, q: search|default(''), sort: sort, dir: dir, page: alerts.getCurrentPageNumber } %}
                  {% if alert.alertStatus == 'en_cours' %}
                    <div class="d-flex gap-1">
                      <form method="post" action="{{ path('admin_security_alert_set_status', action_params) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('set_security_alert_status_' ~ alert.id) }}">
                        <input type="hidden" name="alert_status" value="traitee">
                        <button type="submit" class="btn btn-sm btn-outline-success">Traiter</button>
                      </form>
                      <form method="post" action="{{ path('admin_security_alert_set_status', action_params) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('set_security_alert_status_' ~ alert.id) }}">
                        <input type="hidden" name="alert_status" value="ignoree">
                        <button type="submit" class="btn btn-sm btn-outline-secondary">Ignorer</button>
                      </form>
                    </div>
                  {% else %}
                    <form method="post" action="{{ path('admin_security_alert_set_status', action_params) }}">
                      <input type="hidden" name="_token" value="{{ csrf_token('set_security_alert_status_' ~ alert.id) }}">
                      <input type="hidden" name="alert_status" value="en_cours">
                      <button type="submit" class="btn btn-sm btn-outline-warning">Remettre en cours</button>
                    </form>
                  {% endif %}
                </td>
              </tr>
            {% else %}
              <tr>
                <td colspan="10" class="text-center text-muted py-4">Aucune alerte</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    <div class="card-footer bg-white border-0 d-flex flex-wrap justify-content-between align-items-center py-2 px-3">
      <span class="small text-muted">
        {% if alerts.getTotalItemCount > 0 %}
          Affichage {{ alerts.getItemNumberPerPage * (alerts.getCurrentPageNumber - 1) + 1 }}
          a {{ min(alerts.getItemNumberPerPage * alerts.getCurrentPageNumber, alerts.getTotalItemCount) }}
          sur {{ alerts.getTotalItemCount }} resultat(s)
        {% else %}
          0 resultat
        {% endif %}
      </span>
      {% if alerts.getTotalItemCount > 0 %}
        {{ knp_pagination_render(alerts, '@KnpPaginator/Pagination/bootstrap_v5_pagination.html.twig', {}, {
          routeParams: { status: status, severity: severity, type: type, q: search|default(''), sort: sort, dir: dir }
        }) }}
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
