{# Formulaire style modale : même rendu pour new et edit #}
<div class="modal-dialog-style card border-0 shadow-sm rounded-3 overflow-hidden" style="max-width: 560px; margin: 0 auto;">
  <div class="card-header bg-white border-0 d-flex justify-content-between align-items-center py-3 px-4">
    <h5 class="mb-0 fw-semibold">{{ modal_title|default('Add New User') }}</h5>
    <a href="{{ path('app_user_index') }}" class="btn btn-link text-muted p-0" style="font-size: 1.25rem;" aria-label="Fermer">&times;</a>
  </div>
  <div class="card-body p-4">
    {{ form_start(form, { attr: { class: 'user-modal-form', novalidate: 'novalidate' } }) }}
    {{ form_errors(form) }}

    <div class="row g-3">
      <div class="col-md-6">
        {{ form_row(form.prenom, { label_attr: { class: 'form-label small fw-medium' } }) }}
      </div>
      <div class="col-md-6">
        {{ form_row(form.nom, { label_attr: { class: 'form-label small fw-medium' } }) }}
      </div>
    </div>

    <div class="mt-3">
      {{ form_row(form.email, { label_attr: { class: 'form-label small fw-medium' } }) }}
    </div>

    <div class="row g-3 mt-0">
      <div class="col-md-6">
        {% if form.role is defined %}
          {{ form_row(form.role, { label_attr: { class: 'form-label small fw-medium' } }) }}
        {% else %}
          {{ form_row(form.accountType, { label_attr: { class: 'form-label small fw-medium' } }) }}
        {% endif %}
      </div>
      <div class="col-md-6">
        {{ form_row(form.isActive, { label_attr: { class: 'form-label small fw-medium' } }) }}
      </div>
    </div>

    <div class="mt-3">
      {{ form_row(form.telephone, { label_attr: { class: 'form-label small fw-medium' } }) }}
    </div>

    <div class="mt-3">
      {{ form_row(form.genre, { label_attr: { class: 'form-label small fw-medium' } }) }}
    </div>

    {% if form.password is defined %}
    <div class="mt-3">
      {{ form_row(form.password, { label_attr: { class: 'form-label small fw-medium' } }) }}
    </div>
    {% endif %}

    <div class="d-flex justify-content-end gap-2 mt-4 pt-2">
      <a href="{{ path('app_user_index') }}" class="btn btn-outline-secondary">Cancel</a>
      <button type="submit" class="btn btn-primary px-4">Save User</button>
    </div>
    {{ form_end(form) }}
  </div>
</div>
