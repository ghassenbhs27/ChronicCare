{% extends 'back/base.html.twig' %}

{% block title %}Modifier utilisateur{% endblock %}
{% block page_title %}Modifier un utilisateur{% endblock %}
{% block page_subtitle %}Mise à jour des informations{% endblock %}

{% block body %}
<div class="container">
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="d-flex gap-2 mt-3">
          <button class="btn btn-primary">
            <i class="bi bi-save2 me-1"></i> Sauvegarder
          </button>
          <a href="{{ path('app_user_index') }}" class="btn btn-light border">Retour</a>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
