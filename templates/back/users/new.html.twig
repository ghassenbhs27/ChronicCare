{% extends 'back/base.html.twig' %}

{% block title %}Ajouter utilisateur{% endblock %}
{% block page_title %}Ajouter un utilisateur{% endblock %}
{% block page_subtitle %}Création depuis l’espace admin{% endblock %}

{% block body %}
<div class="container">
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="d-flex gap-2 mt-3">
          <button class="btn btn-primary">
            <i class="bi bi-check2-circle me-1"></i> Enregistrer
          </button>
          <a href="{{ path('app_user_index') }}" class="btn btn-light border">Annuler</a>
        </div>
      {{ form_end(form) }}
    </div>
  </div>
</div>
{% endblock %}
