<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">
  <title>{% block title %}Back - ChronicCare{% endblock %}</title>

  {# mêmes assets que le front #}
  <link href="{{ asset('assets/vendor/bootstrap/css/bootstrap.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/bootstrap-icons/bootstrap-icons.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/fontawesome-free/css/all.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/aos/aos.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/glightbox/css/glightbox.min.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/vendor/swiper/swiper-bundle.min.css') }}" rel="stylesheet">

  <link href="{{ asset('assets/css/main.css') }}" rel="stylesheet">

  <style>
    .back-shell { min-height: 100vh; background: #f8fafc; }
    .back-sidebar {
      width: 260px; background: #fff; border-right: 1px solid rgba(100,116,139,.12);
      position: sticky; top: 0; height: 100vh; padding: 18px;
    }
    .back-content { padding: 28px; }
    .back-brand { font-weight: 900; color: #0f172a; display:flex; align-items:center; gap:10px; }
    .back-nav a{
      display:flex; align-items:center; gap:10px;
      padding: 10px 12px; border-radius: 12px; color:#0f172a; text-decoration:none;
    }
    .back-nav a:hover { background: rgba(13,110,253,.08); }
    .back-nav .active { background: rgba(13,110,253,.12); color:#0d6efd; font-weight: 800; }
    .back-topbar{
      background:#fff; border: 1px solid rgba(100,116,139,.12);
      border-radius: 16px; padding: 14px 18px;
      display:flex; justify-content:space-between; align-items:center;
      box-shadow: 0 14px 30px rgba(16,24,40,.06);
    }
  </style>

  {% block stylesheets %}{% endblock %}
</head>

<body>
<div class="back-shell d-flex">

  <aside class="back-sidebar">
    <div class="back-brand mb-4">
      <i class="bi bi-grid-fill"></i>
      <span>ChronicCare • Admin</span>
    </div>

    <nav class="back-nav d-grid gap-2">
      <a href="{{ path('admin_dashboard') }}" class="{% if app.request.get('_route') starts with 'admin_dashboard' %}active{% endif %}">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>
      <a href="{{ path('app_user_index') }}" class="{% if app.request.get('_route') starts with 'app_user_' %}active{% endif %}">
        <i class="bi bi-people"></i> Utilisateurs
      </a>
      <a href="{{ path('index') }}">
        <i class="bi bi-arrow-left"></i> Retour au site
      </a>
    </nav>

    <hr class="my-4">

    <div class="small text-muted">
      Connecté : <b>{{ app.user ? app.user.fullName : '' }}</b>
    </div>
  </aside>

  <main class="flex-grow-1">
    <div class="back-content">

      <div class="back-topbar mb-4">
        <div>
          <h5 class="mb-0">{% block page_title %}Back office{% endblock %}</h5>
          <div class="text-muted small">{% block page_subtitle %}{% endblock %}</div>
        </div>

        <div class="d-flex align-items-center gap-2">
          <a class="btn btn-outline-secondary btn-sm" href="{{ path('index') }}">
            <i class="bi bi-house"></i>
          </a>
          <a class="btn btn-outline-danger btn-sm" href="{{ path('app_logout') }}">
            <i class="bi bi-box-arrow-right"></i>
          </a>
        </div>
      </div>

      {% for label, messages in app.flashes %}
        {% for message in messages %}
          <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
          </div>
        {% endfor %}
      {% endfor %}

      {% block body %}{% endblock %}
    </div>
  </main>
</div>

<script src="{{ asset('assets/vendor/bootstrap/js/bootstrap.bundle.min.js') }}"></script>
<script src="{{ asset('assets/vendor/aos/aos.js') }}"></script>
<script src="{{ asset('assets/js/main.js') }}"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
