{% extends 'back/base.html.twig' %}

{% block title %}Gestion des événements - Chronic Care{% endblock %}
{% block page_title %}Gestion des événements{% endblock %}
{% block page_subtitle %}Liste globale, validation des événements créés par les coachs{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
      <h2 class="mb-1">Événements</h2>
      <p class="text-muted mb-0 small">Tous les événements, validation et participants</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
      {% if pending_count > 0 %}
        <a href="{{ path('admin_evenement_validation') }}" class="btn btn-warning btn-sm">
          <i class="bi bi-clock-history me-1"></i> En attente ({{ pending_count }})
        </a>
      {% endif %}
      <a href="{{ path('admin_evenement_stats') }}" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-bar-chart-line me-1"></i> Statistiques
      </a>
      <a href="{{ path('admin_evenement_export_all_participants') }}" class="btn btn-outline-success btn-sm">
        <i class="bi bi-download me-1"></i> Export tous participants
      </a>
    </div>
  </div>

  {# Filtres par statut #}
  <ul class="nav nav-tabs mb-3">
    <li class="nav-item">
      <a class="nav-link {{ statut_filter is null or statut_filter == '' ? 'active' : '' }}" href="{{ path('admin_evenement_index') }}">Tous</a>
    </li>
    <li class="nav-item">
      <a class="nav-link {{ statut_filter == 'en_attente' ? 'active' : '' }}" href="{{ path('admin_evenement_index', { statut: 'en_attente' }) }}">En attente</a>
    </li>
    <li class="nav-item">
      <a class="nav-link {{ statut_filter == 'valide' ? 'active' : '' }}" href="{{ path('admin_evenement_index', { statut: 'valide' }) }}">Validés</a>
    </li>
    <li class="nav-item">
      <a class="nav-link {{ statut_filter == 'refuse' ? 'active' : '' }}" href="{{ path('admin_evenement_index', { statut: 'refuse' }) }}">Refusés</a>
    </li>
  </ul>

  <div class="card border-0 shadow-sm">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Titre</th>
            <th>Coach</th>
            <th>Dates</th>
            <th>Lieu</th>
            <th>Statut</th>
            <th>Participants</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for evenement in evenements %}
            <tr>
              <td>
                <a href="{{ path('admin_evenement_show', { id: evenement.id }) }}" class="fw-semibold text-decoration-none">{{ evenement.titre }}</a>
              </td>
              <td>{{ evenement.coach ? evenement.coach.fullName : '—' }}</td>
              <td class="small">
                {{ evenement.dateDebut|date('d/m/Y H:i') }} → {{ evenement.dateFin|date('d/m/Y H:i') }}
              </td>
              <td>{{ evenement.lieu }}</td>
              <td>
                {% if evenement.statut == 'en_attente' %}
                  <span class="badge bg-warning text-dark">En attente</span>
                {% elseif evenement.statut == 'valide' %}
                  <span class="badge bg-success">Validé</span>
                {% else %}
                  <span class="badge bg-secondary">Refusé</span>
                {% endif %}
              </td>
              <td>{{ inscription_counts[evenement.id] ?? 0 }}</td>
              <td class="text-end">
                <div class="btn-group btn-group-sm">
                  <a href="{{ path('admin_evenement_show', { id: evenement.id }) }}" class="btn btn-outline-primary" title="Voir">Voir</a>
                  <a href="{{ path('admin_evenement_export_participants', { id: evenement.id }) }}" class="btn btn-outline-success" title="Export CSV">Export</a>
                  {% if evenement.isEnAttente %}
                    <form action="{{ path('admin_evenement_valider', { id: evenement.id }) }}" method="post" class="d-inline">
                      <input type="hidden" name="_token" value="{{ csrf_token('valider_evenement_' ~ evenement.id) }}">
                      <button type="submit" class="btn btn-success btn-sm">Valider</button>
                    </form>
                    <form action="{{ path('admin_evenement_refuser', { id: evenement.id }) }}" method="post" class="d-inline">
                      <input type="hidden" name="_token" value="{{ csrf_token('refuser_evenement_' ~ evenement.id) }}">
                      <button type="submit" class="btn btn-outline-danger btn-sm">Refuser</button>
                    </form>
                  {% endif %}
                </div>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="7" class="text-center text-muted py-4">Aucun événement.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>

  {% if pages > 1 %}
    <nav class="mt-3">
      <ul class="pagination pagination-sm justify-content-center">
        <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
          <a class="page-link" href="{{ path('admin_evenement_index', { statut: statut_filter, page: page - 1 }) }}">Préc.</a>
        </li>
        {% for p in 1..pages %}
          <li class="page-item {{ p == page ? 'active' : '' }}">
            <a class="page-link" href="{{ path('admin_evenement_index', { statut: statut_filter, page: p }) }}">{{ p }}</a>
          </li>
        {% endfor %}
        <li class="page-item {{ page >= pages ? 'disabled' : '' }}">
          <a class="page-link" href="{{ path('admin_evenement_index', { statut: statut_filter, page: page + 1 }) }}">Suiv.</a>
        </li>
      </ul>
    </nav>
  {% endif %}
</div>
{% endblock %}
