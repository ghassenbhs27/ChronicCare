{% extends 'back/base.html.twig' %}

{% block title %}Validation des événements - Chronic Care{% endblock %}
{% block page_title %}Validation des événements{% endblock %}
{% block page_subtitle %}Événements créés par les coachs en attente de validation{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <a href="{{ path('admin_evenement_index') }}" class="btn btn-outline-secondary btn-sm">
      <i class="bi bi-arrow-left me-1"></i> Retour à la liste
    </a>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-light">
      <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>En attente ({{ evenements|length }})</h5>
    </div>
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th>Titre</th>
            <th>Coach</th>
            <th>Dates</th>
            <th>Lieu</th>
            <th>Créé le</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for evenement in evenements %}
            <tr>
              <td class="fw-semibold">{{ evenement.titre }}</td>
              <td>{{ evenement.coach ? evenement.coach.fullName : '—' }}</td>
              <td class="small">{{ evenement.dateDebut|date('d/m/Y H:i') }} → {{ evenement.dateFin|date('d/m/Y H:i') }}</td>
              <td>{{ evenement.lieu }}</td>
              <td class="small">{{ evenement.createdAt|date('d/m/Y H:i') }}</td>
              <td class="text-end">
                <a href="{{ path('admin_evenement_show', { id: evenement.id }) }}" class="btn btn-outline-primary btn-sm me-1">Voir</a>
                <form action="{{ path('admin_evenement_valider', { id: evenement.id }) }}" method="post" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('valider_evenement_' ~ evenement.id) }}">
                  <button type="submit" class="btn btn-success btn-sm">Valider</button>
                </form>
                <form action="{{ path('admin_evenement_refuser', { id: evenement.id }) }}" method="post" class="d-inline">
                  <input type="hidden" name="_token" value="{{ csrf_token('refuser_evenement_' ~ evenement.id) }}">
                  <button type="submit" class="btn btn-outline-danger btn-sm">Refuser</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucun événement en attente.</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
