{% extends 'base.html.twig' %}

{% block title %}Catalogue - ChronicCare{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1>Catalogue Produits</h1>

    <!-- Recherche et Filtres -->
    <div class="row mb-4">
        <div class="col-md-8">
            <form action="{{ path('produit_search') }}" method="GET" class="form-inline">
                <input type="text" name="keyword" placeholder="Rechercher..." class="form-control mr-2" style="width: 300px;">
                
                <select name="categorie" class="form-control mr-2">
                    <option value="">-- Toutes catégories --</option>
                    {% for cat in categories %}
                        <option value="{{ cat.categorie }}">{{ cat.categorie }}</option>
                    {% endfor %}
                </select>

                <button type="submit" class="btn btn-primary">Rechercher</button>
            </form>
        </div>
    </div>

    <!-- Liste Produits -->
    <div class="row">
        {% for produit in produits %}
        <div class="col-md-4 mb-4">
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">{{ produit.nom }}</h5>
                    <p class="card-text">{{ produit.description|slice(0, 50) }}...</p>
                    
                    <div class="d-flex justify-content-between">
                        <span class="badge badge-info">{{ produit.categorie }}</span>
                        <strong>{{ produit.prix }} €</strong>
                    </div>

                    <p class="mt-2">
                        <small>Stock: {{ produit.stock }}</small>
                    </p>

                    <div class="mt-3">
                        <a href="{{ path('produit_show', {id: produit.id}) }}" class="btn btn-sm btn-info">Détails</a>
                        <a href="{{ path('cart_add', {id: produit.id}) }}?quantity=1" class="btn btn-sm btn-success">Ajouter</a>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="col-12">
            <p class="alert alert-info">Aucun produit disponible</p>
        </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
