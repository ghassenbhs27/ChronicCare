{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} - ChronicCare{% endblock %}

{% block content %}
<main class="main">
  <!-- Modal Ajout au Panier -->
  <div id="cartSuccessModal" class="modal" tabindex="-1" style="display:none; position:fixed; z-index:1050; left:0; top:0; width:100vw; height:100vh; overflow:auto; background:rgba(0,0,0,0.5);">
    <div class="modal-dialog" style="max-width:600px; margin:5% auto;">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Produit ajouté au panier avec succès</h5>
          <button type="button" class="btn-close" aria-label="Close" onclick="closeCartSuccessModal()"></button>
        </div>
        <div class="modal-body d-flex align-items-center">
          <img id="cartSuccessImage" src="" alt="Produit" style="width:120px; height:120px; object-fit:contain; margin-right:24px;">
          <div>
            <div id="cartSuccessName" style="font-weight:bold;"></div>
            <div id="cartSuccessPrice"></div>
            <div id="cartSuccessDetails"></div>
            <div id="cartSuccessQuantity"></div>
            <div class="mt-2" id="cartSuccessMessage" style="color:green; font-weight:bold;"></div>
          </div>
        </div>
        <div class="modal-footer">
          <div class="me-auto">
            <span id="cartSuccessTotal"></span>
          </div>
          <button type="button" class="btn btn-secondary" onclick="closeCartSuccessModal()">Continuer mes achats</button>
          <a href="/cart" class="btn btn-success">Commander</a>
        </div>
      </div>
    </div>
  </div>
  <!-- Product Details Section -->
  <section class="product-details section py-5">
    <div class="container">
      <div class="row g-5 align-items-center">
        
        <!-- Product Image Left Side -->
        <div class="col-lg-5">
          <div class="product-image-container">
            <div class="product-image-wrapper" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); border-radius: 10px; padding: 30px; display: flex; align-items: center; justify-content: center; min-height: 500px;">
              <img 
                src="{{ asset('assets/img/products/' ~ produit.nom|lower|replace({' ': '-', 'é': 'e', 'è': 'e', 'ê': 'e', 'à': 'a'}) ~ '.jpg') }}" 
                alt="{{ produit.nom }}"
                style="max-width: 100%; max-height: 450px; object-fit: contain;"
                onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';"
              >
              <div style="display: none; width: 100%; height: 100%; align-items: center; justify-content: center; color: white; font-size: 24px; font-weight: bold; text-align: center;">
                {{ produit.nom }}
              </div>
            </div>
          </div>
        </div>

        <!-- Product Info Right Side -->
        <div class="col-lg-7">
          <div class="product-info">
            <!-- Header -->
            <div class="product-header mb-4">
              <div class="d-flex justify-content-between align-items-start">
                <div>
                  <h1 class="mb-2" style="font-size: 2rem; font-weight: 700; color: #333;">{{ produit.nom }}</h1>
                  <span class="badge bg-primary">{{ produit.categorie }}</span>
                </div>
                <button class="btn btn-outline-danger btn-sm" onclick="toggleWishlist()">
                  <i class="fa fa-heart-o"></i> Favoris
                </button>
              </div>
            </div>

            <!-- Rating & Review -->
            <div class="product-rating mb-3">
              <div class="d-flex align-items-center gap-2">
                <div class="stars">
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star-half-o" style="color: #ffc107;"></i>
                </div>
                <span class="text-muted">(324 avis)</span>
              </div>
            </div>

            <!-- Price Section -->
            <div class="product-price mb-4 p-3 bg-light rounded-3">
              <div class="d-flex align-items-baseline gap-2">
                <h2 style="font-size: 2.5rem; font-weight: 700; color: #0d6efd; margin: 0;">
                  {{ produit.prix }}€
                </h2>
                <span class="text-muted text-decoration-line-through">{{ (produit.prix * 1.2)|number_format(2, ',', '.') }}€</span>
                <span class="badge bg-success">-10%</span>
              </div>
              <small class="text-muted">TVA incluse - Livraison gratuite à partir de 100€</small>
            </div>

            <!-- Stock Status -->
            <div class="stock-status mb-4">
              {% if produit.stock > 10 %}
                <div class="alert alert-success mb-2 py-2">
                  <i class="fa fa-check-circle"></i> 
                  <strong>{{ produit.stock }} en stock</strong> - Livraison rapide
                </div>
              {% elseif produit.stock > 0 %}
                <div class="alert alert-warning mb-2 py-2">
                  <i class="fa fa-exclamation-triangle"></i> 
                  <strong>Stock limité:</strong> {{ produit.stock }} unité(s) disponible(s)
                </div>
              {% else %}
                <div class="alert alert-danger mb-2 py-2">
                  <i class="fa fa-times-circle"></i> 
                  <strong>Rupture de stock</strong> - Réapprovisionnement prévu
                </div>
              {% endif %}
            </div>

            <!-- Add to Cart Form -->
            <form id="addToCartForm" class="product-form mb-5">
              <!-- Quantity Selector -->
              <div class="quantity-selector mb-4">
                <label class="form-label fw-bold mb-2">Quantité</label>
                <div class="input-group" style="width: 150px;">
                  <button class="btn btn-outline-secondary" type="button" onclick="decreaseQuantity()">
                    <i class="fa fa-minus"></i>
                  </button>
                  <input type="number" id="quantity" name="quantity" class="form-control text-center fw-bold" value="1" min="1" max="{{ produit.stock }}" style="font-size: 1.2rem;">
                  <button class="btn btn-outline-secondary" type="button" onclick="increaseQuantity({{ produit.stock }})">
                    <i class="fa fa-plus"></i>
                  </button>
                </div>
              </div>

              <!-- Action Buttons -->
              <div class="d-grid gap-3 mb-3">
                {% if produit.stock > 0 %}
                  <button type="button" class="btn btn-lg btn-success rounded-pill fw-bold" onclick="ajouterAuPanierDirectly({{ produit.id }}, '{{ produit.nom }}')">
                    <i class="fa fa-shopping-cart me-2"></i> Ajouter au panier
                  </button>
                  <button type="button" class="btn btn-lg btn-warning rounded-pill fw-bold" onclick="achatExpress()">
                    <i class="fa fa-lightning me-2"></i> Achat express
                  </button>
                {% else %}
                  <button type="button" class="btn btn-lg btn-secondary rounded-pill fw-bold" disabled>
                    <i class="fa fa-ban me-2"></i> Indisponible
                  </button>
                  <button type="button" class="btn btn-lg btn-outline-primary rounded-pill fw-bold">
                    <i class="fa fa-bell me-2"></i> Me notifier à la réappro
                  </button>
                {% endif %}
              </div>
            </form>

            <!-- Trust Badges -->
            <div class="trust-badges d-flex gap-3 flex-wrap">
              <div class="badge-item text-center">
                <i class="fa fa-shield" style="font-size: 1.5rem; color: #0d6efd;"></i>
                <small>Paiement sécurisé</small>
              </div>
              <div class="badge-item text-center">
                <i class="fa fa-truck" style="font-size: 1.5rem; color: #0d6efd;"></i>
                <small>Livraison 24-48h</small>
              </div>
              <div class="badge-item text-center">
                <i class="fa fa-undo" style="font-size: 1.5rem; color: #0d6efd;"></i>
                <small>Retour 30 jours</small>
              </div>
              <div class="badge-item text-center">
                <i class="fa fa-headphones" style="font-size: 1.5rem; color: #0d6efd;"></i>
                <small>Support 24/7</small>
              </div>
            </div>

            <!-- Back Button -->
            <a href="{{ path('produit_list') }}" class="btn btn-link mt-4">
              <i class="fa fa-arrow-left me-2"></i> Retour au catalogue
            </a>
          </div>
        </div>
      </div>

      <!-- Description & Details Section -->
      <div class="row mt-5">
        <div class="col-12">
          <!-- Description -->
          <div class="description-content mb-5 p-4 bg-light rounded-3">
            <h3 class="mb-3">📌 Description du produit</h3>
            <p class="lead">{{ produit.description }}</p>
            <hr>
            <p>Ce produit a été sélectionné par nos experts pour sa qualité et ses bénéfices prouvés scientifiquement. 
              Il répond aux normes les plus strictes de contrôle qualité.</p>
          </div>

          <!-- Benefits -->
          <div class="benefits-content mb-5">
            <h3 class="mb-3">✨ Bénéfices principaux</h3>
            <div class="row">
              <div class="col-md-6 mb-3">
                <div class="benefit-item p-3 bg-light rounded-3">
                  <h5 class="mb-2"><i class="fa fa-check-circle text-success me-2"></i> Efficacité prouvée</h5>
                  <p>Résultats visibles dans les 2-4 semaines d'utilisation régulière</p>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <div class="benefit-item p-3 bg-light rounded-3">
                  <h5 class="mb-2"><i class="fa fa-check-circle text-success me-2"></i> 100% naturel</h5>
                  <p>Ingrédients sélectionnés biologiques et éco-responsables</p>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <div class="benefit-item p-3 bg-light rounded-3">
                  <h5 class="mb-2"><i class="fa fa-check-circle text-success me-2"></i> Pas d'effets secondaires</h5>
                  <p>Contrôle dermatologique et toxicologique complet</p>
                </div>
              </div>
              <div class="col-md-6 mb-3">
                <div class="benefit-item p-3 bg-light rounded-3">
                  <h5 class="mb-2"><i class="fa fa-check-circle text-success me-2"></i> Livré rapidement</h5>
                  <p>Frais de port gratuit à partir de 100€ d'achat</p>
                </div>
              </div>
            </div>
          </div>

          <!-- Specifications -->
          <div class="specs-content mb-5 p-4 bg-light rounded-3">
            <h3 class="mb-3">📊 Caractéristiques techniques</h3>

          <!-- Modal Achat Express -->
          <div id="achatExpressModal" class="modal" tabindex="-1" style="display:none; position:fixed; z-index:1050; left:0; top:0; width:100vw; height:100vh; overflow:auto; background:rgba(0,0,0,0.5);">
            <div class="modal-dialog" style="max-width:500px; margin:5% auto;">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">COMMANDE EN UN CLIC</h5>
                  <button type="button" class="btn-close" aria-label="Close" onclick="closeAchatExpressModal()"></button>
                </div>
                <div class="modal-body">
                  <p>Nos experts vous appelleront et vous préciseront les détails de la commande !</p>
                  <form>
                    <div class="mb-3">
                      <label class="form-label">Nom <span class="text-danger">*</span></label>
                      <input type="text" class="form-control" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Prénom</label>
                      <input type="text" class="form-control">
                    </div>
                    <div class="mb-3">
                      <label class="form-label">E-mail <span class="text-danger">*</span></label>
                      <input type="email" class="form-control" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Téléphone <span class="text-danger">*</span></label>
                      <input type="tel" class="form-control" required>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">État</label>
                      <select class="form-select">
                        <option>Choisir</option>
                        <option>Tunis</option>
                        <option>Ariana</option>
                        <option>Ben Arous</option>
                        <option>...</option>
                      </select>
                    </div>
                    <div class="mb-3">
                      <label class="form-label">Adresse <span class="text-danger">*</span></label>
                      <input type="text" class="form-control" required>
                    </div>
                  </form>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" onclick="closeAchatExpressModal()">Annuler</button>
                  <button type="button" class="btn btn-success">Commander</button>
                </div>
              </div>
            </div>
          </div>

          <script>
          function achatExpress() {
            document.getElementById('achatExpressModal').style.display = 'block';
          }
          function closeAchatExpressModal() {
            document.getElementById('achatExpressModal').style.display = 'none';
          }
          // Fermer le modal si on clique en dehors
          window.onclick = function(event) {
            var modal = document.getElementById('achatExpressModal');
            if (event.target === modal) {
              closeAchatExpressModal();
            }
          }
          </script>
            <table class="table table-borderless">
              <tr>
                <td class="fw-bold" style="width: 30%;">Catégorie:</td>
                <td>{{ produit.categorie }}</td>
              </tr>
              <tr>
                <td class="fw-bold">Prix:</td>
                <td style="font-size: 1.3rem; color: #0d6efd; font-weight: 700;">{{ produit.prix }}€</td>
              </tr>
              <tr>
                <td class="fw-bold">Stock disponible:</td>
                <td>{{ produit.stock }} unité(s)</td>
              </tr>
              <tr>
                <td class="fw-bold">Statut:</td>
                <td>
                  {% if produit.isActive %}
                    <span class="badge bg-success">Disponible à la vente</span>
                  {% else %}
                    <span class="badge bg-secondary">Indisponible</span>
                  {% endif %}
                </td>
              </tr>
              <tr>
                <td class="fw-bold">Avis clients:</td>
                <td>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star" style="color: #ffc107;"></i>
                  <i class="fa fa-star-half-o" style="color: #ffc107;"></i>
                  4.5/5 (324 avis)
                </td>
              </tr>
            </table>
          </div>

          <!-- Reviews -->
          <div class="reviews-content p-4 bg-light rounded-3">
            <h3 class="mb-4">💬 Avis des clients (4.5/5 - 324 avis)</h3>
            
            <div class="review-item p-3 border-bottom">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <strong>Marie D.</strong>
                  <div class="stars">
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                  </div>
                </div>
                <small class="text-muted">Il y a 2 jours</small>
              </div>
              <p class="mb-0">Excellent produit! J'ai vu les résultats après 3 semaines d'utilisation. Très satisfaite!</p>
            </div>

            <div class="review-item p-3">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <div>
                  <strong>Jean P.</strong>
                  <div class="stars">
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                    <i class="fa fa-star" style="color: #ffc107;"></i>
                  </div>
                </div>
                <small class="text-muted">Il y a 1 semaine</small>
              </div>
              <p class="mb-0">Bon rapport qualité-prix. Livraison rapide et bien emballé.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<script>
  function decreaseQuantity() {
    const input = document.getElementById('quantity');
    if (input && input.value > 1) {
      input.value--;
    }
  }

  function increaseQuantity(max) {
    const input = document.getElementById('quantity');
    if (input && input.value < max) {
      input.value++;
    }
  }

  function ajouterAuPanierDirectly(productId, productName) {
    const quantityInput = document.getElementById('quantity');
    const quantity = quantityInput ? quantityInput.value : 1;
    fetch(window.location.origin + '/cart/add?id=' + productId + '&quantity=' + quantity, {
      method: 'GET',
      headers: {
        'X-Requested-With': 'XMLHttpRequest'
      }
    })
    .then(response => response.json())
    .then(data => {
      if (data.success) {
        // Remplir le modal avec les infos du produit
        document.getElementById('cartSuccessImage').src = document.querySelector('.product-image-wrapper img').src;
        document.getElementById('cartSuccessName').textContent = productName;
        document.getElementById('cartSuccessPrice').textContent = 'Prix unitaire : ' + data.price + ' €';
        document.getElementById('cartSuccessDetails').textContent = data.details || '';
        document.getElementById('cartSuccessQuantity').textContent = 'Quantité : ' + quantity;
        document.getElementById('cartSuccessMessage').textContent = data.cartMessage || 'Il y a ' + data.cartCount + ' articles dans votre panier.';
        document.getElementById('cartSuccessTotal').textContent = 'Total : ' + data.cartTotal + ' €';
        document.getElementById('cartSuccessModal').style.display = 'block';
      } else {
        alert('Erreur: ' + (data.message || 'Impossible d\'ajouter au panier'));
      }
    })
    .catch(error => {
      console.error('Erreur:', error);
      alert('Erreur lors de l\'ajout au panier');
    });
  }

  function closeCartSuccessModal() {
    document.getElementById('cartSuccessModal').style.display = 'none';
  }

  // (Supprimé: alert Redirection vers le paiement...)

  function toggleWishlist() {
    alert('Article ajouté aux favoris!');
  }
</script>

<style>
  .product-details {
    padding: 40px 0;
  }

  .benefit-item {
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .benefit-item:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  .badge-item {
    padding: 10px;
  }

  .stars {
    display: inline-flex;
    gap: 0.2rem;
  }

  .review-item {
    border-bottom: 1px solid #ddd;
  }
</style>
{% endblock %}
