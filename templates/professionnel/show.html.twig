{% extends 'base.html.twig' %}

{% block title %}{{ professionnel.prenom }} {{ professionnel.nom }} - Chronic Care{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css">
  <style>
    .rdv-legend { display: flex; gap: 16px; flex-wrap: wrap; }
    .rdv-legend__item { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; }
    .rdv-legend__swatch { width: 18px; height: 18px; border-radius: 4px; border: 1px solid rgba(0,0,0,.1); }
  </style>
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <a href="{{ path('professionnels_list') }}" class="btn btn-outline-secondary mb-3">&larr; Retour</a>

      <div class="card mb-4">
        <div class="card-body">
          <h2 class="mb-2">{{ professionnel.prenom }} {{ professionnel.nom }}</h2>
          <p class="text-muted">{{ professionnel.email }}</p>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <h5>Choisir une date</h5>
          <p class="text-muted">Selectionnez une date (sans horaire). L'horaire sera choisi a l'etape suivante.</p>

          <div class="rdv-legend mb-3">
            <div class="rdv-legend__item">
              <span class="rdv-legend__swatch" style="background:#fff3cd"></span>
              <span>Jour ferie (Tunisie)</span>
            </div>
            <div class="rdv-legend__item">
              <span class="rdv-legend__swatch" style="background:#f8d7da"></span>
              <span>Date avec RDV reserves</span>
            </div>
          </div>

          <div id="rdv-date-calendar"></div>
        </div>
      </div>
    </div>
  </main>
{% endblock %}

{% block javascripts %}
  {{ parent() }}
  <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
  <script>
    (function () {
      const el = document.getElementById('rdv-date-calendar');
      if (!el || typeof FullCalendar === 'undefined') return;

      const holidayDates = {{ holidayDates|json_encode|raw }};
      const reservedDates = {{ reservedDates|json_encode|raw }};
      const targetBase = "{{ app.user and is_granted('ROLE_USER') ? path('patient_rdv_new', { id: professionnel.id }) : path('connexion') }}";

      const holidayEvents = holidayDates.map(date => ({
        start: date,
        end: new Date(new Date(date).getTime() + 24*60*60*1000).toISOString().slice(0,10),
        allDay: true,
        display: 'background',
        backgroundColor: '#fff3cd',
        borderColor: '#ffecb5'
      }));

      const reservedEvents = reservedDates.map(date => ({
        start: date,
        end: new Date(new Date(date).getTime() + 24*60*60*1000).toISOString().slice(0,10),
        allDay: true,
        display: 'background',
        backgroundColor: '#f8d7da',
        borderColor: '#f5c2c7'
      }));

      const today = new Date().toISOString().slice(0, 10);

      const calendar = new FullCalendar.Calendar(el, {
        initialView: 'dayGridMonth',
        locale: 'fr',
        height: 'auto',
        validRange: { start: today },
        weekends: false,
        events: [...holidayEvents, ...reservedEvents],
        dateClick: function (info) {
          const dateStr = info.dateStr;
          const day = new Date(dateStr + 'T00:00:00');
          const dayOfWeek = day.getDay();
          if (dayOfWeek === 0 || dayOfWeek === 6) return;
          if (holidayDates.includes(dateStr)) return;
          if (targetBase.includes('/connexion')) {
            window.location.href = targetBase;
            return;
          }
          const url = targetBase + '?date=' + dateStr;
          window.location.href = url;
        }
      });

      calendar.render();
    })();
  </script>
{% endblock %}
