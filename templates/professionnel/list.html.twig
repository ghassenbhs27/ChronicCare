{% extends 'base.html.twig' %}

{% block title %}Professionnels - Chronic Care{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main py-5">
    <div class="container">
      <h1 class="mb-4"><i class="bi bi-search me-2"></i>Professionnels de santé</h1>
      <p class="text-muted mb-4">Recherchez un coach et prenez rendez-vous.</p>

      {% if app.user and is_granted('ROLE_USER') %}
        <div class="d-flex justify-content-end mb-3">
          <a class="btn btn-primary" href="{{ path('patient_rdv_list') }}">Retour à mes RDV</a>
        </div>
      {% endif %}

      {{ form_start(form, { attr: { class: 'row g-3 mb-4', novalidate: 'novalidate' } }) }}
        <div class="col-md-8">
          {{ form_widget(form.q, { attr: { class: 'form-control' } }) }}
        </div>
        <div class="col-md-4">
          <button class="btn btn-primary w-100" type="submit">Rechercher</button>
        </div>
      {{ form_end(form) }}

      {% if professionnels is empty %}
        <p class="text-muted">Aucun professionnel trouvé.</p>
      {% else %}
        <div class="row g-3">
          {% for pro in professionnels %}
            <div class="col-md-6 col-lg-4">
              <div class="card h-100">
                <div class="card-body">
                  <h5 class="card-title">{{ pro.prenom }} {{ pro.nom }}</h5>
                  <p class="card-text text-muted">{{ pro.email }}</p>
                  <a class="btn btn-primary" href="{{ path('professionnels_show', { id: pro.id }) }}">Voir profil</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </main>
{% endblock %}
