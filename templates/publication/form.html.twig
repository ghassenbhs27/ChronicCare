{% extends 'base.html.twig' %}

{% block title %}{{ publication.id ? 'Modifier la publication' : 'Nouvelle publication' }} - Forum Chronic Care{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main forum-form-page">
    <div class="container">
      <nav aria-label="Fil d'Ariane" class="forum-breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
          <li class="breadcrumb-item"><a href="{{ path('publication_index') }}">Forum</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{ publication.id ? 'Modifier' : 'Nouvelle publication' }}</li>
        </ol>
      </nav>

      <div class="forum-form-card">
        <header class="forum-form-header">
          <h1 class="forum-form-title">{{ publication.id ? 'Modifier la publication' : 'Nouvelle publication' }}</h1>
        </header>
        <div class="forum-form-body">
          {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
            {{ form_errors(form) }}
            
            <div class="mb-4">
              {{ form_label(form.titre, 'Titre') }}
              {{ form_widget(form.titre, {'attr': {'class': 'form-control', 'placeholder': 'Ex. : Conseils nutrition pour l\'été'}}) }}
              {{ form_errors(form.titre, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="mb-4">
              {{ form_label(form.categorie, 'Catégorie') }}
              {{ form_widget(form.categorie, {'attr': {'class': 'form-select'}}) }}
              {{ form_errors(form.categorie, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="mb-4">
              {{ form_label(form.contenu, 'Contenu') }}
              {{ form_widget(form.contenu, {'attr': {'class': 'form-control', 'rows': '10', 'placeholder': 'Rédigez le contenu de votre publication...'}}) }}
              {{ form_errors(form.contenu, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="mb-4">
              {{ form_label(form.imageFile, 'Image') }}
              {{ form_widget(form.imageFile, {'attr': {'class': 'form-control', 'accept': 'image/jpeg,image/png'}}) }}
              <small class="form-text text-muted">JPG ou PNG, maximum 2 Mo. Optionnel.</small>
              {% if publication.imageUrl %}
                <div class="mt-3">
                  <p class="mb-2"><strong>Image actuelle :</strong></p>
                  <img src="{{ asset('uploads/forum/' ~ publication.imageUrl) }}" alt="Image de la publication" class="img-thumbnail" style="max-width: 200px;">
                </div>
              {% endif %}
              {{ form_errors(form.imageFile, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="mb-4">
              {{ form_label(form.statut, 'Statut') }}
              {{ form_widget(form.statut, {'attr': {'class': 'form-select'}}) }}
              <p class="form-text text-muted small mt-1">En brouillon, la publication ne sera pas visible par les patients.</p>
              {{ form_errors(form.statut, {'attr': {'class': 'invalid-feedback'}}) }}
            </div>

            <div class="forum-form-actions">
              <a href="{{ path('publication_index') }}" class="btn btn-outline-secondary"><i class="bi bi-x-lg me-1"></i> Annuler</a>
              <button type="submit" class="btn btn-primary">{{ publication.id ? 'Mettre à jour' : 'Publier' }}</button>
            </div>
          {{ form_end(form) }}
        </div>
      </div>
    </div>
  </main>
{% endblock %}
