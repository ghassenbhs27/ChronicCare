{% extends 'base.html.twig' %}

{% block title %}{{ publication.titre }} - Forum Chronic Care{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <link href="{{ asset('assets/css/forum.css') }}" rel="stylesheet">
  <link href="{{ asset('assets/css/comment-editor.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
  {% include 'partials/_navbar.html.twig' %}

  <main class="main forum-page">
    <div class="container">
      {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show forum-alert mb-4" role="alert">
          <i class="bi bi-check-circle me-2"></i>{{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
      {% endfor %}
      {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show forum-alert mb-4" role="alert">
          <i class="bi bi-exclamation-circle me-2"></i>{{ message }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
        </div>
      {% endfor %}

      <nav aria-label="Fil d'Ariane" class="forum-breadcrumb">
        <ol class="breadcrumb mb-0">
          <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
          <li class="breadcrumb-item"><a href="{{ path('publication_index') }}">Forum</a></li>
          <li class="breadcrumb-item active" aria-current="page">{{ publication.titre|length > 45 ? publication.titre|slice(0, 45) ~ '…' : publication.titre }}</li>
        </ol>
      </nav>

      <article class="forum-article">
        <header class="forum-article-header">
          <h1 class="forum-article-title">{{ publication.titre }}</h1>
          <div class="forum-article-meta">
            <span><i class="bi bi-person me-1"></i> {{ publication.auteur ? publication.auteur.nom : 'Anonyme' }}</span>
            <span><i class="bi bi-calendar3 me-1"></i> {{ publication.createdAt|date('d/m/Y à H:i') }}</span>
            <span class="forum-meta-badge badge bg-{{ publication.statut == 'publie' ? 'success' : 'warning' }} text-dark">{{ publication.statut == 'publie' ? 'Publié' : 'Brouillon' }}</span>
          </div>
        </header>
        {% if publication.imageUrl %}
          <div class="forum-article-image mb-4">
            <img src="{{ asset('uploads/forum/' ~ publication.imageUrl) }}" alt="{{ publication.titre }}" class="img-fluid rounded" style="max-width: 100%; height: auto;">
          </div>
        {% endif %}
        <div class="forum-article-body">
          {{ publication.contenu|nl2br }}
        </div>
        <div class="forum-article-stats">
          <span><i class="bi bi-eye me-1"></i> {{ publication.nbVues }} vues</span>
          <button class="publication-like-btn" data-publication-id="{{ publication.id }}" title="J'aime cette publication">
            <i class="bi bi-heart"></i> <span class="like-count">{{ publication.nbLikes }}</span>
          </button>
          <span><i class="bi bi-chat-dots me-1"></i> {{ totalCommentaires }} commentaire(s)</span>
        </div>
        <div class="forum-article-actions">
          <a href="{{ path('publication_index') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Retour au forum</a>
          {% if is_granted('ROLE_COACH') or is_granted('ROLE_NUTRITIONNISTE') or is_granted('ROLE_ADMIN') %}
            <a href="{{ path('publication_edit', {id: publication.id}) }}" class="btn btn-outline-primary">Modifier</a>
            <form method="post" action="{{ path('publication_delete', {id: publication.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette publication ?');">
              <input type="hidden" name="_token" value="{{ csrf_token('delete_' ~ publication.id) }}">
              <button type="submit" class="btn btn-outline-danger">Supprimer</button>
            </form>
          {% endif %}
        </div>
      </article>

      <section class="forum-comments-card" id="comments">
        <div class="forum-comments-header">
          <h2 class="forum-comments-title">
            <i class="bi bi-chat-left-text"></i> Commentaires
            <span class="forum-comments-count">({{ totalCommentaires }})</span>
          </h2>
        </div>

        {% if not can_comment and publication.statut == 'brouillon' %}
          <div class="forum-comment-form-wrap forum-brouillon-notice">
            <p class="text-warning mb-0"><i class="bi bi-pencil-square me-2"></i>Cette publication est en brouillon. Les commentaires sont désactivés jusqu'à sa publication.</p>
          </div>
        {% elseif can_comment and app.user %}
          <div class="forum-comment-form-wrap comment-editor-wrapper">
            <h6 class="mb-3"><i class="bi bi-chat-dots me-1"></i> Ajouter un commentaire</h6>
            <p class="text-muted small mb-3">Partagez votre avis ou posez une question. En tant que patient, vous pouvez commenter les publications des coachs.</p>
            <form method="post" action="{{ path('commentaire_add', {publicationId: publication.id}) }}" id="commentaire_form">
              <input type="hidden" name="_token" value="{{ csrf_token('commentaire_add') }}">
              
              <!-- Main comment textarea -->
              <textarea name="contenu" class="form-control mb-3" rows="4" placeholder="Écrivez votre commentaire..." required minlength="3"></textarea>
              
              <!-- Rich Formatting Toolbar -->
              <div class="comment-toolbar">
                <div class="toolbar-group">
                  <label for="fontStyle">Style de texte</label>
                  <select name="fontStyle" id="fontStyle" class="form-select">
                    <option value="normal">Normal</option>
                    <option value="bold">Gras</option>
                    <option value="italic">Italique</option>
                    <option value="underline">Souligné</option>
                    <option value="strikethrough">Barré</option>
                  </select>
                </div>
                
                <div class="toolbar-group">
                  <label for="fontSize">Taille de police</label>
                  <select name="fontSize" id="fontSize" class="form-select">
                    <option value="medium" selected>Moyen</option>
                    <option value="small">Petit</option>
                    <option value="large">Grand</option>
                  </select>
                </div>
                
                <div class="toolbar-group">
                  <label for="textColor">Couleur du texte</label>
                  <input type="color" name="textColor" id="textColor" class="form-control" style="height: 38px;">
                </div>
                
                <div class="toolbar-group">
                  <button type="button" class="emoji-picker-button" data-emoji-toggle>
                    <i class="bi bi-emoji-smile me-1"></i> Emojis
                  </button>
                </div>
              </div>
              
              <!-- Emoji Picker Container -->
              <div class="emoji-picker-container" id="emoji-picker-container">
                <div class="emoji-grid" id="emoji-grid"></div>
              </div>
              
              <!-- Comment Preview -->
              <div class="comment-preview-wrapper">
                <label class="comment-preview-label">Aperçu :</label>
                <div id="commentaire-preview" class="comment-preview"></div>
              </div>
              
              <!-- Form Controls -->
              <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" name="is_anonymous" id="is_anonymous" value="1">
                <label class="form-check-label" for="is_anonymous">Publier en anonyme</label>
              </div>
              
              <button type="submit" class="btn btn-primary">Publier le commentaire</button>
            </form>
          </div>
        {% elseif can_comment and not app.user %}
          <div class="forum-comment-form-wrap text-center py-4">
            <p class="text-muted mb-0"><a href="{{ path('connexion') }}" class="fw-semibold">Connectez-vous</a> pour participer et commenter.</p>
          </div>
        {% endif %}

        <div class="forum-comments-list">
          {% for commentaire in commentaires %}
            {# Top-level comment #}
            <div class="forum-comment-item" id="comment-{{ commentaire.id }}">
              <div class="forum-comment-avatar" title="{{ commentaire.nomAuteur }}">
                {{ commentaire.nomAuteur|slice(0, 1)|upper }}
              </div>
              <div class="forum-comment-body">
                <div class="forum-comment-head">
                  <span class="forum-comment-author">{{ commentaire.nomAuteur }}</span>
                  <span class="forum-comment-date">{{ commentaire.createdAt|date('d/m/Y à H:i') }}</span>
                  {% if commentaire.updatedAt and commentaire.updatedAt != commentaire.createdAt %}
                    <span class="forum-comment-edited text-muted small">(modifié)</span>
                  {% endif %}
                </div>
                
                {# Calculate inline styles for rich content #}
                {% set commentStyle = '' %}
                {% if commentaire.fontStyle %}
                  {% if commentaire.fontStyle == 'bold' %}
                    {% set commentStyle = commentStyle ~ 'font-weight: bold;' %}
                  {% elseif commentaire.fontStyle == 'italic' %}
                    {% set commentStyle = commentStyle ~ 'font-style: italic;' %}
                  {% elseif commentaire.fontStyle == 'underline' %}
                    {% set commentStyle = commentStyle ~ 'text-decoration: underline;' %}
                  {% elseif commentaire.fontStyle == 'strikethrough' %}
                    {% set commentStyle = commentStyle ~ 'text-decoration: line-through;' %}
                  {% endif %}
                {% endif %}
                
                {% if commentaire.fontSize %}
                  {% if commentaire.fontSize == 'small' %}
                    {% set commentStyle = commentStyle ~ 'font-size: 0.85rem;' %}
                  {% elseif commentaire.fontSize == 'large' %}
                    {% set commentStyle = commentStyle ~ 'font-size: 1.15rem;' %}
                  {% else %}
                    {% set commentStyle = commentStyle ~ 'font-size: 0.95rem;' %}
                  {% endif %}
                {% endif %}
                
                {% if commentaire.textColor %}
                  {% set commentStyle = commentStyle ~ 'color: ' ~ commentaire.textColor ~ ';' %}
                {% endif %}
                
                <div class="forum-comment-text" {% if commentStyle %}style="{{ commentStyle }}"{% endif %}>
                  {{ commentaire.contenu|nl2br }}
                </div>
                
                <div class="forum-comment-actions">
                  <button class="comment-like-btn" data-comment-id="{{ commentaire.id }}" title="J'aime ce commentaire">
                    <i class="bi bi-heart"></i> <span class="like-count">{{ commentaire.likeCount }}</span>
                  </button>
                  
                  {# Reply button #}
                  {% if app.user and can_comment %}
                    <button class="btn btn-sm btn-link reply-btn" data-comment-id="{{ commentaire.id }}">
                      <i class="bi bi-reply"></i> Répondre
                    </button>
                  {% endif %}
                  
                  {# Show reply count if any #}
                  {% if commentaire.hasReplies %}
                    <span class="text-muted small">
                      <i class="bi bi-chat-dots"></i> {{ commentaire.replyCount }} réponse(s)
                    </span>
                  {% endif %}
                  
                  {% if app.user and (commentaire.auteur and commentaire.auteur.id == app.user.id or is_granted('ROLE_COACH') or is_granted('ROLE_NUTRITIONNISTE') or is_granted('ROLE_ADMIN')) %}
                    <a href="{{ path('commentaire_edit', {id: commentaire.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                    <form method="post" action="{{ path('commentaire_delete', {id: commentaire.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_commentaire_' ~ commentaire.id) }}">
                      <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                    </form>
                  {% endif %}
                </div>

                {# Reply form (hidden by default) #}
                {% if app.user and can_comment %}
                  <div class="reply-form-wrapper" id="reply-form-{{ commentaire.id }}" style="display: none;">
                    <form method="post" action="{{ path('commentaire_reply', {parentId: commentaire.id}) }}" class="reply-form">
                      <input type="hidden" name="_token" value="{{ csrf_token('commentaire_reply') }}">
                      <textarea name="contenu" class="form-control mb-2" rows="3" placeholder="Écrivez votre réponse..." required minlength="3"></textarea>
                      <div class="form-check mb-2">
                        <input class="form-check-input" type="checkbox" name="is_anonymous" id="reply_anonymous_{{ commentaire.id }}" value="1">
                        <label class="form-check-label" for="reply_anonymous_{{ commentaire.id }}">Publier en anonyme</label>
                      </div>
                      <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary">Envoyer</button>
                        <button type="button" class="btn btn-sm btn-secondary cancel-reply">Annuler</button>
                      </div>
                    </form>
                  </div>
                {% endif %}

                {# Nested replies #}
                {% if commentaire.hasReplies %}
                  <div class="comment-replies">
                    {% for reply in commentaire.replies %}
                      <div class="forum-comment-item reply-item reply-level-{{ reply.nestingLevel }}">
                        <div class="forum-comment-avatar" title="{{ reply.nomAuteur }}">
                          {{ reply.nomAuteur|slice(0, 1)|upper }}
                        </div>
                        <div class="forum-comment-body">
                          <div class="forum-comment-head">
                            <span class="forum-comment-author">{{ reply.nomAuteur }}</span>
                            <span class="forum-comment-date">{{ reply.createdAt|date('d/m/Y à H:i') }}</span>
                            <span class="text-muted small">
                              <i class="bi bi-reply"></i> Réponse à {{ reply.parent.nomAuteur }}
                            </span>
                          </div>
                          
                          {# Calculate inline styles for reply #}
                          {% set replyStyle = '' %}
                          {% if reply.fontStyle %}
                            {% if reply.fontStyle == 'bold' %}
                              {% set replyStyle = replyStyle ~ 'font-weight: bold;' %}
                            {% elseif reply.fontStyle == 'italic' %}
                              {% set replyStyle = replyStyle ~ 'font-style: italic;' %}
                            {% elseif reply.fontStyle == 'underline' %}
                              {% set replyStyle = replyStyle ~ 'text-decoration: underline;' %}
                            {% elseif reply.fontStyle == 'strikethrough' %}
                              {% set replyStyle = replyStyle ~ 'text-decoration: line-through;' %}
                            {% endif %}
                          {% endif %}
                          
                          {% if reply.fontSize %}
                            {% if reply.fontSize == 'small' %}
                              {% set replyStyle = replyStyle ~ 'font-size: 0.85rem;' %}
                            {% elseif reply.fontSize == 'large' %}
                              {% set replyStyle = replyStyle ~ 'font-size: 1.15rem;' %}
                            {% endif %}
                          {% endif %}
                          
                          {% if reply.textColor %}
                            {% set replyStyle = replyStyle ~ 'color: ' ~ reply.textColor ~ ';' %}
                          {% endif %}
                          
                          <div class="forum-comment-text" {% if replyStyle %}style="{{ replyStyle }}"{% endif %}>
                            {{ reply.contenu|nl2br }}
                          </div>
                          
                          <div class="forum-comment-actions">
                            <button class="comment-like-btn" data-comment-id="{{ reply.id }}">
                              <i class="bi bi-heart"></i> <span class="like-count">{{ reply.likeCount }}</span>
                            </button>
                            
                            {% if app.user and (reply.auteur and reply.auteur.id == app.user.id or is_granted('ROLE_COACH') or is_granted('ROLE_NUTRITIONNISTE') or is_granted('ROLE_ADMIN')) %}
                              <a href="{{ path('commentaire_edit', {id: reply.id}) }}" class="btn btn-sm btn-outline-primary">Modifier</a>
                              <form method="post" action="{{ path('commentaire_delete', {id: reply.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer cette réponse ?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_commentaire_' ~ reply.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                              </form>
                            {% endif %}
                          </div>
                        </div>
                      </div>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </div>
          {% else %}
            <p class="forum-comments-empty">Aucun commentaire pour le moment. Soyez le premier à réagir.</p>
          {% endfor %}
        </div>

        {% if totalPages > 1 %}
          <nav class="forum-comment-pagination" aria-label="Pagination commentaires">
            <ul class="pagination justify-content-center mb-0">
              {% if currentPage > 1 %}
                <li class="page-item">
                  <a class="page-link" href="{{ path('publication_show', {id: publication.id, page: currentPage - 1}) }}#comments">Précédent</a>
                </li>
              {% endif %}
              {% for p in 1..totalPages %}
                <li class="page-item {{ p == currentPage ? 'active' }}">
                  <a class="page-link" href="{{ path('publication_show', {id: publication.id, page: p}) }}#comments">{{ p }}</a>
                </li>
              {% endfor %}
              {% if currentPage < totalPages %}
                <li class="page-item">
                  <a class="page-link" href="{{ path('publication_show', {id: publication.id, page: currentPage + 1}) }}#comments">Suivant</a>
                </li>
              {% endif %}
            </ul>
          </nav>
        {% endif %}
      </section>
    </div>
  </main>

  <style>
    .publication-like-btn,
    .comment-like-btn {
      background: none;
      border: none;
      padding: 0.25rem 0.5rem;
      cursor: pointer;
      font-size: 0.9rem;
      color: var(--forum-meta-color);
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      user-select: none;
    }

    .publication-like-btn:hover,
    .comment-like-btn:hover {
      color: #dc3545;
      transform: scale(1.1);
    }

    .publication-like-btn.liked,
    .comment-like-btn.liked {
      color: #dc3545;
    }

    .publication-like-btn i,
    .comment-like-btn i {
      transition: all 0.2s ease;
      display: inline-block;
    }

    .publication-like-btn.liked i,
    .comment-like-btn.liked i {
      transform: scale(1.2);
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Track liked items in localStorage
      const likedPublications = JSON.parse(localStorage.getItem('likedPublications') || '{}');
      const likedComments = JSON.parse(localStorage.getItem('likedComments') || '{}');

      // Update UI based on localStorage
      Object.keys(likedPublications).forEach(pubId => {
        const btn = document.querySelector(`[data-publication-id="${pubId}"]`);
        if (btn && likedPublications[pubId]) {
          btn.classList.add('liked');
        }
      });

      Object.keys(likedComments).forEach(comId => {
        const btn = document.querySelector(`[data-comment-id="${comId}"]`);
        if (btn && likedComments[comId]) {
          btn.classList.add('liked');
        }
      });

      // Publication like button
      document.querySelectorAll('.publication-like-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const publicationId = this.dataset.publicationId;
          const isLiked = likedPublications[publicationId] || false;
          const action = isLiked ? 'unlike' : 'like';
          const likeCountSpan = this.querySelector('.like-count');

          fetch('{{ path('publication_like', {id: 0}) }}'.replace('/0', '/' + publicationId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: action })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              likedPublications[publicationId] = !isLiked;
              localStorage.setItem('likedPublications', JSON.stringify(likedPublications));
              
              likeCountSpan.textContent = data.likes;
              this.classList.toggle('liked', !isLiked);
            }
          })
          .catch(error => console.error('Error:', error));
        });
      });

      // Comment like button
      document.querySelectorAll('.comment-like-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const commentId = this.dataset.commentId;
          const isLiked = likedComments[commentId] || false;
          const action = isLiked ? 'unlike' : 'like';
          const likeCountSpan = this.querySelector('.like-count');

          fetch('{{ path('commentaire_like', {id: 0}) }}'.replace('/0', '/' + commentId), {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: action })
          })
          .then(response => response.json())
          .then(data => {
            if (data.success) {
              likedComments[commentId] = !isLiked;
              localStorage.setItem('likedComments', JSON.stringify(likedComments));
              
              likeCountSpan.textContent = data.likes;
              this.classList.toggle('liked', !isLiked);
            }
          })
          .catch(error => console.error('Error:', error));
        });
      });

      // Reply button handlers
      document.querySelectorAll('.reply-btn').forEach(btn => {
        btn.addEventListener('click', function() {
          const commentId = this.dataset.commentId;
          const replyForm = document.getElementById('reply-form-' + commentId);
          
          // Hide all other reply forms
          document.querySelectorAll('.reply-form-wrapper').forEach(form => {
            if (form.id !== 'reply-form-' + commentId) {
              form.style.display = 'none';
            }
          });
          
          // Toggle this reply form
          replyForm.style.display = replyForm.style.display === 'none' ? 'block' : 'none';
          
          // Focus on textarea
          if (replyForm.style.display === 'block') {
            replyForm.querySelector('textarea').focus();
          }
        });
      });

      // Cancel reply button handlers
      document.querySelectorAll('.cancel-reply').forEach(btn => {
        btn.addEventListener('click', function() {
          this.closest('.reply-form-wrapper').style.display = 'none';
        });
      });
    });
  </script>

  <script src="{{ asset('assets/js/comment-editor.js') }}"></script>
{% endblock %}
