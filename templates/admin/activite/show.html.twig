{% extends 'back/base.html.twig' %}

{% block page_title %}Activite #{{ activite.id }}{% endblock %}

{% block body %}
<div class="card shadow-sm">
  <div class="card-body">
    <p><strong>Type :</strong> {{ activite.type }}</p>
    <p><strong>Duree :</strong> {{ activite.duree }} min</p>
    <p><strong>Calories :</strong> {{ activite.calories }}</p>
    <p><strong>Distance :</strong> {{ activite.distanceKm is not null ? activite.distanceKm ~ ' km' : '-' }}</p>
    <p><strong>Heures de repos :</strong> {{ activite.heuresRepos is not null ? activite.heuresRepos ~ ' h' : '-' }}</p>
    <p><strong>Date :</strong> {{ activite.dateActivite ? activite.dateActivite|date('d/m/Y') : '' }}</p>
    <p><strong>Utilisateur :</strong> {{ activite.utilisateur ? activite.utilisateur.fullName : '-' }}</p>
    <p><strong>Etat lie :</strong>
      {% if activite.etat %}
        Etat{% if activite.etat.traitementEnCours %} | Trait.: {{ activite.etat.traitementEnCours }}{% endif %}
        ({{ activite.etat.dateReleve ? activite.etat.dateReleve|date('d/m/Y') : '' }})
      {% else %}
        -
      {% endif %}
    </p>
    <a class="btn btn-primary" href="{{ path('admin_activite_edit', {id: activite.id}) }}">Editer</a>
    <a class="btn btn-outline-secondary" href="{{ path('admin_activite_index') }}">Retour</a>
  </div>
</div>
{% endblock %}

