{% extends 'back/base.html.twig' %}

{% block page_title %}Activité #{{ activite.id }}{% endblock %}

{% block body %}
<div class="card shadow-sm">
  <div class="card-body">
    <p><strong>Type :</strong> {{ activite.type }}</p>
    <p><strong>Durée :</strong> {{ activite.duree }} min</p>
    <p><strong>Calories :</strong> {{ activite.calories }}</p>
    <p><strong>Date :</strong> {{ activite.dateActivite ? activite.dateActivite|date('d/m/Y') : '' }}</p>
    <p><strong>Utilisateur :</strong> {{ activite.utilisateur ? activite.utilisateur.fullName : '-' }}</p>
    <a class="btn btn-primary" href="{{ path('admin_activite_edit', {id: activite.id}) }}">Éditer</a>
    <a class="btn btn-outline-secondary" href="{{ path('admin_activite_index') }}">Retour</a>
  </div>
</div>
{% endblock %}
