{% extends 'back/base.html.twig' %}

{% block page_title %}Commandes{% endblock %}
{% block page_subtitle %}Gestion des commandes{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex flex-wrap gap-2 mb-4">
    <a href="{{ path('admin_commande_pending') }}" class="btn btn-warning">En attente</a>
    <a href="{{ path('admin_commande_shipped') }}" class="btn btn-info">Expédiées</a>
    <a href="{{ path('admin_commande_stats') }}" class="btn btn-success">Statistiques</a>
  </div>

  <form method="get" action="{{ path('admin_commande_list') }}" class="row g-2 mb-4">
    <div class="col-auto">
      <select name="statut" class="form-select form-select-sm" style="width:160px;">
        <option value="">Tous les statuts</option>
        <option value="en_attente" {{ statut == 'en_attente' ? 'selected' : '' }}>En attente</option>
        <option value="validée" {{ statut == 'validée' ? 'selected' : '' }}>Validée</option>
        <option value="expédiée" {{ statut == 'expédiée' ? 'selected' : '' }}>Expédiée</option>
        <option value="livrée" {{ statut == 'livrée' ? 'selected' : '' }}>Livrée</option>
        <option value="annulée" {{ statut == 'annulée' ? 'selected' : '' }}>Annulée</option>
      </select>
    </div>
    <div class="col-auto">
      <select name="tri" class="form-select form-select-sm" style="width:140px;">
        <option value="createdAt" {{ tri == 'createdAt' ? 'selected' : '' }}>Date</option>
        <option value="total" {{ tri == 'total' ? 'selected' : '' }}>Total</option>
        <option value="utilisateur" {{ tri == 'utilisateur' ? 'selected' : '' }}>Client</option>
      </select>
    </div>
    <div class="col-auto">
      <select name="direction" class="form-select form-select-sm" style="width:120px;">
        <option value="DESC" {{ direction == 'DESC' ? 'selected' : '' }}>Desc</option>
        <option value="ASC" {{ direction == 'ASC' ? 'selected' : '' }}>Asc</option>
      </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-primary btn-sm">Filtrer</button></div>
  </form>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Numéro</th>
              <th>Client</th>
              <th>Total</th>
              <th>Statut</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for commande in commandes %}
            <tr>
              <td>{{ commande.numeroCommande }}</td>
              <td>{{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</td>
              <td>{{ commande.total }} €</td>
              <td>
                <span class="badge {% if commande.statut == 'livrée' %}bg-success{% elseif commande.statut == 'annulée' %}bg-danger{% elseif commande.statut == 'expédiée' %}bg-info{% else %}bg-warning{% endif %}">{{ commande.statut }}</span>
              </td>
              <td>{{ commande.createdAt|date('d/m/Y H:i') }}</td>
              <td><a href="{{ path('admin_commande_show', {id: commande.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a></td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucune commande</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
