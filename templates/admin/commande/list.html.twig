{% extends 'base.html.twig' %}

{% block title %}Admin - Commandes - ChronicCare{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1>Gestion des Commandes</h1>

    <form method="get" action="{{ path('admin_commande_filter') }}" class="mb-4 d-flex gap-2">
        <select name="statut" class="form-select" style="width: 200px;">
            <option value="">Tous les statuts</option>
            <option value="en_attente" {% if statut == 'en_attente' %}selected{% endif %}>En attente</option>
            <option value="validée" {% if statut == 'validée' %}selected{% endif %}>Validée</option>
            <option value="expédiée" {% if statut == 'expédiée' %}selected{% endif %}>Expédiée</option>
            <option value="livrée" {% if statut == 'livrée' %}selected{% endif %}>Livrée</option>
            <option value="annulée" {% if statut == 'annulée' %}selected{% endif %}>Annulée</option>
        </select>
        <select name="tri" class="form-select" style="width: 150px;">
            <option value="createdAt" {% if tri == 'createdAt' %}selected{% endif %}>Date</option>
            <option value="total" {% if tri == 'total' %}selected{% endif %}>Total</option>
            <option value="utilisateur" {% if tri == 'utilisateur' %}selected{% endif %}>Client</option>
        </select>
        <select name="direction" class="form-select" style="width: 120px;">
            <option value="DESC" {% if direction == 'DESC' %}selected{% endif %}>Décroissant</option>
            <option value="ASC" {% if direction == 'ASC' %}selected{% endif %}>Croissant</option>
        </select>
        <button type="submit" class="btn btn-primary">Filtrer</button>
    </form>

    <a href="{{ path('admin_commande_pending') }}" class="btn btn-warning mb-3">En attente</a>
    <a href="{{ path('admin_commande_shipped') }}" class="btn btn-info mb-3">Expédiées</a>
    <a href="{{ path('admin_commande_stats') }}" class="btn btn-success mb-3">Statistiques</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Numéro</th>
                <th>Client</th>
                <th>Total</th>
                <th>Statut</th>
                <th>Date</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            {% for commande in commandes %}
            <tr>
                <td>{{ commande.numeroCommande }}</td>
                <td>{{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</td>
                <td>{{ commande.total }} €</td>
                <td>
                    <span class="badge 
                        {% if commande.statut == 'en_attente' %}badge-warning
                        {% elseif commande.statut == 'validée' %}badge-info
                        {% elseif commande.statut == 'expédiée' %}badge-primary
                        {% elseif commande.statut == 'livrée' %}badge-success
                        {% else %}badge-danger
                        {% endif %}
                    ">{{ commande.statut }}</span>
                </td>
                <td>{{ commande.createdAt|date('d/m/Y') }}</td>
                <td>
                    <a href="{{ path('admin_commande_show', {id: commande.id}) }}" class="btn btn-sm btn-info">Détails</a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
