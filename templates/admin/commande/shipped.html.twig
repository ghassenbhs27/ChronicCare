{% extends 'back/base.html.twig' %}

{% block page_title %}Commandes expédiées{% endblock %}
{% block page_subtitle %}En cours de livraison{% endblock %}

{% block body %}
<div class="container-fluid">
  <a href="{{ path('admin_commande_list') }}" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Retour</a>

  {% if commandes is empty %}
    <div class="alert alert-info">Aucune commande expédiée</div>
  {% else %}
    <div class="card border-0 shadow-sm">
      <div class="card-body p-0">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Numéro</th>
              <th>Client</th>
              <th>Total</th>
              <th>Date</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for commande in commandes %}
            <tr>
              <td>{{ commande.numeroCommande }}</td>
              <td>{{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</td>
              <td>{{ commande.total }} €</td>
              <td>{{ commande.createdAt|date('d/m/Y H:i') }}</td>
              <td><a href="{{ path('admin_commande_show', {id: commande.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a></td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  {% endif %}
</div>
{% endblock %}
