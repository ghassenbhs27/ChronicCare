{% extends 'back/base.html.twig' %}

{% block page_title %}Commande {{ commande.numeroCommande }}{% endblock %}
{% block page_subtitle %}Détails de la commande{% endblock %}

{% block body %}
<div class="container-fluid">
  <a href="{{ path('admin_commande_list') }}" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Retour</a>

  <div class="row">
    <div class="col-lg-8">
      <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white"><h5 class="mb-0">Articles</h5></div>
        <div class="card-body p-0">
          <table class="table mb-0">
            <thead class="table-light"><tr><th>Produit</th><th>Qté</th><th>Prix unit.</th><th>Sous-total</th></tr></thead>
            <tbody>
              {% for ligne in commande.ligneCommandes %}
              <tr>
                <td>{{ ligne.produit.nom }}</td>
                <td>{{ ligne.quantite }}</td>
                <td>{{ ligne.prixUnitaire }} €</td>
                <td>{{ ligne.sousTotal }} €</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><h5 class="mb-0">Informations</h5></div>
        <div class="card-body">
          <p><strong>Client:</strong> {{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</p>
          <p><strong>Email:</strong> {{ commande.utilisateur.email }}</p>
          <p><strong>Date:</strong> {{ commande.createdAt|date('d/m/Y H:i') }}</p>
          <p><strong>Total:</strong> {{ commande.total }} €</p>
          {% if commande.adresse %}
            <p class="small text-muted"><strong>Adresse:</strong><br>{{ commande.adresse }}</p>
          {% endif %}
          <hr>
          <h6>Changer le statut</h6>
          <form method="post" action="{{ path('admin_commande_change_status', {id: commande.id}) }}">
            <div class="mb-2">
              <select name="status" class="form-select">
                <option value="en_attente" {{ commande.statut == 'en_attente' ? 'selected' : '' }}>En attente</option>
                <option value="validée" {{ commande.statut == 'validée' ? 'selected' : '' }}>Validée</option>
                <option value="expédiée" {{ commande.statut == 'expédiée' ? 'selected' : '' }}>Expédiée</option>
                <option value="livrée" {{ commande.statut == 'livrée' ? 'selected' : '' }}>Livrée</option>
                <option value="annulée" {{ commande.statut == 'annulée' ? 'selected' : '' }}>Annulée</option>
              </select>
            </div>
            <button type="submit" class="btn btn-primary">Mettre à jour</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
