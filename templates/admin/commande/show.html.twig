{% extends 'base.html.twig' %}

{% block title %}Admin - Commande #{{ commande.numeroCommande }} - ChronicCare{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1>Commande #{{ commande.numeroCommande }}</h1>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h5>Informations</h5>
                    <p><strong>Client:</strong> {{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</p>
                    <p><strong>Date:</strong> {{ commande.createdAt|date('d/m/Y H:i') }}</p>
                    <p><strong>Total:</strong> {{ commande.total }} €</p>

                    <hr>

                    <h6>Articles</h6>
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Produit</th>
                                <th>Quantité</th>
                                <th>Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for ligne in commande.ligneCommandes %}
                            <tr>
                                <td>{{ ligne.produit.nom }}</td>
                                <td>{{ ligne.quantite }}</td>
                                <td>{{ ligne.sousTotal }} €</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-body">
                    <h5>Statut</h5>
                    <form method="POST" action="{{ path('admin_commande_change_status', {id: commande.id}) }}">
                        <div class="form-group">
                            <select name="status" class="form-control">
                                <option value="en_attente" {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                                <option value="validée" {% if commande.statut == 'validée' %}selected{% endif %}>Validée</option>
                                <option value="expédiée" {% if commande.statut == 'expédiée' %}selected{% endif %}>Expédiée</option>
                                <option value="livrée" {% if commande.statut == 'livrée' %}selected{% endif %}>Livrée</option>
                                <option value="annulée" {% if commande.statut == 'annulée' %}selected{% endif %}>Annulée</option>
                            </select>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Mettre à jour</button>
                    </form>

                    <a href="{{ path('admin_commande_list') }}" class="btn btn-secondary btn-block mt-3">Retour</a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
