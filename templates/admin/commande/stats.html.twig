{% extends 'back/base.html.twig' %}

{% block page_title %}Statistiques ventes{% endblock %}
{% block page_subtitle %}Dashboard commandes{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <a href="{{ path('admin_commande_list') }}" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Retour</a>
    <a href="{{ path('admin_commande_export_pdf') }}" class="btn btn-danger"><i class="bi bi-file-pdf"></i> Exporter PDF</a>
  </div>

  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5 class="text-muted">Total des ventes</h5>
          <h2 class="text-success mb-0">{{ (totalVentes ?? 0)|number_format(2, ',', ' ') }} €</h2>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <h5 class="text-muted">Commandes par statut</h5>
          <ul class="mb-0">
            {% for stat in countByStatut %}
              <li>{{ stat.statut }}: {{ stat.count }} commande(s)</li>
            {% else %}
              <li class="text-muted">Aucune donnée</li>
            {% endfor %}
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h5 class="mb-0">Commandes récentes</h5></div>
    <div class="card-body p-0">
      <table class="table table-hover mb-0">
        <thead class="table-light">
          <tr>
            <th>Numéro</th>
            <th>Client</th>
            <th>Total</th>
            <th>Statut</th>
            <th>Date</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          {% for commande in recentCommandes %}
          <tr>
            <td>{{ commande.numeroCommande }}</td>
            <td>{{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</td>
            <td>{{ commande.total }} €</td>
            <td><span class="badge bg-primary">{{ commande.statut }}</span></td>
            <td>{{ commande.createdAt|date('d/m/Y H:i') }}</td>
            <td><a href="{{ path('admin_commande_show', {id: commande.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a></td>
          </tr>
          {% else %}
          <tr><td colspan="6" class="text-center text-muted py-4">Aucune commande</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
