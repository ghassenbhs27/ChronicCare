{% extends 'back/base.html.twig' %}

{% block page_title %}Stock faible{% endblock %}
{% block page_subtitle %}Produits avec stock ≤ 10 unités{% endblock %}

{% block body %}
<div class="container-fluid">
  <a href="{{ path('admin_produit_list') }}" class="btn btn-outline-secondary mb-3"><i class="bi bi-arrow-left"></i> Retour</a>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Nom</th>
              <th>Catégorie</th>
              <th>Stock</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for produit in produits %}
            <tr>
              <td>{{ produit.nom }}</td>
              <td>{{ produit.categorie }}</td>
              <td><span class="badge {% if produit.stock == 0 %}bg-danger{% else %}bg-warning{% endif %}">{{ produit.stock }}</span></td>
              <td><a href="{{ path('admin_produit_edit', {id: produit.id}) }}" class="btn btn-sm btn-outline-primary">Éditer</a></td>
            </tr>
            {% else %}
            <tr><td colspan="4" class="text-center text-muted py-4">Aucun produit en stock faible</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
{% endblock %}
