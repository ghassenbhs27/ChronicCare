{% extends 'back/base.html.twig' %}

{% block page_title %}Produits{% endblock %}
{% block page_subtitle %}Gestion du catalogue{% endblock %}

{% block body %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <a href="{{ path('admin_produit_create') }}" class="btn btn-success"><i class="bi bi-plus-lg"></i> Nouveau produit</a>
      <a href="{{ path('admin_produit_low_stock') }}" class="btn btn-warning ms-2"><i class="bi bi-exclamation-triangle"></i> Stock faible</a>
    </div>
    <div>
      <a href="{{ path('admin_import_products') }}" class="btn btn-primary">
        <i class="bi bi-file-earmark-excel me-1"></i> Import Excel
      </a>
      <a href="{{ path('pdf_catalog') }}" class="btn btn-danger ms-2" target="_blank">
        <i class="bi bi-file-earmark-pdf me-1"></i> Catalogue PDF
      </a>
    </div>
  </div>

  <div class="card border-0 shadow-sm">
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Nom</th>
              <th>Catégorie</th>
              <th>Prix</th>
              <th>Stock</th>
              <th>Statut</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for produit in produits %}
            <tr>
              <td>{{ produit.nom }}</td>
              <td>{{ produit.categorie }}</td>
              <td>{{ produit.prix }} €</td>
              <td>
                {% if produit.stock <= 5 %}
                  <span class="badge bg-danger">{{ produit.stock }}</span>
                {% elseif produit.stock <= 20 %}
                  <span class="badge bg-warning text-dark">{{ produit.stock }}</span>
                {% else %}
                  <span class="badge bg-success">{{ produit.stock }}</span>
                {% endif %}
              </td>
              <td>
                <span class="badge {% if produit.isActive %}bg-success{% else %}bg-secondary{% endif %}">
                  {% if produit.isActive %}Actif{% else %}Inactif{% endif %}
                </span>
              </td>
              <td>
                <a href="{{ path('admin_produit_edit', {id: produit.id}) }}" class="btn btn-sm btn-outline-warning" title="Éditer">
                  <i class="bi bi-pencil"></i>
                </a>
                <form action="{{ path('admin_produit_delete', {id: produit.id}) }}" method="post" class="d-inline" onsubmit="return confirm('Supprimer ce produit ?');">
                  <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit.id) }}">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">
                    <i class="bi bi-trash"></i>
                  </button>
                </form>
              </td>
            </tr>
            {% else %}
            <tr><td colspan="6" class="text-center text-muted py-4">Aucun produit</td></tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
    
    {# Pagination #}
    {% if produits.getTotalItemCount > 10 %}
    <div class="card-footer bg-white border-top">
      <div class="d-flex justify-content-between align-items-center">
        <small class="text-muted">
          Affichage {{ produits.currentPageNumber == 1 ? 1 : ((produits.currentPageNumber - 1) * 10) + 1 }}-{{ min(produits.currentPageNumber * 10, produits.getTotalItemCount) }} sur {{ produits.getTotalItemCount }} produits
        </small>
        <nav>
          {{ knp_pagination_render(produits) }}
        </nav>
      </div>
    </div>
    {% endif %}
  </div>
</div>
{% endblock %}
