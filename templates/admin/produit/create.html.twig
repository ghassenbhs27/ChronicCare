{% extends 'base.html.twig' %}

{% block title %}Admin - Créer Produit - ChronicCare{% endblock %}

{% block content %}
<div class="container mt-5">
    <h1>Créer un produit</h1>

    <div class="row mt-4">
        <div class="col-md-8 offset-md-2">
            {{ form_start(form) }}
            {{ form_widget(form) }}
            <button type="submit" class="btn btn-lg btn-success mt-3">Créer</button>
            <a href="{{ path('admin_produit_list') }}" class="btn btn-lg btn-secondary mt-3">Annuler</a>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}
