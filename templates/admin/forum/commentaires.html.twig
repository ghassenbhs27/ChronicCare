{% extends 'back/base.html.twig' %}

{% block title %}Gestion des commentaires - Forum{% endblock %}
{% block page_title %}Gestion des commentaires{% endblock %}
{% block page_subtitle %}Gérer et modérer les commentaires du forum{% endblock %}

{% block body %}
<div class="comments-management">
  {# Header #}
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 mb-1">Commentaires du forum</h2>
      <p class="text-muted small mb-0">{{ totalComments }} commentaire(s) trouvé(s)</p>
    </div>
    <a href="{{ path('admin_forum_dashboard') }}" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Retour au dashboard
    </a>
  </div>

  {# Summary Stats Cards #}
  <div class="row g-3 mb-4">
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-muted small mb-1">Total commentaires</p>
              <h4 class="mb-0 fw-bold">{{ totalComments }}</h4>
            </div>
            <div class="bg-success bg-opacity-10 rounded-3 p-3">
              <i class="bi bi-chat-left-text text-success fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-md-6">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-muted small mb-1">Total likes</p>
              <h4 class="mb-0 fw-bold">{{ totalLikes|number_format(0, '', ' ') }}</h4>
            </div>
            <div class="bg-danger bg-opacity-10 rounded-3 p-3">
              <i class="bi bi-heart text-danger fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# Filters #}
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <form method="get" action="{{ path('admin_forum_comments') }}" class="row g-3">
        <div class="col-md-3">
          <label for="publication" class="form-label small fw-semibold">Publication</label>
          <select name="publication" id="publication" class="form-select">
            <option value="all" {{ publicationId == 'all' ? 'selected' : '' }}>Toutes les publications</option>
            {% for pub in publications %}
              <option value="{{ pub.id }}" {{ publicationId == pub.id|string ? 'selected' : '' }}>
                {{ pub.titre|length > 50 ? pub.titre|slice(0, 50) ~ '...' : pub.titre }}
              </option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <label for="date_from" class="form-label small fw-semibold">Date début</label>
          <input type="date" name="date_from" id="date_from" class="form-control" value="{{ dateFrom }}">
        </div>
        <div class="col-md-2">
          <label for="date_to" class="form-label small fw-semibold">Date fin</label>
          <input type="date" name="date_to" id="date_to" class="form-control" value="{{ dateTo }}">
        </div>
        <div class="col-md-5">
          <label for="search" class="form-label small fw-semibold">Recherche</label>
          <div class="input-group">
            <input type="text" name="q" id="search" class="form-control" placeholder="Contenu, auteur, publication..." value="{{ search }}">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-search"></i>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  {# Comments Table #}
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0">Liste des commentaires</h5>
        <div class="btn-group" role="group">
          <a href="{{ path('admin_forum_comments', {sort: 'createdAt', dir: dir == 'ASC' ? 'DESC' : 'ASC', publication: publicationId, q: search, date_from: dateFrom, date_to: dateTo}) }}" 
             class="btn btn-sm btn-outline-secondary {{ sort == 'createdAt' ? 'active' : '' }}">
            <i class="bi bi-calendar3"></i> Date
            {% if sort == 'createdAt' %}
              <i class="bi bi-arrow-{{ dir == 'ASC' ? 'up' : 'down' }}"></i>
            {% endif %}
          </a>
          <a href="{{ path('admin_forum_comments', {sort: 'likeCount', dir: dir == 'ASC' ? 'DESC' : 'ASC', publication: publicationId, q: search, date_from: dateFrom, date_to: dateTo}) }}" 
             class="btn btn-sm btn-outline-secondary {{ sort == 'likeCount' ? 'active' : '' }}">
            <i class="bi bi-heart"></i> Likes
          </a>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width: 15%;">Auteur</th>
              <th style="width: 35%;">Commentaire</th>
              <th style="width: 25%;">Publication</th>
              <th class="text-center" style="width: 8%;">Likes</th>
              <th style="width: 12%;">Date</th>
              <th class="text-end" style="width: 5%;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for comment in commentaires %}
            <tr>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 32px; height: 32px;">
                    <i class="bi bi-person text-success"></i>
                  </div>
                  <div>
                    <div class="fw-semibold small">{{ comment.nomAuteur }}</div>
                    {% if comment.isAnonymous %}
                      <small class="text-muted">Anonyme</small>
                    {% elseif comment.auteur %}
                      <small class="text-muted">{{ comment.auteur.email }}</small>
                    {% endif %}
                  </div>
                </div>
              </td>
              <td>
                <div class="comment-preview" style="max-height: 60px; overflow: hidden;">
                  {% if comment.contenu|length > 120 %}
                    {{ comment.contenu|slice(0, 120) }}...
                  {% else %}
                    {{ comment.contenu }}
                  {% endif %}
                </div>
              </td>
              <td>
                <a href="{{ path('admin_forum_publication_show', {id: comment.publication.id}) }}" 
                   class="text-decoration-none d-flex align-items-center gap-2">
                  <i class="bi bi-file-text text-primary"></i>
                  <span class="text-truncate" style="max-width: 200px;">
                    {{ comment.publication.titre }}
                  </span>
                </a>
              </td>
              <td class="text-center">
                <span class="badge bg-danger">
                  <i class="bi bi-heart me-1"></i>{{ comment.likeCount }}
                </span>
              </td>
              <td>
                <small class="text-muted">
                  {{ comment.createdAt|date('d/m/Y') }}<br>
                  {{ comment.createdAt|date('H:i') }}
                </small>
              </td>
              <td>
                <div class="dropdown">
                  <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <button type="button" class="dropdown-item" data-bs-toggle="modal" data-bs-target="#commentModal{{ comment.id }}">
                        <i class="bi bi-eye me-2"></i>Voir détails
                      </button>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger" onclick="confirmDelete({{ comment.id }})">
                        <i class="bi bi-trash me-2"></i>Supprimer
                      </button>
                    </li>
                  </ul>
                </div>
              </td>
            </tr>

            {# Comment Details Modal #}
            <div class="modal fade" id="commentModal{{ comment.id }}" tabindex="-1">
              <div class="modal-dialog modal-lg">
                <div class="modal-content">
                  <div class="modal-header border-0">
                    <h5 class="modal-title">Détails du commentaire</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
                    {# Author Info #}
                    <div class="mb-4">
                      <h6 class="text-muted small text-uppercase mb-2">Auteur</h6>
                      <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                          <i class="bi bi-person text-success fs-5"></i>
                        </div>
                        <div>
                          <div class="fw-semibold">{{ comment.nomAuteur }}</div>
                          {% if comment.auteur %}
                            <small class="text-muted">{{ comment.auteur.email }}</small>
                          {% endif %}
                          {% if comment.isAnonymous %}
                            <span class="badge bg-secondary ms-2">Anonyme</span>
                          {% endif %}
                        </div>
                      </div>
                    </div>

                    {# Publication Link #}
                    <div class="mb-4">
                      <h6 class="text-muted small text-uppercase mb-2">Publication associée</h6>
                      <a href="{{ path('admin_forum_publication_show', {id: comment.publication.id}) }}" 
                         class="text-decoration-none">
                        <div class="p-3 bg-light rounded d-flex align-items-center gap-2">
                          <i class="bi bi-file-text text-primary fs-5"></i>
                          <span class="fw-medium">{{ comment.publication.titre }}</span>
                        </div>
                      </a>
                    </div>

                    {# Comment Content #}
                    <div class="mb-4">
                      <h6 class="text-muted small text-uppercase mb-2">Contenu du commentaire</h6>
                      <div class="p-3 bg-light rounded">
                        {{ comment.contenu|nl2br }}
                      </div>
                    </div>

                    {# Stats #}
                    <div class="row">
                      <div class="col-md-4">
                        <div class="text-center p-3 bg-light rounded">
                          <i class="bi bi-heart text-danger fs-4 d-block mb-1"></i>
                          <div class="fw-bold">{{ comment.likeCount }}</div>
                          <small class="text-muted">Likes</small>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="text-center p-3 bg-light rounded">
                          <i class="bi bi-calendar3 text-info fs-4 d-block mb-1"></i>
                          <div class="fw-bold">{{ comment.createdAt|date('d/m/Y') }}</div>
                          <small class="text-muted">Date</small>
                        </div>
                      </div>
                      <div class="col-md-4">
                        <div class="text-center p-3 bg-light rounded">
                          <i class="bi bi-clock text-warning fs-4 d-block mb-1"></i>
                          <div class="fw-bold">{{ comment.createdAt|date('H:i') }}</div>
                          <small class="text-muted">Heure</small>
                        </div>
                      </div>
                    </div>
                  </div>
                  <div class="modal-footer border-0">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                    <form method="post" action="{{ path('admin_forum_comment_delete', {id: comment.id}) }}" class="d-inline">
                      <input type="hidden" name="_token" value="{{ csrf_token('delete_comment_' ~ comment.id) }}">
                      <button type="submit" class="btn btn-danger" 
                              onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce commentaire ?');">
                        <i class="bi bi-trash me-1"></i>Supprimer
                      </button>
                    </form>
                  </div>
                </div>
              </div>
            </div>
            {% else %}
            <tr>
              <td colspan="6" class="text-center text-muted py-5">
                <i class="bi bi-chat-left-text display-4 d-block mb-2"></i>
                <p class="mb-0">Aucun commentaire trouvé</p>
                {% if search or publicationId != 'all' or dateFrom or dateTo %}
                  <a href="{{ path('admin_forum_comments') }}" class="btn btn-sm btn-outline-primary mt-2">
                    <i class="bi bi-x-circle me-1"></i>Réinitialiser les filtres
                  </a>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

{# Delete Confirmation Modal #}
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title">Confirmer la suppression</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-center mb-3">
          <i class="bi bi-exclamation-triangle text-warning display-4"></i>
        </div>
        <p class="text-center">Êtes-vous sûr de vouloir supprimer ce commentaire ?</p>
        <div class="alert alert-danger mb-0">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Attention :</strong> Cette action est irréversible.
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" id="deleteForm">
          <input type="hidden" name="_token" id="deleteToken">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Supprimer définitivement
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function confirmDelete(id) {
  document.getElementById('deleteForm').action = '{{ path('admin_forum_comment_delete', {id: '__ID__'})|e('js') }}'.replace('__ID__', id);
  document.getElementById('deleteToken').value = '{{ csrf_token('delete_comment___ID__')|e('js') }}'.replace('___ID__', id);
  
  const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
  modal.show();
}
</script>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .table th {
      font-weight: 600;
      font-size: 0.875rem;
      color: #6b7280;
      background-color: #f9fafb;
    }
    .table td { vertical-align: middle; }
    .comment-preview {
      font-size: 0.9rem;
      line-height: 1.5;
      color: #4b5563;
    }
    .dropdown-menu { min-width: 160px; }
  </style>
{% endblock %}
