{% extends 'back/base.html.twig' %}

{% block title %}Gestion des publications - Forum{% endblock %}
{% block page_title %}Gestion des publications{% endblock %}
{% block page_subtitle %}Gérer et modérer les publications du forum{% endblock %}

{% block body %}
<div class="publications-management">
  {# Header #}
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h4 mb-1">Publications du forum</h2>
      <p class="text-muted small mb-0">{{ totalPublications }} publication(s) trouvée(s)</p>
    </div>
    <a href="{{ path('admin_forum_dashboard') }}" class="btn btn-outline-secondary">
      <i class="bi bi-arrow-left me-1"></i> Retour au dashboard
    </a>
  </div>

  {# Summary Stats Cards #}
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-muted small mb-1">Publications</p>
              <h4 class="mb-0 fw-bold">{{ totalPublications }}</h4>
            </div>
            <div class="bg-primary bg-opacity-10 rounded-3 p-3">
              <i class="bi bi-file-text text-primary fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-muted small mb-1">Total vues</p>
              <h4 class="mb-0 fw-bold">{{ totalViews|number_format(0, '', ' ') }}</h4>
            </div>
            <div class="bg-info bg-opacity-10 rounded-3 p-3">
              <i class="bi bi-eye text-info fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-muted small mb-1">Total likes</p>
              <h4 class="mb-0 fw-bold">{{ totalLikes|number_format(0, '', ' ') }}</h4>
            </div>
            <div class="bg-danger bg-opacity-10 rounded-3 p-3">
              <i class="bi bi-heart text-danger fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="col-sm-6 col-lg-3">
      <div class="card border-0 shadow-sm">
        <div class="card-body">
          <div class="d-flex align-items-center justify-content-between">
            <div>
              <p class="text-muted small mb-1">Commentaires</p>
              <h4 class="mb-0 fw-bold">{{ totalComments|number_format(0, '', ' ') }}</h4>
            </div>
            <div class="bg-success bg-opacity-10 rounded-3 p-3">
              <i class="bi bi-chat text-success fs-4"></i>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  {# Filters #}
  <div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
      <form method="get" action="{{ path('admin_forum_publications') }}" class="row g-3">
        <div class="col-md-3">
          <label for="status" class="form-label small fw-semibold">Statut</label>
          <select name="status" id="status" class="form-select">
            <option value="all" {{ status == 'all' ? 'selected' : '' }}>Tous les statuts</option>
            <option value="pending" {{ status == 'pending' ? 'selected' : '' }}>⏳ En attente (Pending)</option>
            <option value="published" {{ status == 'published' ? 'selected' : '' }}>✅ Publiées (Published)</option>
            <option value="hidden" {{ status == 'hidden' ? 'selected' : '' }}>🚫 Masquées (Hidden)</option>
          </select>
        </div>
        <div class="col-md-2">
          <label for="category" class="form-label small fw-semibold">Catégorie</label>
          <select name="category" id="category" class="form-select">
            <option value="all" {{ category == 'all' ? 'selected' : '' }}>Toutes</option>
            {% for cat in categories %}
              <option value="{{ cat }}" {{ category == cat ? 'selected' : '' }}>
                {{ cat|capitalize|replace({'_': ' '}) }}
              </option>
            {% endfor %}
          </select>
        </div>
        <div class="col-md-2">
          <label for="date_from" class="form-label small fw-semibold">Date début</label>
          <input type="date" name="date_from" id="date_from" class="form-control" value="{{ dateFrom }}">
        </div>
        <div class="col-md-2">
          <label for="date_to" class="form-label small fw-semibold">Date fin</label>
          <input type="date" name="date_to" id="date_to" class="form-control" value="{{ dateTo }}">
        </div>
        <div class="col-md-3">
          <label for="search" class="form-label small fw-semibold">Recherche</label>
          <div class="input-group">
            <input type="text" name="q" id="search" class="form-control" placeholder="Titre, contenu, auteur..." value="{{ search }}">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-search"></i>
            </button>
          </div>
        </div>
      </form>
    </div>
  </div>

  {# Publications Table #}
  <div class="card border-0 shadow-sm">
    <div class="card-body">
      <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="card-title mb-0">Liste des publications</h5>
        <div class="btn-group" role="group">
          <a href="{{ path('admin_forum_publications', {sort: 'createdAt', dir: dir == 'ASC' ? 'DESC' : 'ASC', status: status, category: category, q: search, date_from: dateFrom, date_to: dateTo}) }}" 
             class="btn btn-sm btn-outline-secondary {{ sort == 'createdAt' ? 'active' : '' }}">
            <i class="bi bi-calendar3"></i> Date
            {% if sort == 'createdAt' %}
              <i class="bi bi-arrow-{{ dir == 'ASC' ? 'up' : 'down' }}"></i>
            {% endif %}
          </a>
          <a href="{{ path('admin_forum_publications', {sort: 'nbVues', dir: dir == 'ASC' ? 'DESC' : 'ASC', status: status, category: category, q: search, date_from: dateFrom, date_to: dateTo}) }}" 
             class="btn btn-sm btn-outline-secondary {{ sort == 'nbVues' ? 'active' : '' }}">
            <i class="bi bi-eye"></i> Vues
          </a>
          <a href="{{ path('admin_forum_publications', {sort: 'nbLikes', dir: dir == 'ASC' ? 'DESC' : 'ASC', status: status, category: category, q: search, date_from: dateFrom, date_to: dateTo}) }}" 
             class="btn btn-sm btn-outline-secondary {{ sort == 'nbLikes' ? 'active' : '' }}">
            <i class="bi bi-heart"></i> Likes
          </a>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th style="width: 35%;">Titre</th>
              <th style="width: 15%;">Auteur</th>
              <th style="width: 10%;">Catégorie</th>
              <th class="text-center" style="width: 15%;">Statistiques</th>
              <th style="width: 10%;">Date</th>
              <th style="width: 10%;">Statut</th>
              <th class="text-end" style="width: 5%;">Actions</th>
            </tr>
          </thead>
          <tbody>
            {% for publication in publications %}
            <tr>
              <td>
                <a href="{{ path('admin_forum_publication_show', {id: publication.id}) }}" class="text-decoration-none fw-semibold text-dark">
                  {{ publication.titre }}
                </a>
                {% if publication.imageUrl %}
                  <i class="bi bi-image text-muted ms-1" title="Contient une image"></i>
                {% endif %}
              </td>
              <td>
                {% if publication.auteur %}
                  <div class="d-flex align-items-center gap-2">
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                      <i class="bi bi-person text-primary small"></i>
                    </div>
                    <div class="small">
                      <div class="fw-medium">{{ publication.auteur.fullName }}</div>
                    </div>
                  </div>
                {% else %}
                  <span class="text-muted small">Anonyme</span>
                {% endif %}
              </td>
              <td>
                {% if publication.categorie %}
                  <span class="badge bg-secondary">{{ publication.categorie|replace({'_': ' '})|capitalize }}</span>
                {% else %}
                  <span class="text-muted small">—</span>
                {% endif %}
              </td>
              <td>
                <div class="d-flex gap-3 justify-content-center small">
                  <span title="Vues" class="text-info">
                    <i class="bi bi-eye"></i> {{ publication.nbVues }}
                  </span>
                  <span title="Likes" class="text-danger">
                    <i class="bi bi-heart"></i> {{ publication.nbLikes }}
                  </span>
                  <span title="Commentaires" class="text-success">
                    <i class="bi bi-chat"></i> {{ publication.commentaires|length }}
                  </span>
                </div>
              </td>
              <td>
                <small class="text-muted">
                  {{ publication.createdAt|date('d/m/Y') }}<br>
                  {{ publication.createdAt|date('H:i') }}
                </small>
              </td>
              <td>
                {% if publication.statut == 'publie' %}
                  <span class="badge bg-success">
                    <i class="bi bi-check-circle me-1"></i>Publiée
                  </span>
                {% else %}
                  <span class="badge bg-warning text-dark">
                    <i class="bi bi-eye-slash me-1"></i>Masquée
                  </span>
                {% endif %}
              </td>
              <td>
                <div class="dropdown">
                  <button class="btn btn-sm btn-light border" type="button" data-bs-toggle="dropdown">
                    <i class="bi bi-three-dots-vertical"></i>
                  </button>
                  <ul class="dropdown-menu dropdown-menu-end">
                    <li>
                      <a class="dropdown-item" href="{{ path('admin_forum_publication_show', {id: publication.id}) }}">
                        <i class="bi bi-eye me-2"></i>Voir détails
                      </a>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <form method="post" action="{{ path('admin_forum_publication_toggle', {id: publication.id}) }}" class="d-inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_publication_' ~ publication.id) }}">
                        <button type="submit" class="dropdown-item">
                          <i class="bi bi-eye{{ publication.statut == 'publie' ? '-slash' : '' }} me-2"></i>
                          {{ publication.statut == 'publie' ? 'Masquer' : 'Publier' }}
                        </button>
                      </form>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                      <button type="button" class="dropdown-item text-danger" 
                              onclick="confirmDelete({{ publication.id }}, '{{ publication.titre|e('js') }}')">
                        <i class="bi bi-trash me-2"></i>Supprimer
                      </button>
                    </li>
                  </ul>
                </div>
              </td>
            </tr>
            {% else %}
            <tr>
              <td colspan="7" class="text-center text-muted py-5">
                <i class="bi bi-inbox display-4 d-block mb-2"></i>
                <p class="mb-0">Aucune publication trouvée</p>
                {% if search or status != 'all' or category != 'all' or dateFrom or dateTo %}
                  <a href="{{ path('admin_forum_publications') }}" class="btn btn-sm btn-outline-primary mt-2">
                    <i class="bi bi-x-circle me-1"></i>Réinitialiser les filtres
                  </a>
                {% endif %}
              </td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>

{# Delete confirmation modal #}
<div class="modal fade" id="deleteModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header border-0">
        <h5 class="modal-title">Confirmer la suppression</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <div class="text-center mb-3">
          <i class="bi bi-exclamation-triangle text-warning display-4"></i>
        </div>
        <p class="text-center">Êtes-vous sûr de vouloir supprimer la publication :</p>
        <p class="text-center fw-bold" id="deletePublicationTitle"></p>
        <div class="alert alert-danger mb-0">
          <i class="bi bi-exclamation-triangle me-2"></i>
          <strong>Attention :</strong> Cette action est irréversible. Tous les commentaires associés seront également supprimés.
        </div>
      </div>
      <div class="modal-footer border-0">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
        <form method="post" id="deleteForm">
          <input type="hidden" name="_token" id="deleteToken">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash me-1"></i>Supprimer définitivement
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function confirmDelete(id, title) {
  document.getElementById('deletePublicationTitle').textContent = title;
  document.getElementById('deleteForm').action = '{{ path('admin_forum_publication_delete', {id: '__ID__'})|e('js') }}'.replace('__ID__', id);
  document.getElementById('deleteToken').value = '{{ csrf_token('delete_publication___ID__')|e('js') }}'.replace('___ID__', id);
  
  const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
  modal.show();
}
</script>
{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .table th {
      font-weight: 600;
      font-size: 0.875rem;
      color: #6b7280;
      background-color: #f9fafb;
    }
    .table td { vertical-align: middle; }
    .dropdown-menu { min-width: 180px; }
  </style>
{% endblock %}
