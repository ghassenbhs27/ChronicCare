{% extends 'coach/base.html.twig' %}

{% block page_title %}Mes événements{% endblock %}

{% block stylesheets %}
  {{ parent() }}
  <style>
    .coach-accent-btn {
      background: var(--accent-color);
      border-color: var(--accent-color);
      color: #fff;
    }

    .coach-accent-btn:hover,
    .coach-accent-btn:focus {
      background: color-mix(in srgb, var(--accent-color), transparent 15%);
      border-color: color-mix(in srgb, var(--accent-color), transparent 15%);
      color: #fff;
    }

    .coach-accent-badge {
      background: color-mix(in srgb, var(--accent-color), transparent 88%);
      color: var(--accent-color);
      border: 1px solid color-mix(in srgb, var(--accent-color), transparent 70%);
    }
  </style>
{% endblock %}

{% block content %}
<nav aria-label="Fil d'Ariane" class="coach-breadcrumb">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
    <li class="breadcrumb-item active" aria-current="page">Espace Coach · Événements</li>
  </ol>
</nav>

<header class="coach-page-header d-flex flex-wrap justify-content-between align-items-start gap-3">
  <div>
    <h1 class="coach-page-title"><i class="bi bi-calendar2-event me-2"></i>Mes événements</h1>
    <p class="coach-page-sub">Créez et gérez vos événements, suivez les inscriptions et les exercices associés.</p>
  </div>
  <div class="d-flex gap-2">
    <a class="btn coach-accent-btn d-flex align-items-center gap-2" href="{{ path('app_statistics') }}">
      <i class="bi bi-graph-up-arrow"></i> Statistiques
    </a>
    <a class="btn coach-accent-btn d-flex align-items-center gap-2" href="{{ path('evenement_new') }}">
      <i class="bi bi-plus-lg"></i> Créer un événement
    </a>
  </div>
</header>

{% for label, messages in app.flashes %}
  {% for message in messages %}
    <div class="alert alert-{{ label }} alert-dismissible fade show coach-alert mb-4" role="alert">
      {{ message }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
  {% endfor %}
{% endfor %}

<div class="coach-filter-bar">
  <form method="get" class="row g-3 align-items-end">
    <div class="col-12 col-md-5">
      <label class="form-label small fw-bold text-uppercase text-muted" for="q">Recherche</label>
      <input class="form-control" id="q" name="q" type="text" placeholder="Titre ou lieu…" value="{{ q }}">
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small fw-bold text-uppercase text-muted" for="sort">Trier par</label>
      <select class="form-select" id="sort" name="sort">
        <option value="dateDebut" {% if sort == 'dateDebut' %}selected{% endif %}>Date début</option>
        <option value="dateFin" {% if sort == 'dateFin' %}selected{% endif %}>Date fin</option>
        <option value="titre" {% if sort == 'titre' %}selected{% endif %}>Titre</option>
      </select>
    </div>
    <div class="col-6 col-md-2">
      <label class="form-label small fw-bold text-uppercase text-muted" for="order">Ordre</label>
      <select class="form-select" id="order" name="order">
        <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Décroissant</option>
        <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Croissant</option>
      </select>
    </div>
    <div class="col-12 col-md-3 d-flex gap-2">
      <button class="btn coach-accent-btn flex-grow-1" type="submit"><i class="bi bi-search me-2"></i>Filtrer</button>
      <a class="btn btn-outline-secondary" href="{{ path('evenement_index') }}">Réinitialiser</a>
    </div>
  </form>
</div>

<p class="text-muted small mb-3"><strong>{{ total }}</strong> événement{{ total > 1 ? 's' : '' }}</p>

{% if evenements is empty %}
  <div class="coach-empty">
    <i class="bi bi-calendar-x coach-empty-icon"></i>
    <h2 class="coach-empty-title">Aucun événement</h2>
    <p class="coach-empty-text mb-4">Créez votre premier événement pour commencer à gérer vos activités.</p>
    <a class="btn btn-primary" href="{{ path('evenement_new') }}"><i class="bi bi-plus-lg me-2"></i>Créer un événement</a>
  </div>
{% else %}
  <div class="row g-4">
    {% for evenement in evenements %}
      <div class="col-md-6 col-lg-4">
        <div class="card coach-event-card h-100">
          <div class="card-body">
            <h3 class="coach-event-title">{{ evenement.titre }}</h3>
            <div class="coach-event-meta">
              <span><i class="bi bi-calendar3 me-1"></i> {{ evenement.dateDebut ? evenement.dateDebut|date('d/m/Y H:i') : '—' }}</span>
              <span class="ms-2"><i class="bi bi-geo-alt me-1"></i> {{ evenement.lieu|length > 25 ? evenement.lieu|slice(0, 25) ~ '…' : evenement.lieu }}</span>
            </div>
            <div class="coach-event-badges">
              <span class="badge coach-accent-badge">{{ inscription_counts[evenement.id] ?? 0 }} inscription(s)</span>
              {% if holiday_map[evenement.id] is defined %}
                <span class="badge bg-warning text-dark">J. férié</span>
              {% endif %}
            </div>
            <div class="coach-event-actions">
              <a class="btn btn-sm coach-accent-btn" href="{{ path('evenement_show', { id: evenement.id }) }}">Voir</a>
              <a class="btn btn-sm coach-accent-btn" href="{{ path('evenement_edit', { id: evenement.id }) }}">Modifier</a>
              <form class="d-inline" method="post" action="{{ path('evenement_delete', { id: evenement.id }) }}" onsubmit="return confirm('Supprimer cet événement ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete_evenement_' ~ evenement.id) }}">
                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
              </form>
            </div>
          </div>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if pages > 1 %}
    {% set params = { q: q, sort: sort, order: order } %}
    <nav class="mt-4 coach-pagination" aria-label="Pagination événements">
      <ul class="pagination justify-content-center mb-0">
        <li class="page-item {{ page <= 1 ? 'disabled' : '' }}">
          <a class="page-link" href="{{ path('evenement_index', params|merge({ page: page - 1 })) }}">&laquo;</a>
        </li>
        {% for p in 1..pages %}
          <li class="page-item {{ p == page ? 'active' : '' }}"><a class="page-link" href="{{ path('evenement_index', params|merge({ page: p })) }}">{{ p }}</a></li>
        {% endfor %}
        <li class="page-item {{ page >= pages ? 'disabled' : '' }}">
          <a class="page-link" href="{{ path('evenement_index', params|merge({ page: page + 1 })) }}">&raquo;</a>
        </li>
      </ul>
    </nav>
  {% endif %}
{% endif %}
{% endblock %}
