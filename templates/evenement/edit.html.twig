{% extends 'coach/base.html.twig' %}

{% block page_title %}Modifier l'événement{% endblock %}

{% block content %}
<nav aria-label="Fil d'Ariane" class="coach-breadcrumb">
  <ol class="breadcrumb mb-0">
    <li class="breadcrumb-item"><a href="{{ path('index') }}">Accueil</a></li>
    <li class="breadcrumb-item"><a href="{{ path('evenement_index') }}">Mes événements</a></li>
    <li class="breadcrumb-item"><a href="{{ path('evenement_show', { id: evenement.id }) }}">{{ evenement.titre|length > 35 ? evenement.titre|slice(0, 35) ~ '…' : evenement.titre }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
  </ol>
</nav>

<header class="coach-page-header mb-4">
  <h1 class="coach-page-title"><i class="bi bi-pencil-square me-2"></i>Modifier l'événement</h1>
  <p class="coach-page-sub">{{ evenement.titre }}</p>
</header>

<div class="coach-card coach-form-card">
  <div class="card-body">
    {{ form_start(form) }}
      {{ form_row(form.titre, { label: 'Titre', attr: { class: 'form-control' } }) }}
      {{ form_row(form.description, { label: 'Description', attr: { class: 'form-control', rows: 4 } }) }}
      <div class="row">
        <div class="col-md-6">{{ form_row(form.dateDebut, { label: 'Date et heure de début' }) }}</div>
        <div class="col-md-6">{{ form_row(form.dateFin, { label: 'Date et heure de fin' }) }}</div>
      </div>
      {{ form_row(form.lieu, { label: 'Lieu', attr: { class: 'form-control' } }) }}
      <div class="coach-form-actions">
        <button class="btn btn-primary" type="submit"><i class="bi bi-check-lg me-1"></i> Enregistrer</button>
        <a class="btn btn-outline-secondary" href="{{ path('evenement_index') }}">Annuler</a>
      </div>
    {{ form_end(form) }}
  </div>
</div>
{% endblock %}
