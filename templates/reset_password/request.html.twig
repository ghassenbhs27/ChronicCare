{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublie{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="header-spacer"></div>
<main class="main">
  <section class="auth-section section light-background">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
          <div class="auth-card">
            <div class="auth-header text-center mb-4">
              <div class="auth-icon"><i class="bi bi-envelope"></i></div>
              <h2>Mot de passe oublie</h2>
              <p>Entrez votre email pour recevoir un code de reinitialisation.</p>
            </div>

            {% for message in app.flashes('reset_password_error') %}
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            {% endfor %}

            {{ form_start(requestForm, { attr: { class: 'auth-form', novalidate: 'novalidate' } }) }}
              <div class="row gy-3">
                <div class="col-12">{{ form_row(requestForm.email, { attr: { class: 'form-control', placeholder: 'nom@exemple.com' } }) }}</div>
                <div class="col-12">
                  <button type="submit" class="btn-getstarted w-100"><i class="bi bi-send me-2"></i>Envoyer le code</button>
                </div>
                <div class="col-12 text-center">
                  <span class="text-muted">Vous avez deja un code ?</span>
                  <a href="{{ path('app_reset_password_verify') }}" class="auth-link">Saisir le code (si recu)</a>
                </div>
              </div>
            {{ form_end(requestForm) }}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
