{% extends 'base.html.twig' %}

{% block title %}Verifier le code{% endblock %}
{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="header-spacer"></div>
<main class="main">
  <section class="auth-section section light-background">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
          <div class="auth-card">
            <div class="auth-header text-center mb-4">
              <div class="auth-icon"><i class="bi bi-shield-lock"></i></div>
              <h2>Verifier le code</h2>
              <p>Entrez votre email et le code recu par email pour continuer.</p>
            </div>

            {% for message in app.flashes('reset_password_error') %}
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            {% endfor %}

            {{ form_start(verifyForm, { attr: { class: 'auth-form', novalidate: 'novalidate' } }) }}
              <div class="row gy-3">
                <div class="col-12">{{ form_row(verifyForm.email, { attr: { class: 'form-control', placeholder: 'nom@exemple.com' } }) }}</div>
                <div class="col-12">{{ form_row(verifyForm.code, { attr: { class: 'form-control', placeholder: 'Code a 6 chiffres' } }) }}</div>
                <div class="col-12"><button type="submit" class="btn-getstarted w-100"><i class="bi bi-check-circle me-2"></i>Verifier</button></div>
                <div class="col-12 text-center"><a href="{{ path('app_forgot_password_request') }}" class="auth-link">Renvoyer un code</a></div>
              </div>
            {{ form_end(verifyForm) }}
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
