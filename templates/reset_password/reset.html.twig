{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="header-spacer"></div>

<main class="main">
  <section class="auth-section section light-background">
    <div class="container">
      <div class="row justify-content-center">
        <div class="col-lg-5 col-md-8">
          <div class="auth-card">
            <div class="auth-header text-center mb-4">
              <div class="auth-icon">
                <i class="bi bi-key"></i>
              </div>
              <h2>Nouveau mot de passe</h2>
              <p>Choisissez un mot de passe sÃ©curisÃ©.</p>
            </div>

            {% for message in app.flashes('reset_password_error') %}
              <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
              </div>
            {% endfor %}

            {{ form_start(resetForm, { attr: { class: 'auth-form', novalidate: 'novalidate' } }) }}
              <div class="row gy-3">
                <div class="col-12">
                  {{ form_row(resetForm.plainPassword, { attr: { class: 'form-control', placeholder: 'Votre nouveau mot de passe' } }) }}
                </div>
                <div class="col-12">
                  <button type="submit" class="btn-getstarted w-100">
                    <i class="bi bi-check2-circle me-2"></i>
                    RÃ©initialiser le mot de passe
                  </button>
                </div>
              </div>
            {{ form_end(resetForm) }}

            <div class="auth-divider"><span>Chronic Care</span></div>

            <div class="auth-trust">
              <div><i class="bi bi-shield-check"></i> DonnÃ©es sÃ©curisÃ©es</div>
              <div><i class="bi bi-lock"></i> Mot de passe protÃ©gÃ©</div>
              <div><i class="bi bi-headset"></i> Support rÃ©actif</div>
              <div><i class="bi bi-check-circle"></i> Processus simple</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>
{% endblock %}
